<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!--<add key="printhashcode" value="***MASKED***"/>-->
    <add key="printhashcode" value="***MASKED***"/>
   
    
  </appSettings>
  <system.serviceModel>
    <behaviors>
      <serviceBehaviors>
        <behavior name="mexBehaviour">
          <serviceMetadata httpGetEnabled="true"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <services>
      <service name="TreasuryPrintService.PrintService" behaviorConfiguration="mexBehaviour">
        <endpoint address="" binding="basicHttpBinding" contract="TreasuryPrintService.IPrintService">
          <identity>
            <dns value="*"/>
          </identity>
        </endpoint>
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>
        <host>
          <baseAddresses>
            <add baseAddress="http://*:8733/Design_Time_Addresses/TreasuryPrintService/PrintService/"/>
          </baseAddresses>
        </host>
      </service>
    </services>
  </system.serviceModel>
<startup><supportedRuntime version="v2.0.50727"/></startup></configuration>
