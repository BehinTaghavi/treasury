    </script>
    <script>
        $(function () {
            var setTimeOut = setTimeout(function () {
                //$("html, body").css("height", "100%")
                $(".startpage.spinner").fadeOut();
                $("#wrapper").fadeIn('slow');
            }, 1000);
        })
        function successMessage(data) {
            if (data.result) {
                alertify.success(data.message);
            }
            else {
                alertify.error(data.message);
            }
        }
        function deleteRow(RowId) {
            $("#" + RowId).addClass("danger").fadeOut('slow');
        }
        function updateRow(url, RowId) {
            $.ajax({
                url: url,
                success: function (result) {
                    $("#" + RowId).html(result);
                }
            })
            $("#" + RowId).addClass("success");
        }

    </script>
    <script>
        function modal(data, title, size) {
            $(".modal." + size).find(".modal-title").html("").html(title);
            $(".modal." + size).find(".modal-body").html("").html(data);
            $(".modal." + size).modal('show');
        }
        function closeModal(size) {
            $(".modal." + size).modal("hide");
        }
        function guid() {
            var d = new Date().getTime();
            var guid = 'xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'.replace(/[x]/g, function (c) {
                var r = (d + Math.random() * 16) % 16 | 0;
                d = Math.floor(d / 16);
                return (c == 'x' ? r : (r & 0x3 | 0x8)).toString(16);
            });
            return guid;
        };
    </script>
    <script>
        (function ($) {
            $.fn.showHide = function (options) {

                //default vars for the plugin
                var defaults = {
                    speed: 200,
                    easing: '',
                    changeText: 0,
                    showText: 'Show',
                    hideText: 'Hide'

                };
                var options = $.extend(defaults, options);

                $(this).click(function () {
                    $('.toggleDiv').slideUp(options.speed, options.easing);
                    // this var stores which button you've clicked
                    var toggleClick = $(this);
                    // this reads the rel attribute of the button to determine which div id to toggle
                    var toggleDiv = $(this).attr('rel');

                    // here we toggle show/hide the correct div at the right speed and using which easing effect
                    $(toggleDiv).slideToggle(options.speed, options.easing, function () {
                        // this only fires once the animation is completed
                        if (options.changeText == 1) {
                            $(toggleDiv).is(":visible") ? toggleClick.html(options.hideText) : toggleClick.html(options.showText);
                        }
                    });

                    return false;

                });

            };
        })(jQuery);


    </script>
    @RenderSection("scripts", required: false)
