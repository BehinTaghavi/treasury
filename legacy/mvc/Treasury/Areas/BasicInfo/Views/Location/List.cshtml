@model IEnumerable<CSD.Treasury.Service.LocationsService.Location>

<table class="table table-striped sortable">
    <thead>
        <tr class="mdc-bg-grey-200">
            <th>
                @Resources.Location
            </th>
            @*<th>@Resources.Location-@Resources.EN</th>*@
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
          
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.LocationName)
                </td>
                @*<td>
                    @Html.DisplayFor(modelItem => item.LocationName2)
                </td>*@
                
                <td>
                  
                        @Ajax.ActionLink(Resources.Edit, "Edit", "Location", new { Area = "BasicInfo", id = item.LocationID }, new AjaxOptions
                      {
                          OnSuccess = "modal(data,'" + Resources.Edit + " " + Resources.Location + "', 'md');"
                      }, new { @class = "btn btn-success btn-xs" })


                        @Html.ActionLink(Resources.Delete, "DeleteLocation", "Location", new { Area = "BasicInfo", LocationID = item.LocationID }, new { @class = "btn btn-danger btn-xs delete" })
                    
                 
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
    var deleteBtn = document.getElementsByClassName("delete");
    
    for (var i = 0; i < deleteBtn.length; i++) {
        deleteBtn[i].addEventListener("click", deleteItem);
    }
    function deleteItem(e) {
        e.preventDefault();
        var item = this;
        alertify.confirm("", '@Resources.AreYouSure',
                   function () {
                       var xmlhttp = new XMLHttpRequest();
                       xmlhttp.onreadystatechange = function () {
                           if (xmlhttp.readyState == 4 && xmlhttp.status == 200) {
                               var data = JSON.parse(xmlhttp.responseText);
                               if (data.result == true) {
                                   item.deleteParentByTagName("tr", "danger", 1500, function () {
                                       alertify.success(data.Message);
                                   })
                               }
                               else {
                                   alertify.error(data.Message);
                               }
                           }
                       };
                       xmlhttp.open("POST", item.href, true);
                       xmlhttp.send();
                   },
  function () {
  }).set('labels', { ok: 'بله', cancel: 'خیر' }).set({ transition: 'zoom' }).set('modal', false);
    }

</script>