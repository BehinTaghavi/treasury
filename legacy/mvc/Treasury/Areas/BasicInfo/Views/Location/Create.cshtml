@model CSD.Treasury.Service.LocationsService.Location
@using System.Configuration

    @{
        ViewBag.Title = "Create";
    }
        @using (Ajax.BeginForm("Create", "Location", new AjaxOptions
        {
            HttpMethod = "Post",
            OnSuccess = "successMessage(data);$('#LocationName').val('');"
        }, new { enctype = "multipart/form-data", @class = "form-horizontal", id = "LocationCreate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.cmpBranchID)
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                @*<div class="clearfix">
                        <div class="col-sm-3">
                            <div class="form-group">
                                <div class="col-xs-12">
                                    @Html.DropDownList("UniqueAccountType", new SelectList(ViewBag.unique_account_type, "Code", "Description"), Resources.PleaseSelect, new { data_lang_number="fa", @class = "form-control floating-label", @placeholder = Resources.Type, data_bind = "CostCenter_UniqueAccountNo" })
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-9">
                            <div class="form-group">
                                @Html.Hidden("CostCenter_UniqueAccountNo")
                                <div class="dropdown keep-open lookup">
                                    <div class="clearfix">
                                        <div class="col-xs-4">
                                            <input type="text" lookup data-action="UniqueAccount" autocomplete="off" data-related="Name" placeholder="@Resources.Unique_Account_Code" name="Code" id="Code" data-toggle="dropdown" class="form-control dropdown-toggle floating-label" aria-expanded="true">
                                        </div>
                                        <div class="col-xs-8">
                                            <input type="text" lookup data-action="UniqueAccount" autocomplete="off" data-related="Code" placeholder="@Resources.Unique_Account_No" name="Name" id="Name" data-toggle="dropdown" class="form-control dropdown-toggle floating-label" aria-expanded="true">
                                        </div>
                                    </div>
                                    <ul class="dropdown-menu" style="width: 100%">
                                        <li id="UniqueAccountList">
                                            @Html.Action("UniqueAccount", "Request", new { Area = "Payment" })
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <label class="control-label col-sm-2" for="UniqueAccountType">@Resources.UniqueAccountType 1</label>
                        <div class="col-sm-3">
                            @Html.DropDownList("UniqueAccountType", new SelectList(ViewBag.unique_account_type, "Code", "Description"), string.Empty, new { data_lang_number = "fa", @class = "form-control UniqueAccountType", placeholder = Resources.Type, data_bind = "Unique_Account_No", data_code_att = "Code", data_name_att = "Name", updatetargetid = "acc1" })
                        </div>
                        <label class="control-label col-sm-2" for="Unique_Account_No">@Resources.Unique_Account_Code </label>
                        <div class="col-md-5">
                            @Html.DropDownListFor(model => model.ع, Enumerable.Empty<SelectListItem>(), new { required = "required", data_lang_number = "fa", @class = "form-control", placeholder = Resources.Unique_Account_Code + "/" + Resources.Unique_Account_No })
                            @Html.ValidationMessageFor(model => model.Unique_Account_No)

                        </div>
                    </div>*@
                @*<a id="newCostCenter" href="#" class="btn btn-material-grey-600 btn-sm">افزودن مرکز هزینه  </a>
                    <div id="CostCenterLS"></div>*@


                <div class="form-group">
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.LocationName, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.Location } })
                        @Html.ValidationMessageFor(model => model.LocationName, "", new { @class = "text-danger" })
                    </div>
                </div>
                @if (ConfigurationManager.AppSettings["bilingual"] == "True")
                {
                    <div class="form-group">
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.LocationName2, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = @Resources.Location + "-" + @Resources.EN } })
                            @Html.ValidationMessageFor(model => model.LocationName2, "", new { @class = "text-danger" })
                        </div>
                    </div>
                }
                <div class="form-group">
                    <div class="col-md-10">
                        <select data-lang-number="fa" name="LocationByCostCenters_St" id="LocationByCostCenters_St" class="form-control floating-label" placeholder="مراکز هزینه" multiple="multiple">
                            @foreach (var item in (IEnumerable<CSD.Treasury.DataModel.v_unique_accounts>)ViewBag.unique_account)
                            {
                                <option value="@item.Account_Code">@item.Account_Code &nbsp;&nbsp;&nbsp; @item.Account_Name</option>
                            }
                        </select>
                        @*@Html.DropDownListFor(model => model.LocationByCostCenters_St, new SelectList(ViewBag.Reference, "referenceTypeID", "referenceTypeDescription"), new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.Reference, multiple = "multiple" })
                            @Html.ValidationMessageFor(model => model.Reference, "", new { @class = "text-danger" })*@
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-sm-12">
                        <div class="text-right">
                            <button type="submit" class="btn btn-primary btn-sm">@Resources.Save</button>
                            <a class="btn btn-white btn-sm" data-ajax="true" data-ajax-success="modal(data,'@Resources.Location', 'md')" href="/BasicInfo/Location/Index?BranchId=@Model.cmpBranchID"><i class="zmdi zmdi-chevron-left zmdi-hc-lg"></i></a>
                        </div>
                    </div>
                </div>
            </div>

        }

        @Scripts.Render("~/bundles/jqueryval")
        <script>

            $(function () {
                $("#LocationByCostCenters_St").select2({
                    tags: true,
                    dir: "rtl",
                    containerCssClass: "form-control",
                    createSearchChoice: function (term) {
                        return false;
                    },
                    templateSelection: formatRepoSelection,
                });
                function formatRepoSelection(repo) {
                    return repo.full_name || repo.text;
                }
                $.material.init();
            });

            $("body").on("click", "#newCostCenter", function () {

                if ($('#CostCenter_UniqueAccountNo').val() != "") {
                    $("#CostCenterLS").append("<p><a onclick='$(this).parent().remove()' href='#' class='btn btn-lg btn-link'><i class='zmdi zmdi-close'></i></a>" + $('#CostCenter_UniqueAccountNo').val() + $('#Name').val() + "<input  id='Unique_Account_No' type='hidden' name='Unique_Account_No' value=" + $('#CostCenter_UniqueAccountNo').val() + "/></p>");
                }
                else {
                    alert("لطفا مرکز هزینه را انتخاب نمایبد");
                }
            })
            $("body").on("change", "#UniqueAccountType", function () {
                var address = "@(Url.Action("UniqueAccount", "Request", new { Area= "Payment" }))";
                if ($(this).val() != 0) {
                    $("#UniqueAccountList").load(address, { UniqueAccountTypeId: $(this).val(), Bind: $(this).attr("data-bind") });
                }
                else {
                    $("#UniqueAccountList").load(address, { UniqueAccountTypeId: 0, Bind: $(this).attr("data-bind") });
                }
            });
            var formData = new FormData(document.getElementsByTagName("form")[0]);
            var lookup = document.querySelectorAll("[lookup]");
            for (var i = 0; i < lookup.length; i++) {
                lookup[i].onkeyup = function () {
                    var xmlhttp = new XMLHttpRequest();
                    xmlhttp.onreadystatechange = function () {
                        if (xmlhttp.readyState == 4 && xmlhttp.status == 200) {
                            document.getElementById("UniqueAccountList").innerHTML = xmlhttp.responseText;
                        }
                    }
                    var type = document.getElementById("UniqueAccountType");
                    var address = "/Payment/Request/" + this.getAttribute("data-action") + "?UniqueAccountTypeId=" + type.value + "&Bind=" + type.getAttribute("data-bind") +
                        ((this.value != "") ? "&" + this.getAttribute("Name") + "=" + ((this.value != "") ? this.value : "") : "") +
                        ((document.getElementById(this.getAttribute("data-related")).value != "") ? "&" + this.getAttribute("data-related") + "=" + ((document.getElementById(this.getAttribute("data-related")).value != "") ? document.getElementById(this.getAttribute("data-related")).value : " ") : "");
                    xmlhttp.open("GET",
                        address
                        , true);
                    xmlhttp.send();
                }
            }
            function getLookupDataItem(e) {
                document.getElementById(e.getAttribute("data-bind")).value = e.getAttribute("data-content");
                for (var j = 0; j < e.querySelectorAll("[data-target]").length; j++) {
                    var elm = document.getElementById(e.querySelectorAll("[data-target]")[j].getAttribute("data-target"));;
                    elm.value = e.querySelectorAll("[data-target]")[j].innerHTML; elm.classList.remove("empty");;
                }
            }
            $('.dropdown.keep-open').on({
                "click": function () { this.classList.add("open"); this.closable = true; },
                "hide.bs.dropdown": function () { this.classList.remove("open"); return this.closable; }
            });
            $('#LocationCreate').keypress(function (e) {

                if (e.which == 13) {

                    var $targ = $(e.target);

                    if (!$targ.is("textarea") && !$targ.is(":button,:submit")) {
                        var focusNext = false;
                        $(this).find(":input:visible:not([disabled],[readonly]), a").each(function () {
                            if (this === e.target) {
                                focusNext = true;
                            }
                            else if (focusNext) {
                                $(this).focus();
                                return false;
                            }
                        });

                        return false;
                    }
                }

            });
        </script>
