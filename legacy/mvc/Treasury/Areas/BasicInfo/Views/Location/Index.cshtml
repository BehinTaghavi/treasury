@{
    ViewBag.Title = Resources.Location;
}

@*@section PageHeader{*@
@*@Resources.List @Resources.Location*@
@*}
    @section btnToolbar{*@
<div class="mdc-bg-grey-50">
    <div class="btn-toolbar">
        <div class="clearfix">
            <div class="pull-right">
                @Ajax.ActionLink(Resources.Create, "Create", "Location", new { Area = "BasicInfo", BranchId = ViewBag.BranchId }, new AjaxOptions
           {
               OnSuccess = "modal(data,'" + @Resources.Create + " " + @Resources.Location + "', 'md')"
           }, new { @class = "btn btn-material-green-600 btn - sm" })
            </div>
        </div>
    </div>
</div>
@*}

    @section list{*@
<div id="Result">
    @Html.Action("List", "Location", new { Area = "BasicInfo", BranchId = ViewBag.BranchId })
</div>
@*  }*@

<script type="text/javascript">
    function updateTable1() {
        var url = '@(Url.Action("List", "Location", new { area = "BasicInfo" }))';
        $.ajax({
            url: url, type: 'get',
            success: function (data, status) {
                $(".table").html(data);
            }
        });

    }
</script>

