@{
    ViewBag.Title = Resources.PettyCash;
}
@section PageHeader{
    @Resources.List @Resources.PettyCash
    <a href="@Url.Content("~/Content/HelpFile/1401-050.docx")" target="_blank" class="btn btn-default btn-sm"> راهنما</a>
}
@section btnToolbar{

    <div class="mdc-bg-grey-50">
        <div class="btn-toolbar">
            <div class="clearfix">
                <div class="pull-right">
                    @Ajax.ActionLink(Resources.Create, "Create", "PettyCash", new { Area = "BasicInfo" }, new AjaxOptions
           {
               OnSuccess = "modal(data,'" + @Resources.Create + " " + @Resources.PettyCash + "', 'md')"
           }, new { @class = "btn btn-material-green-600 btn-sm" })
                </div>
            </div>
        </div>
    </div>
}
@section list{
    <div id="Result">
        @Html.Action("List", "PettyCash", new { Area = "BasicInfo" })
    </div>
}

<script type="text/javascript">
    function updateTable() {
        var url = '@(Url.Action("List", "PettyCash", new { area = "BasicInfo" }))';
        $.ajax({
            url: url, type: 'get',
            success: function (data, status) {
                $("#Result").html(data);
            }
        });
    }

</script>


