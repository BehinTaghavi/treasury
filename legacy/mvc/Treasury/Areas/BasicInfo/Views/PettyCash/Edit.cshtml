@model CSD.Treasury.Service.PettyCashService.PettyCash
@{
    ViewBag.Title = "Edit";
}

@using (Ajax.BeginForm("Edit", "PettyCash", new AjaxOptions
{
    HttpMethod = "Post",
    OnSuccess = "successMessage(data);closeModal('md');updateTable();"
}, new { enctype = "multipart/form-data", @class = "form-horizontal", id = "PettyCashEdit" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.PettyCashID)
        @*<div class="form-group">
                <button type="button" class="btn btn-sm btn-success" id="clone">اضافه کردن ذینفع</button>
            </div>*@
        <div class="form-group">
            <div class="col-sm-3">
                @Html.DropDownList("UniqueAccountType", new SelectList(ViewBag.unique_account_type, "Code", "Description", ViewBag.uniqueTypeId), string.Empty, new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.Type, data_bind = "Unique_Account_No", data_code_att = "Code", data_name_att = "Name", updatetargetid = "UniqueAccountList" })
            </div>
            <div class="col-sm-9">
                @Html.DropDownListFor(model => model.Unique_Account_No, new SelectList(ViewBag.SlectedLs, "Account_Code", "Account_Name", new { Type_Code = Model.Unique_Account_No }), new { required = "required", data_lang_number = "fa", @class = "form-control floating-label js-data-example-ajax", placeholder = Resources.Unique_Account_Code + "/" + Resources.Unique_Account_No })
                @Html.ValidationMessageFor(model => model.Unique_Account_No)
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-6">
                @Html.Hidden("InitialPettyCashName", Model.PettyCashName)
                @Html.EditorFor(model => model.PettyCashName, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.PettyCash } })
                @Html.ValidationMessageFor(model => model.PettyCashName, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-6">
                <input type="number" id="PettyCash_Ammount" name="PettyCash_Ammount" placeholder="@Resources.PayAmount" class="form-control floating-label" value="@(Model.PettyCash_Ammount!=null ? (Int64)Model.PettyCash_Ammount : 0)" />
                @Html.ValidationMessageFor(model => model.PettyCash_Ammount, "", new { @data_lang_number = "fa", @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-6">
                <input type="number" id="PayCeiling" name="PayCeiling" placeholder="@Resources.PayCeiling" class="form-control floating-label" value="@(Model.PayCeiling!=null ? (Int64)Model.PayCeiling: 0)" />
                @Html.ValidationMessageFor(model => model.PayCeiling, "", new { @data_lang_number = "fa", @class = "text-danger" })
            </div>
            <div class="col-md-6">
                <input type="number" id="Settle_Limit" name="Settle_Limit" placeholder="@Resources.Settle_Limit" class="form-control floating-label" value="@(Model.Settle_Limit!=null ? (Int64)Model.Settle_Limit:0)" />
                @Html.ValidationMessageFor(model => model.Settle_Limit, "", new { @data_lang_number = "fa", @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-6">
                @Html.DropDownListFor(model => model.cmpBranchID, new SelectList(ViewBag.BranchLs, "cmpBranchID", "cmpBranchName"), " ", new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.Branch })
                @Html.ValidationMessageFor(model => model.cmpBranchID)
            </div>
            <div class="col-md-6">
                @Html.DropDownListFor(model => model.Account_No, new SelectList(ViewBag.v_accounts, "account_code", "Account_Name"), " ", new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.account_code })
                @Html.ValidationMessageFor(model => model.Account_No)
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-6">
                @Html.DropDownList("BehalfGroup", ViewBag.BehalfGroup as SelectList, new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.BehalfGroup, multiple = "multiple" })
                @*@Html.DropDownList("BehalfGroup", new SelectList(ViewBag.BehalfGroup, "BehalfGroupID", "BehalfGroupDescription"), new { data_lang_number="fa", @class = "form-control floating-label", @placeholder = Resources.BehalfGroup, multiple = "multiple" })*@
            </div>

            <div class="col-md-6">
                @Html.DropDownListFor(model => model.UserID, new SelectList(ViewBag.UserLs, "UserID", "User_FullName", new { Model.UserID }), " ", new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.UserName })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-6">
                @Resources.RecoverType:
                <label>
                    <input type="radio" name="RecoveryType" value="true" @(Model.RecoveryType == true ? "checked=\"checked\"" : "") /> @Resources.Cheque
                </label>
                <label>
                    <input type="radio" name="RecoveryType" value="false" @(Model.RecoveryType == false ? "checked=\"checked\"" : "") /> @Resources.Cash
                </label>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-12">
                <div class="text-right">
                    <button type="submit" class="btn btn-primary btn-sm">@Resources.Save</button>
                </div>
            </div>
        </div>
    </div>
}

