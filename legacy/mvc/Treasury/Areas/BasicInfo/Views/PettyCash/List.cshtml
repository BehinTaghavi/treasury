@model IEnumerable<CSD.Treasury.Service.PettyCashService.PettyCash>

<table class="table table-striped sortable">
    <thead>
        <tr class="mdc-bg-grey-200">
            <th>
                @Resources.Unique_Account_No
            </th>
            <th>
                @Resources.PettyCashName
            </th>
            <th>
                @Resources.account_code
            </th>
            <th>
                @Resources.UserName
            </th>
            <th>
                @Resources.Price
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var related2 = Utility.HasRelation("PettyCash", "PettyCashID", item.PettyCashID.ToString(), "PettyCash_TransactionHeader", "PettyCashID");

            <tr>
                <td>
                    @Utility.GetUniqueAccount(item.Unique_Account_No)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PettyCashName)
                </td>

                <td>
                    @if (item.Account_No != null)
                    {
                        @Utility.Getaccounts(item.Account_No)
                    }
                </td>
                <td>
                    @Utility.GetUserName(item.UserID)
                </td>
                <td data-lang-number="fa">
                    @Math.Truncate(item.PettyCash_Ammount.Value).ToString("#,##0")
                </td>
                <td>
                    @if (related2)
                    {
                        <button class="btn  btn-material-grey btn-xs " disabled title="@Resources.RelationsError">@Resources.Edit</button>
                        <button class="btn  btn-material-grey btn-xs delete " disabled title="@Resources.RelationsError">@Resources.Delete</button>
                    }
                    else
                    {
                        @Ajax.ActionLink(Resources.Edit, "Edit", "PettyCash", new { Area = "BasicInfo", id = item.PettyCashID }, new AjaxOptions
                   {
                       OnSuccess = "modal(data,'" + Resources.Edit + " " + Resources.PettyCash + "', 'md');"
                   }, new { @class = "btn btn-success btn-xs" })


                        @Html.ActionLink(Resources.Delete, "Delete", "PettyCash", new { Area = "BasicInfo", PettyCashID = item.PettyCashID }, new { @class = "btn btn-danger btn-xs delete" })
                    }
                    @Ajax.ActionLink(Resources.Details, "Details", "PettyCash", new { Area = "BasicInfo", PettyCashID = item.PettyCashID }, new AjaxOptions
               {
                   OnSuccess = "modal(data,'" + Resources.Details + " " + Resources.Cashier + "', 'md');"
               }, new { @class = "btn btn-success btn-xs" })
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    //$(document).ready(function () {
    //    $(function () {
    //        $("#myTable").tablesorter();
    //    });
    //});

    var deleteBtn = document.getElementsByClassName("delete");

    for (var i = 0; i < deleteBtn.length; i++) {
        deleteBtn[i].addEventListener("click", deleteItem);
    }
    function deleteItem(e) {
        e.preventDefault();
        var item = this;
        alertify.confirm("", '@Resources.AreYouSure',
                   function () {
                       var xmlhttp = new XMLHttpRequest();
                       xmlhttp.onreadystatechange = function () {
                           if (xmlhttp.readyState == 4 && xmlhttp.status == 200) {
                               var data = JSON.parse(xmlhttp.responseText);
                               if (data.result == true) {
                                   item.deleteParentByTagName("tr", "danger", 1500, function () {
                                       alertify.success(data.Message);
                                   })
                               }
                               else {
                                   alertify.error(data.Message);
                               }
                           }
                       };
                       xmlhttp.open("POST", item.href, true);
                       xmlhttp.send();
                   },
  function () {
  }).set('labels', { ok: 'بله', cancel: 'خیر' }).set({ transition: 'zoom' }).set('modal', false);
    }

</script>
