    function setKeyUp(uniqueAccountTypeId, UniqueAccountListId, rowId) {
        if (rowId != "") {
            var lookup = document.getElementById(rowId).querySelectorAll("[lookup]");
        }
        else {
            var lookup = document.querySelectorAll("[lookup]");
        }
        for (var i = 0; i < lookup.length; i++) {
            lookup[i].onkeyup = function () {
                var _this = this;

                var xmlhttp = new XMLHttpRequest();
                xmlhttp.onreadystatechange = function () {
                    if (xmlhttp.readyState == 4 && xmlhttp.status == 200) {
                        document.getElementById(UniqueAccountListId).innerHTML = xmlhttp.responseText;
                    }
                }
                var type = document.getElementById(uniqueAccountTypeId);
                var address = "/Payment/Request/" + _this.getAttribute("data-action") +
                              "?CodeField=" + ((_this.getAttribute("Name") == "Code") ? _this.getAttribute("Id") : _this.getAttribute("data-related")) +
                              "&NameField=" + ((_this.getAttribute("Name") == "Name") ? _this.getAttribute("Id") : _this.getAttribute("data-related")) +
                              "&UniqueAccountTypeId=" + type.value + "&Bind=" + type.getAttribute("data-bind") +
                              ((_this.value != "") ? "&" + _this.getAttribute("Name") + "=" + ((_this.value != "") ? _this.value : "") : "") +
                              ((document.getElementById(_this.getAttribute("data-related")).value != "") ? "&" + _this.getAttribute("data-related") + "=" + ((document.getElementById(_this.getAttribute("data-related")).value != "") ? document.getElementById(_this.getAttribute("data-related")).value : " ") : "");

                xmlhttp.open("GET",
                    address
                    , true);

                xmlhttp.send();
            }
        }
    }
    function getLookupDataItem(e) {
        document.getElementById(e.getAttribute("data-bind")).value = e.getAttribute("data-content").trim();
        for (var j = 0; j < e.querySelectorAll("[data-target]").length; j++) {
            var elm = document.getElementById(e.querySelectorAll("[data-target]")[j].getAttribute("data-target"));
