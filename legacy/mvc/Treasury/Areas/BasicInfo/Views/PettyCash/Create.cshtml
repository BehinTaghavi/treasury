@model CSD.Treasury.Service.PettyCashService.PettyCash

@using (Ajax.BeginForm("Create", "PettyCash", new AjaxOptions
{
    HttpMethod = "Post",
    OnSuccess = "successMessage(data);closeModal('md');updateTable();"
}, new { enctype = "multipart/form-data", @class = "form-horizontal", id = "PettyCashCreate" }))
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @*<div class="form-group">
            <button type="button" class="btn btn-sm btn-success" id="clone">اضافه کردن ذینفع</button>
        </div>*@
    <div class="form-group">
        <div class="col-sm-3">
            @Html.DropDownList("UniqueAccountType", new SelectList(ViewBag.unique_account_type, "Code", "Description"), string.Empty, new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.Type, data_bind = "Unique_Account_No" })
        </div>
        <div class="col-sm-9">
            @Html.DropDownListFor(model => model.Unique_Account_No, Enumerable.Empty<SelectListItem>(), new { required = "required", data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.Unique_Account_Code + "/" + Resources.Unique_Account_No })
            @Html.ValidationMessageFor(model => model.Unique_Account_No)
        </div>
    </div>

    @*<div id="add">

        </div>*@
    <div class="form-group">
        <div class="col-md-6">
            @Html.EditorFor(model => model.PettyCashName, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.PettyCashName } })
            @Html.ValidationMessageFor(model => model.PettyCashName, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-6">
            @Html.EditorFor(model => model.PettyCash_Ammount, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.PayAmount } })
            @Html.ValidationMessageFor(model => model.PettyCash_Ammount, "", new { @class = "text-danger" })
        </div>

    </div>
    <div class="form-group">
        <div class="col-md-12">
            <b id="PettyCash_AmmountText" class="mdc-text-green-700"></b>
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-12">
            @Html.EditorFor(model => model.PayCeiling, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.PayCeiling } })
            @Html.ValidationMessageFor(model => model.PayCeiling, "", new { @class = "text-danger" })
        </div>

    </div>
    <div class="form-group">
        <div class="col-md-12">
            <b id="PayCeilingText" class="mdc-text-green-700"></b>
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-12">
            @Html.EditorFor(model => model.Settle_Limit, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.Settle_Limit } })
            @Html.ValidationMessageFor(model => model.Settle_Limit, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-12">
            <b id="Settle_LimitText" class="mdc-text-green-700"></b>
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-6">
            @Html.DropDownListFor(model => model.cmpBranchID, new SelectList(ViewBag.BranchLs, "cmpBranchID", "cmpBranchName"), "", new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.Branch })
            @Html.ValidationMessageFor(model => model.cmpBranchID)
        </div>
        <div class="col-md-6">
            @Html.DropDownListFor(model => model.Account_No, new SelectList(ViewBag.v_accounts, "account_code", "Account_Name"), "", new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = "شماره حساب تنخواه گردان" })
            @Html.ValidationMessageFor(model => model.Account_No)
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-6">
            @Html.DropDownList("BehalfGroup", new SelectList(ViewBag.BehalfGroup, "BehalfGroupID", "BehalfGroupDescription"), new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.BehalfGroup, multiple = "multiple" })
        </div>

        <div class="col-md-6">
            @Html.DropDownListFor(model => model.UserID, new SelectList(ViewBag.UserLs, "UserID", "User_FullName"), " ", new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.UserName })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-6">
            @Resources.RecoverType:
            <label>
                <input type="radio" name="RecoveryType" value="true" checked="checked" /> @Resources.Cheque
            </label>
            <label>
                <input type="radio" name="RecoveryType" value="false"  /> @Resources.Cash
            </label>
        </div>
    </div>

    <div class="form-group">
        <div class="col-sm-12">
            <div class="text-right">
                <button type="submit" class="btn btn-primary btn-sm">@Resources.Save</button>
            </div>
        </div>
    </div>

</div>
}
