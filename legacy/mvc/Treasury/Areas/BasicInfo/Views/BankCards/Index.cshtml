@{
    ViewBag.Title = Resources.BankCard;
    var Bank = Utility.GetBasicBankInfoWithBankId(ViewBag.BankId);
    var BranchName = Utility.GetBankInfoBankId(ViewBag.BankId).BranchName;
}

@section PageHeader{
    @Resources.List @Resources.BankCard  @(Bank)- @(BranchName)
}

@section btnToolbar{
    <div class="mdc-bg-grey-50">
        <div class="btn-toolbar">
            <div class="clearfix">
                <div class="pull-right">

                    @Ajax.ActionLink(Resources.Create, "Create", "BankCards", new { Area = "BasicInfo", BankId = ViewBag.BankId }, new AjaxOptions
               {
                   OnSuccess = "modal(data,'" + @Resources.Create + " " + @Resources.BankCard + " " + Bank + "/" + BranchName + "', 'md')"
               }, new { @class = "btn btn-material-green-600 btn-sm" })
                </div>
                <div class="pull-left">
                    @Html.ActionLink(Resources.Back, "Index", "Banks", new { Area = "BasicInfo", BankId = ViewBag.BankId, BasicBankID = ViewBag.BasicBankID }, new { @class = "btn btn-default btn-sm" })
                </div>
            </div>
        </div>
    </div>
}
@section list{
    <div id="Result">
        @Html.Action("List", "BankCards", new { Area = "BasicInfo" })
    </div>
}

<script type="text/javascript">
    function LoadDetails() {
        var url = '@(Url.Action("List", "BankCards", new { area = "BasicInfo", BankId = ViewBag.BankId, BasicBankID = ViewBag.BasicBankID }))';
        $.ajax({
            url: url, type: 'get',
            data: {
                BankId: @(ViewBag.BankId),
                BasicBankID:@(ViewBag.BasicBankID),
            },
            success: function (data, status) {
                $("#Result").html(data);
            }
        });
    }
</script>