@model CSD.Treasury.Service.BankCardsService.BankCard

@{
    ViewBag.Title = "Delete";
}

<h5>@Resources.AreYouSure</h5>
<div>
   
 @using (Ajax.BeginForm("Delete", "BankCards", new AjaxOptions
 {
     HttpMethod = "Post",
     LoadingElementId = "loading",
     OnSuccess = "successMessage(data);updateTable();closeModal('sm');"
 }, new { enctype = "multipart/form-data" }))
 {

         @Html.AntiForgeryToken()
         @Html.HiddenFor(model=>model.CardID)
    <button class="btn btn-primary btn-xs" type="submit">@Resources.Yes</button>
        <button class="btn btn-material-grey btn-xs" onclick="closeModal('sm')" type="button">@Resources.NO</button>
 }
</div>
