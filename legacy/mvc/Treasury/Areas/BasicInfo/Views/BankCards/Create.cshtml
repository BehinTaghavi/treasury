@model CSD.Treasury.DataModel.BankCard
@using (Ajax.BeginForm("Create", "BankCards", new AjaxOptions
{
    HttpMethod = "Post",
    LoadingElementId = "loading",
    OnSuccess = "successMessage(data);LoadDetails();closeModal('md');",

}, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model=>model.BankID)
<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="row">
        <div class="col-sm-3">
            <div class="form-group">
                <div class="col-xs-12">
                    @Html.DropDownList("UniqueAccountType", new SelectList(ViewBag.unique_account_type, "Code", "Description"), string.Empty, new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.Type, data_bind = "Unique_Account_No" })
                </div>
            </div>
        </div>
        <div class="col-sm-9">
            <div class="form-group">
                @Html.DropDownListFor(model => model.Unique_Account_No, Enumerable.Empty<SelectListItem>(), new { required = "required", data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.Unique_Account_Code + "/" + Resources.Unique_Account_No })
            </div>
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-10">
            @Html.EditorFor(model => model.CVV2, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = "CVV2" } })
            @Html.ValidationMessageFor(model => model.CVV2, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-10">
            @Html.EditorFor(model => model.Card_AccountNo, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.AccountNo } })
            @Html.ValidationMessageFor(model => model.Card_AccountNo, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-10">
            @Html.EditorFor(model => model.Card_NO, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.CardNO } })
            @Html.ValidationMessageFor(model => model.Card_NO, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-10">
            @Html.EditorFor(model => model.ExpiryDate, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label Date", placeholder = Resources.Date, @readonly = "readonly" } })
            @Html.ValidationMessageFor(model => model.ExpiryDate, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-10">
            <div>
                @Resources.IsActive
                @Html.CheckBoxFor(model => model.IsActive)
                @Html.ValidationMessageFor(model => model.IsActive, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="form-group">
        <div class="col-sm-12">
            <div class="text-right">
                <button type="submit" class="btn btn-primary btn-sm">@Resources.Save</button>
            </div>
        </div>
    </div>
</div>
}
@Scripts.Render("~/bundles/jqueryval")
<script type="text/javascript">
    jQuery(function ($) {
        $(".Date").mask("9999/99/99");
    });
    $(function () {
        $.material.init();
    });

    $("#ExpiryDate").datepicker({
        dateFormat: "yy/mm/dd",
        changeMonth: true,
        changeYear: true,
        showButtonPanel: true
    });
        var pageSize = 20;
    $("#UniqueAccountType").change(function () {
        $('#Unique_Account_No').val('');
        var typeid = $(this).val();
        $("#Unique_Account_No").select2({
            dir: "rtl",
            containerCssClass: "form-control",
            ajax: {
                url: "/Payment/Request/UniqueAccountLs",
                dataType: 'json',
                delay: 250,

                data: function (params) {
                    params.page = params.page || 1;
                    return {
                        pageSize: pageSize,
                        page: params.page,
                        pageLimit: 10,
                        typeid: typeid,
                        q: params.term, // search term
                    };
                },
                processResults: function (data, params) {

                    params.page = params.page || 1;
                    return {
                        results: data.query,
                        pagination: {
                            more: (params.page * pageSize < data.total_count)
                        }
                    };
                },

                cache: true
            },
            escapeMarkup: function (markup) { return markup; }, // let our custom formatter work
            minimumInputLength: 1,
            //templateResult: formatRepo, // omitted for brevity, see the source of this page
            //templateSelection: formatRepoSelection // omitted for brevity, see the source of this page
        });
    });
</script>