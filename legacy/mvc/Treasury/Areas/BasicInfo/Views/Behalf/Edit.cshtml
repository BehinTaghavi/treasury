@model CSD.Treasury.Service.BehalfsService.Behalf
@using System.Configuration;
@{
    ViewBag.Title = "Edit";
}

@using (Ajax.BeginForm("Edit", "Behalf", new AjaxOptions
{
    HttpMethod = "Post",
    LoadingElementId = "loading",
    OnSuccess = "successMessage(data);closeModal('sm');updateTable();"
}, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model=>model.BehalfGroupID)
    <div class="row">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            <div class="col-md-10">
                @Html.Hidden("InitialBehalfDescription", Model.BehalfDescription)
                @Html.EditorFor(model => model.BehalfDescription, new { htmlAttributes = new { data_lang_number="fa", @class = "form-control floating-label", placeholder = Resources.Behalf } })
                @Html.ValidationMessageFor(model => model.BehalfDescription, "", new { @class = "text-danger" })
            </div>
        </div>
@if (ConfigurationManager.AppSettings["bilingual"] == "True")
{
        <div class="form-group">
            <div class="col-md-10">
                @Html.EditorFor(model => model.BehalfDescription2, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.Behalf + "-" + Resources.EN } })
                @Html.ValidationMessageFor(model => model.BehalfDescription2, "", new { @class = "text-danger" })
            </div>
        </div>
}
        @Html.HiddenFor(model => model.BehalfID)

        <div class="form-group">
            <div class="col-sm-12">
                <div class="text-right">
                    <button type="submit" class="btn btn-primary btn-sm">@Resources.Save</button>
                    <a class="btn btn-white btn-sm" data-ajax="true" data-ajax-success="modal(data,'@Resources.BehalfGroup / @ViewBag.BehalfGroupDescription', 'md')" href="@Url.Action("Index", "Behalf", new { area = "BasicInfo", BehalfGroupID = Model.BehalfGroupID, BehalfGroupDescription = ViewBag.BehalfGroupDescription })"><i class="zmdi zmdi-chevron-left zmdi-hc-lg"></i></a>
                </div>
            </div>
        </div>
    </div>
}

@Scripts.Render("~/bundles/jqueryval")
<script>
        $(function () {
            $.material.init();
        });
</script>
