@model CSD.Treasury.UI.Models.SearchModelBehalf
@{
    ViewBag.Title = "Index";
    var tableId = Guid.NewGuid().ToString("N");
}
<div class="mdc-bg-grey-50">
    <div class="btn-toolbar">
        <div class="clearfix">
            <div >
                @Ajax.ActionLink(Resources.Create, "Create", "Behalf",
               new {
                   Area = "BasicInfo",
                   BehalfGroupID = ViewBag.BehalfGroupID,
                   BehalfGroupDescription = ViewBag.BehalfGroupDescription,
                   FromCreateRequest = ViewBag.FromCreateRequest },
               new AjaxOptions
               {
                   OnSuccess = "modal(data,'" + Resources.Create + " " + Resources.Behalf + "', 'md');"
               }, new { @class = "btn btn-material-green-600 btn-sm" })
            </div>
            <div>
                @using (Ajax.BeginForm("List", "Behalf", new { Area = "BasicInfo" },
                            new AjaxOptions()
                            {
                                UpdateTargetId = "Result2",
                                InsertionMode = InsertionMode.Replace,
                            }, null))
                {
                    @Html.HiddenFor(d=>d.BehalfGroupID)
                    <div class="col-sm-4">
                        <div class="form-group">
                            @Html.TextBoxFor(d => d.BehalfDescription, new { data_lang_number = "fa", @class = "form-control from floating-label datepicker", @placeholder = Resources.Behalf + "-" + Resources.Title })
                        </div>
                    </div>
                    <div class="pull-right" >
                        <div class="col-sm-12">
                            <div class="text-left">
                                <button type="submit" class="btn btn-info btn-sm">@Resources.Search</button>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<div id="Result2" class="@tableId">
    @Html.Action("List", "Behalf", new { Area = "BasicInfo", BehalfGroupID = ViewBag.BehalfGroupID, BehalfGroupDescription = ViewBag.BehalfGroupDescription })
</div>
@section scripts{
    <script type="text/javascript">
        function updateTable() {
            var url = '@(Url.Action("List", "Behalf", new { area = "BasicInfo", BehalfGroupID = ViewBag.BehalfGroupID, BehalfGroupDescription = ViewBag.BehalfGroupDescription }))';
            $.ajax({
                url: url,
                type: 'get',
                success: function (data, status) {
                    $(".@tableId").html(data);
                }
            });
        }
    </script>
}

