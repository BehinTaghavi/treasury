@{
    ViewBag.Title = Resources.Back;
}
@section PageHeader{
    @Resources.List @Resources.BasicBank
}
@section btnToolbar{
    <div class="mdc-bg-grey-50">
        <div class="btn-toolbar">
            <div class="clearfix">
                <div class="pull-right">
                    @Ajax.ActionLink(Resources.Create, "Create", "BasicBank", new { Area = "BasicInfo" }, new AjaxOptions
           {
               OnSuccess = "modal(data,'" + @Resources.Create + " " + @Resources.Bank + "', 'md')"
           }, new { @class = "btn btn-material-green-600 btn-sm" })
                </div>
            </div>
        </div>
    </div>
}
@section list{
<div id="Result">
    @Html.Action("List", "BasicBank", new { Area = "BasicInfo" })
</div>
}

<script type="text/javascript">
    function updateTable() {
        var url = '@(Url.Action("List", "BasicBank", new { area = "BasicInfo" }))';
        $.ajax({
            url: url, type: 'get',
            success: function (data, status) {
                $("#Result").html(data);
            }
        });

    }
</script>