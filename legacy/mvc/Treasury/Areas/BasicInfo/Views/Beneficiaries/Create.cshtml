@model CSD.Treasury.DataModel.Beneficiary
@{
    ViewBag.Title = "Create";
}
@using (Ajax.BeginForm("Create", "Beneficiaries", new AjaxOptions
{
    HttpMethod = "Post",
    LoadingElementId = "loading",
    OnSuccess = "successMessage(data);updateTable();closeModal('md');location.reload();",

}, new { enctype = "multipart/form-data", @class = "form-horizontal", id = "BeneficiariesCreate" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            <div class="clearfix">
                <div class="col-sm-3">
                    <label class="control-label">نوع ذینفع</label>
                    @Html.DropDownList("UniqueAccountType", new SelectList(ViewBag.unique_account_type, "Code", "Description"), "", new { data_lang_number = "fa", @class = "form-control", data_bind = "Unique_Account_No" })
                </div>
                <div class="col-sm-9">
                    <label class="control-label">شماره و عنوان ذینفع</label>
                    @Html.DropDownListFor(model => model.Unique_Account_No, Enumerable.Empty<SelectListItem>(), new { required = "required", data_lang_number = "fa", @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Unique_Account_No)
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="clearfix">
                <div class="col-md-6">
                    <label class="control-label">@Resources.LegalAccountName</label>
                    @Html.EditorFor(model => model.LegalAccountName, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control", placeholder = Resources.LegalAccountName } })
                    @Html.ValidationMessageFor(model => model.LegalAccountName, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6">
                    <label class="control-label">کدپستی</label>
                    @Html.EditorFor(model => model.CodePosti, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control", placeholder = "کدپستی" } })
                    @Html.ValidationMessageFor(model => model.CodePosti, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="clearfix">
                <div class="col-md-12">
                    <label class="control-label">آدرس</label>
                    @Html.EditorFor(model => model.AddressePosti, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control", placeholder = "آدرس" } })
                    @Html.ValidationMessageFor(model => model.AddressePosti, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="clearfix">
                <div class="col-md-12">                 
                    <input 
                           name="LegalPerson"
                           type="radio"
                           value="false"
                           checked/>
                    <label>شخص حقیقی</label><br>

                    <input  
                           name="LegalPerson"
                           type="radio"
                           value="true" />
                    <label>شخص حقوقی</label><br>
                    @*<input type="radio" id="realperson" name="PersonType" checked="checked" value="realperson">
        <label for="realperson">شخص حقیقی</label><br>
        <input type="radio" id="Legalperson" name="PersonType" value="Legalperson">
        <label for="Legalperson">شخص حقوقی</label><br>*@
                </div>
            </div>
        </div>
        <div class="form-group" id="realpersonshow">
            <div class="clearfix">
                <div class="col-md-6">
                    <label class="control-label">کدملی</label>
                    @Html.EditorFor(model => model.CodeMeli, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control", placeholder = "کدملی" } })
                    @Html.ValidationMessageFor(model => model.CodeMeli, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="form-group" id="Legalpersonshow" hidden="hidden">
            <div class="clearfix">
                <div class="col-md-4">
                    <label class="control-label">شناسه ملی</label>
                    @Html.EditorFor(model => model.ShenaseMelli, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control", placeholder = "شناسه ملی" } })
                    @Html.ValidationMessageFor(model => model.ShenaseMelli, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4">
                    <label class="control-label">کداقتصادی</label>
                    @Html.EditorFor(model => model.CodeEghtesadi, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control", placeholder = "کداقتصادی" } })
                    @Html.ValidationMessageFor(model => model.CodeEghtesadi, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4">
                    <label class="control-label">شماره ثبت</label>
                    @Html.EditorFor(model => model.ShomareyeSabt, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control", placeholder = "شماره ثبت" } })
                    @Html.ValidationMessageFor(model => model.ShomareyeSabt, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-12">
                <div class="text-right">
                    <button type="submit" class="btn btn-primary btn-sm">@Resources.Save</button>
                </div>
            </div>
        </div>
    </div>
}
@*@Scripts.Render("~/bundles/jqueryval")*@
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="@Url.Content("~/Scripts/select2.full.min.js")"></script>
<script type="text/javascript">
    function clearInput() {
        var LegalPerson = $('#LegalPerson').val();
        if (LegalPerson == true) {
            $("#ShenaseMelli").val("");
            $("#CodeEghtesadi").val("");
            $("#ShomareyeSabt").val("");
        }
        else {
            $("#CodeMeli").val("");
            console.log($("#CodeMeli").val("") );
        }
    }
    $(document).ready(function () {
        //$("#CodeMeli").change(function () {
        //    $("#ShenaseMelli").val($("#CodeMeli").val());
        //});
       
        
        $('input[type=radio][name=LegalPerson]').change(function () {
            if (this.value == 'false') {
                $("#realpersonshow").removeAttr('hidden');
                $("#Legalpersonshow").attr("hidden", "hidden");    
                $("#ShenaseMelli").val("");
                $("#CodeEghtesadi").val("");
                $("#ShomareyeSabt").val("");
            }
            else if (this.value == 'true') {
                $("#Legalpersonshow").removeAttr('hidden');
                $("#realpersonshow").attr("hidden", "hidden");
                $("#CodeMeli").val("");        
            }
        });
        }
    );
    $(function () {
        $.material.init();
        $('#Unique_Account_No').val('');
        $("#Unique_Account_No").select2();
        $("#Unique_Account_No").select2('destroy');
    })
    $('#BeneficiariesCreate').keypress(function (e) {

        if (e.which == 13) {

            var $targ = $(e.target);

            if (!$targ.is("textarea") && !$targ.is(":button,:submit")) {
                var focusNext = false;
                $(this).find(":input:visible:not([disabled],[readonly]), a").each(function () {
                    if (this === e.target) {
                        focusNext = true;
                    }
                    else if (focusNext) {
                        $(this).focus();
                        return false;
                    }
                });

                return false;
            }
        }

    });
    var pageSize = 20;
    $("#UniqueAccountType").change(function () {
        console.log("hello");
        $('#Unique_Account_No').val('');
        var typeid = $(this).val();
        $("#Unique_Account_No").select2({
            dir: "rtl",
            containerCssClass: "form-control",
            ajax: {
                url: "/Payment/Request/UniqueAccountLs",
                dataType: 'json',
                delay: 250,

                data: function (params) {
                    params.page = params.page || 1;
                    return {
                        pageSize: pageSize,
                        page: params.page,
                        pageLimit: 10,
                        typeid: typeid,
                        q: params.term, // search term
                    };
                },
                processResults: function (data, params) {

                    params.page = params.page || 1;
                    return {
                        results: data.query,
                        pagination: {
                            more: (params.page * pageSize < data.total_count)
                        }
                    };
                },

                cache: true
            },
            escapeMarkup: function (markup) { return markup; }, // let our custom formatter work
            minimumInputLength: 1,
            //templateResult: formatRepo, // omitted for brevity, see the source of this page
            //templateSelection: formatRepoSelection // omitted for brevity, see the source of this page
        });
    });
    $("#Unique_Account_No").change(function () {
        setTimeout(function () {
            $("#LegalAccountName").val($("#select2-Unique_Account_No-container").text().split('-')[1]);
        }, 1000)

    });
