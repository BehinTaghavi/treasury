@model CSD.Treasury.UI.Models.SearchModelBeneficiaries
@using CSD.Treasury.UI.Models
@using CSD.Treasury.UI.Helper
@using CSD.Treasury.Common.Enumeration
@{
    int i = Model.PageIndex * Model.PageSize;
    Model.Area = "BasicInfo";
    int ix = Model.PageIndex;
}
<table class="table table-striped sortable">
    <thead>
        <tr class="mdc-bg-grey-200">
            <th>#</th>
            <th>@Resources.LegalAccountName</th>
            <th>شماره تفصیل</th>
            <th>@Resources.Unique_Account_No</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.List)
        {

            var related1 = Utility.HasRelation("Beneficiaries", "BeneficiarID", item.BeneficiarID.ToString(), "BeneficiariesDetailInfo", "BeneficiarID");
            var related2 = Utility.HasRelation("Beneficiaries", "BeneficiarID", item.BeneficiarID.ToString(), "Beneficiaries_TELS", "BeneficiarID");
            var related3 = Utility.HasRelation("Beneficiaries", "Unique_Account_No", item.Unique_Account_No.ToString(), "Request_Payment", "Unique_Account_No");

            <tr>
                <td>@(i = i + 1)</td>
                <td>@item.LegalAccountName</td>
                <td>@item.Unique_Account_No</td>
                <td>@Utility.GetUniqueAccount(item.Unique_Account_No)</td>
                <td>
                    @Ajax.ActionLink(Resources.Edit, "Edit", "Beneficiaries", new { Area = "BasicInfo", id = item.BeneficiarID }, new AjaxOptions
                 {
                     OnSuccess = "modal(data,'" + Resources.Edit + " " + Resources.Beneficiaries + "', 'md');"
                 }, new { @class = "btn btn-success btn-xs" })

                    @*<button class="btn  btn-material-grey btn-xs " disabled title="@Resources.RelationsError">@Resources.Edit</button>*@
                    @if (related1 || related2 || related3)
                    {
                        <button class="btn  btn-material-grey btn-xs delete " disabled title="@Resources.RelationsError">@Resources.Delete</button>
                    }
                    else
                    {
                    @Html.ActionLink(Resources.Delete, "Delete", "Beneficiaries", new { Area = "BasicInfo", id = item.BeneficiarID }, new { @class = "btn btn-danger btn-xs delete" })
                    }

                    @Ajax.ActionLink(Resources.BankAccount, "DetailsList", "Beneficiaries", new { Area = "BasicInfo", BeneficiarID = item.BeneficiarID }, new AjaxOptions
               {
                   OnSuccess = "modal(data,'" + Resources.BankAccount + " " + Resources.Beneficiaries + "/" + item.LegalAccountName + "', 'lg:not(.xlg)')"
               }, new { @class = "btn btn-material-light-blue-A700 btn-xs" })

                    @Ajax.ActionLink(Resources.Tel, "BeneficiariesDetails", "Beneficiaries", new { Area = "BasicInfo", id = item.BeneficiarID }, new AjaxOptions
               {
                   OnSuccess = "modal(data,'" + Resources.Tel + " " + Resources.Beneficiaries + "', 'md');"
               }, new { @class = "btn btn-material-light-blue-A700 btn-xs" })

                </td>
            </tr>
             } 
        </tbody>
</table>
<div class="container-fluid">
    <div class="clearfix">
        <div class="pull-right">
            <span class="pagination pagination-total">
                @Resources.Total : @Model.TotalItemCount
                @Resources.Page @(ix + 1)
                @Resources.From @Model.TotalPageCount
            </span>
        </div>
        <div class="pull-left">
            <nav class="text-center">
                <ul class="pagination  pagination-sm">
                    @{
                        var start = ix;
                        if (start > 0)
                        {
                            int c = 0;
                            while (start > 0 && c < 4)
                            {
                                c++;
                                start--;
                            }
                        }
                        if (ix != 0)
                        {
                            Model.PageIndex = 0;
                            <li>
                                @Ajax.ActionLink("<<", "List", "Beneficiaries", Model,
    new AjaxOptions
    {
        UpdateTargetId = "Result",
        InsertionMode = InsertionMode.Replace,
        HttpMethod = "post",

    })

                            </li>
                        }
                        for (int j = start; j < Model.TotalPageCount && j < start + 10; j++)
                        {
                            if (ix != j)
                            {
                                Model.PageIndex = j;
                                <li>
                                    @Ajax.ActionLink((j + 1).ToString(), "List", "Beneficiaries", Model,
    new AjaxOptions
    {
        UpdateTargetId = "Result",
        HttpMethod = "post",
        InsertionMode = InsertionMode.Replace,

    })
                                </li>
                            }
                            else
                            {
                                <li class="active">
                                    <span>@(j + 1) <span class="sr-only">(current)</span></span>
                                </li>
                            }
                        }
                        if (start + 9 < Model.TotalPageCount)
                        {
                            <li>
                                @Ajax.ActionLink(">>", "List", "Beneficiaries", Model,
    new AjaxOptions
    {
        UpdateTargetId = "Result",
        HttpMethod = "post",
        InsertionMode = InsertionMode.Replace,

    })
                            </li>
                        }
                    }
                </ul>
            </nav>
        </div>
    </div>

</div>

<script>
    var deleteBtn = document.getElementsByClassName("delete");
    for (var i = 0; i < deleteBtn.length; i++) {
        deleteBtn[i].addEventListener("click", deleteItem);
    }
    function deleteItem(e) {
        e.preventDefault();
        var item = this;
        alertify.confirm("", '@Resources.AreYouSure',
                   function () {
                       var xmlhttp = new XMLHttpRequest();
                       xmlhttp.onreadystatechange = function () {
                           if (xmlhttp.readyState == 4 && xmlhttp.status == 200) {
                               var data = JSON.parse(xmlhttp.responseText);
                               if (data.result == true) {
                                   item.deleteParentByTagName("tr", "danger", 1500, function () {
                                       alertify.success(data.message);
                                   })
                               }
                               else {
                                   alertify.error(data.message);
                               }
                           }
                       };
                       xmlhttp.open("POST", item.href, true);
                       xmlhttp.send();
                   },
  function () {
  }).set('labels', { ok: 'بله', cancel: 'خیر' }).set({ transition: 'zoom' }).set('modal', false);
    }

</script>



