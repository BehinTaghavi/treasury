@model CSD.Treasury.Service.BeneficiariesDetailInfoService.BeneficiariesDetailInfo

@using (Ajax.BeginForm("EditDetails", "Beneficiaries", new AjaxOptions
{
    HttpMethod = "Post",
    OnSuccess = "successMessage(data);"
}, new { enctype = "multipart/form-data", @class = "form-horizontal",id= "EditDetails" }))
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            <div class="col-md-10">
                @Html.HiddenFor(model => model.BeneficiarID)
                @Html.HiddenFor(model=>model.BeneficiarDetailID)
                @Html.DropDownListFor(model => model.BankID, new SelectList(ViewBag.BasicBank, "BasicBankId", "BasicBankDescription"), Resources.PleaseSelect, new { data_lang_number="fa", @class = "form-control floating-label", placeholder = Resources.BasicBank })                        
                @Html.ValidationMessageFor(model => model.BankID, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">     
            <div class="col-md-10">
                @Html.EditorFor(model => model.Bank_AccountNumber, new { htmlAttributes = new { data_lang_number="fa", @class = "form-control floating-label", placeholder = Resources.BankAccountNumber } })
                @Html.ValidationMessageFor(model => model.Bank_AccountNumber, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">       
            <div class="col-md-10">
                @Html.EditorFor(model => model.Bank_BranchName, new { htmlAttributes = new { data_lang_number="fa", @class = "form-control floating-label", placeholder = Resources.BranchName } })
                @Html.ValidationMessageFor(model => model.Bank_BranchName, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">         
            <div class="col-md-10">
                @Html.EditorFor(model => model.Bank_ShebaNo, new { htmlAttributes = new { data_lang_number="fa", @class = "form-control floating-label", placeholder = Resources.Sheba } })
                @Html.ValidationMessageFor(model => model.Bank_ShebaNo, "", new { @class = "text-danger" })
            </div>
        </div>



        <div class="form-group">
            <div class="col-sm-12">
                <div class="text-right">
                    <button type="submit" class="btn btn-primary btn-sm">@Resources.Save</button>
                    <a class="btn btn-white btn-sm" data-dismiss='modal'><i class="zmdi zmdi-chevron-left zmdi-hc-lg"></i></a>
                </div>
            </div>
        </div>
    </div>
}


@Scripts.Render("~/bundles/jqueryval")
<script>
    $(function () {
        $.material.init();
    });
    $('#EditDetails').keypress(function (e) {

        if (e.which == 13) {

            var $targ = $(e.target);

            if (!$targ.is("textarea") && !$targ.is(":button,:submit")) {
                var focusNext = false;
                $(this).find(":input:visible:not([disabled],[readonly]), a").each(function () {
                    if (this === e.target) {
                        focusNext = true;
                    }
                    else if (focusNext) {
                        $(this).focus();
                        return false;
                    }
                });

                return false;
            }
        }

    });
</script>