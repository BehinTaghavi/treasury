@section PageHeader{
    @Resources.List @Resources.ExchangeRatesdDaily


        @Ajax.ActionLink(Resources.Create, "Create", "ExchangeRates", new { Area = "BasicInfo" }, new AjaxOptions
   {
       OnSuccess = "modal(data,'" + Resources.Create + " " + @Resources.ExchangeRatesdDaily + "', 'md')"
   }, new { @class = "btn btn-material-green-600 btn-sm" })

    
}
@section btnToolbar{
    <div class="mdc-bg-grey-50">
        <div class="btn-toolbar">
            <div class="clearfix">

                <div>
                    @using (Ajax.BeginForm("List", "ExchangeRates", new { Area = "BasicInfo" },
                        new AjaxOptions()
                        {
                            UpdateTargetId = "Result",
                            InsertionMode = InsertionMode.Replace,
                        }, null))
                    {
                        <div class="col-sm-4">
                            <div class="form-group">
                                @Html.DropDownList("ExchangeTypeID", null,"---", htmlAttributes: new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="pull-right">
                            <div class="col-sm-12">
                                <div class="text-left">
                                    <button type="submit" class="btn btn-info btn-sm">@Resources.Search</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
}
@section list{
    <div id="Result">
        @Html.Action("List", "ExchangeRates", new { Area = "BasicInfo" })
    </div>
}
<script type="text/javascript">
    function updateTable() {
        var url = '@(Url.Action("List", "ExchangeRates", new { area = "BasicInfo" }))';
        $.ajax({
            url: url, type: 'get',
            success: function (data, status) {
                $("#Result").html(data);
            }
        });

    }
</script>

