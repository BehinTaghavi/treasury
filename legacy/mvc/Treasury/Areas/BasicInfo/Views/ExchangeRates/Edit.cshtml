@model CSD.Treasury.DataModel.ExchangeRate

@{
    ViewBag.Title = "Edit";
}

@using (Ajax.BeginForm("Edit", "ExchangeRates", new AjaxOptions
{
    HttpMethod = "Post",
    OnSuccess = "successMessage(data);closeModal('md');updateTable();"
}, new { enctype = "multipart/form-data", id = "ExchangeTypeEdit" }))
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">

    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.ExchangeTypeID)

    @Html.HiddenFor(model => model.ExchangeDateRate)
    <div class="form-group">
        @Html.LabelFor(model => model.ExchangeTypeID, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DisplayFor(model => model.ExchangeType.ExchangeTypeDescription, new { htmlAttributes = new { @class = "form-control" } })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.ExchangeDateRate, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Utility.GetPersianDate(Model.ExchangeDateRate)
            @*@Html.DisplayFor(model => model.ExchangeDateRate, new { htmlAttributes = new { @class = "form-control" } })*@
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.FormalPrice, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.FormalPrice, new { htmlAttributes = new { @class = "form-control", @min = "0" } })
            @Html.ValidationMessageFor(model => model.FormalPrice, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.InformalPrice, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.InformalPrice, new { htmlAttributes = new { @class = "form-control", @min = "0" } })
            @Html.ValidationMessageFor(model => model.InformalPrice, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <button type="submit" class="btn btn-primary btn-sm">@Resources.Save</button>
        </div>
    </div>
</div>
}

@Scripts.Render("~/bundles/jqueryval")