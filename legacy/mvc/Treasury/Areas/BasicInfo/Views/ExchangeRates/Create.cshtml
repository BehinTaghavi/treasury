@model CSD.Treasury.DataModel.ExchangeRate
@using (Ajax.BeginForm("Create", "ExchangeRates", new AjaxOptions
{
    HttpMethod = "Post",
    OnSuccess = "successMessage(data);closeModal('md');updateTable();"

}, new { enctype = "multipart/form-data", @class = "form-horizontal", id = "ExchangeTypeCreate" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.ExchangeTypeID, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("ExchangeTypeID", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.ExchangeTypeID, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.ExchangeDateRate, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.TextBoxFor(model => model.ExchangeDateRate, new { data_lang_number = "fa", @class = "form-control from datepicker", @placeholder = Resources.DueDate, @readonly = "readonly" })
                @Html.ValidationMessageFor(model => model.ExchangeDateRate, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.FormalPrice, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.FormalPrice, new { htmlAttributes = new { @Value = 0, @class = "form-control", @min = "0" } })
                @Html.ValidationMessageFor(model => model.FormalPrice, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.InformalPrice, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.InformalPrice, new { htmlAttributes = new { @Value = 0, @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.InformalPrice, "", new { @class = "text-danger", @min = "0" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <button type="submit" class="btn btn-primary btn-sm">@Resources.Save</button>
            </div>
        </div>
    </div>
}
@Scripts.Render("~/bundles/jqueryval")
<script>
    $(".from.datepicker").datepicker({
        isRTL: true,
        dateFormat: "yy/mm/dd",

    });
</script>