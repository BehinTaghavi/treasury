@model CSD.Treasury.DataModel.Bank
@using System.Configuration

@using CSD.Treasury.Service.PermissiveSignaturesService
@{
    ViewBag.Title = "Create";
    var SignitureLs = (List<CSD.Treasury.Service.PermissiveSignaturesService.PermissiveSignature>)ViewBag.PermissiveSignatures;
}
@using (Ajax.BeginForm("Create", "Banks", new AjaxOptions
{
    HttpMethod = "Post",
    OnSuccess = "successMessage(data);updateTable();closeModal('lg:not(.xlg)');",

}, new { enctype = "multipart/form-data", @class = "form-horizontal", id = "BankCreate" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.BasicBankID)
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="alert alert-dismissible alert-material-grey-50">
            <div class="form-group">
                <div class="form-group">
                    <div class="col-md-4">
                        @Html.Label("Account_No", "معین وصول", new { data_lang_number = "fa", @class = "control-label" })
                        @*ConfigurationManager.AppSettings["Account_No"]*@
                        @Html.DropDownListFor(model => model.Account_No, new SelectList(ViewBag.v_accounts, "account_code", "Account_Name"), Resources.PleaseSelect, new { data_lang_number = "fa", @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Account_No)
                    </div>
                    <div class="col-md-4">
                        @Html.Label("Assign_Account_No", "معین واگذاری", new { data_lang_number = "fa", @class = "control-label" })
                        @*ConfigurationManager.AppSettings["Assign_Account_No"]*@
                        @Html.DropDownListFor(model => model.Assign_Account_No, new SelectList(ViewBag.v_accounts, "account_code", "Account_Name"), Resources.PleaseSelect, new { data_lang_number = "fa", @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Account_No)
                    </div>
                    <div class="col-md-4">
                        @Html.Label("Returns_Account_No", "معین برگشتی", new { data_lang_number = "fa", @class = "control-label" })
                        @*ConfigurationManager.AppSettings["Returns_Account_No"]*@
                        @Html.DropDownListFor(model => model.Returns_Account_No, new SelectList(ViewBag.v_accounts, "account_code", "Account_Name"), Resources.PleaseSelect, new { data_lang_number = "fa", @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Account_No)

                    </div>
                </div>

            </div>
            <div class="form-group Has_Unique_Account hidden">
                <div class="col-sm-5">
                    @Html.DropDownList("UniqueAccountType", new SelectList(ViewBag.unique_account_type, "Code", "Description"), string.Empty, new { data_lang_number = "fa", @class = "form-control floating-label UniqueAccountType", @placeholder = Resources.Type, data_bind = "Unique_Account_No", data_code_att = "Code", data_name_att = "Name", updatetargetid = "acc1" })
                </div>
                <div class="col-md-7">
                    @Html.DropDownListFor(model => model.Unique_Account_No, Enumerable.Empty<SelectListItem>(), new { required = "required", data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.Unique_Account_Code + "/" + Resources.Unique_Account_No })
                    @Html.ValidationMessageFor(model => model.Unique_Account_No)
                </div>
            </div>


            <div class="form-group Has_Unique_Account_Two hidden">
                <div class="col-sm-5">
                    @Html.DropDownList("UniqueAccountType2", new SelectList(ViewBag.unique_account_type, "Code", "Description"), string.Empty, new { data_lang_number = "fa", @class = "form-control floating-label UniqueAccountType", @placeholder = Resources.Type, data_bind = "Unique_Account_No_two", data_code_att = "Code2", data_name_att = "Name2", updatetargetid = "acc2" })
                </div>
                <div class="col-md-7">
                    @Html.DropDownListFor(model => model.Unique_Account_No_two, Enumerable.Empty<SelectListItem>(), new { required = "required", data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.Unique_Account_Code + "/" + Resources.Unique_Account_No })
                    @Html.ValidationMessageFor(model => model.Unique_Account_No_two)
                </div>
            </div>


        </div>
        <div class="form-group">
            <div class="col-md-4">
                @Html.EditorFor(model => model.Bank_AccountNumber, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.BankAccountNumber } })
                @Html.ValidationMessageFor(model => model.Bank_AccountNumber, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-4">
                @Html.TextBoxFor(model => model.OpeningDate, new { data_lang_number = "fa", @class = "form-control from floating-label datepicker", @placeholder = Resources.OpeningDate, @Readonly = "readonly" })
                @Html.ValidationMessageFor(model => model.OpeningDate, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-4">
                @Html.EditorFor(model => model.BranchCode, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.BranchCode } })
                @Html.ValidationMessageFor(model => model.BranchCode, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-4">
                @Html.EditorFor(model => model.BranchName, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.BranchName } })
                @Html.ValidationMessageFor(model => model.BranchName, "", new { @class = "text-danger" })
            </div>
            @if (ConfigurationManager.AppSettings["bilingual"] == "True")
            {
                <div class="col-md-4">
                    @Html.EditorFor(model => model.BranchName2, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.ENname } })
                    @Html.ValidationMessageFor(model => model.BranchName2, "", new { @class = "text-danger" })
                </div>
            }
        </div>

        <div class="form-group">
            <div class="col-sm-3">
                @Html.Label("provinceID", Resources.Province, new { data_lang_number = "fa", @class = "control-label" })
                @Html.DropDownList("provinceID", new SelectList(ViewBag.provinceLs, "provinceID", "ProvinceDescription"), Resources.PleaseSelect, new { data_lang_number = "fa", @class = "form-control" })
            </div>
            <div class="col-sm-3">
                @Html.Label("CityID", Resources.City, new { data_lang_number = "fa", @class = "control-label" })
                @Html.DropDownListFor(model => model.CityID, Enumerable.Empty<SelectListItem>(), Resources.PleaseSelect, new { data_lang_number = "fa", @class = "form-control" })
                @Html.ValidationMessageFor(model => model.CityID)
            </div>
            <div class="checkbox col-md-3">
                <label>
                    @Html.CheckBoxFor(model => model.Deposited)
                    @Resources.Deposited
                </label>
            </div>
        </div>
        <div class="form-group">
            <div class="checkbox col-md-3">
                <label for="IsActive">
                    @Html.CheckBoxFor(model => model.IsActive)
                    @Resources.IsActive
                </label>
            </div>
            <div class="checkbox col-md-3">
                <label>
                    @Html.CheckBoxFor(model => model.HasBackup)
                    @Resources.HasBackup
                </label>
            </div>

            <div class="checkbox col-md-3">
                <label>
                    @Html.CheckBoxFor(model => model.HasExchangeTransaction)
                    @Resources.HasExchangeTransaction

                </label>
            </div>
            <div class="checkbox col-md-3">
                <label>
                    @Html.CheckBoxFor(model => model.IS_Facilities)
                    @Resources.IS_Facilities
                </label>
            </div>
        </div>
        <div class="form-group hidden" id="backup">
            <div class="col-md-6">
                @Html.Label("Backup_BankID", Resources.Backup_Bank, new { data_lang_number = "fa", @class = "control-label" })
                @Html.DropDownListFor(model => model.Backup_BankID, new SelectList(ViewBag.BankLs, "BankID", "Bank_AccountNumber"), Resources.PleaseSelect, new { data_lang_number = "fa", @class = "form-control" })
                <span id="ValidationMessage"></span>

            </div>
        </div>
        <div class="form-group">
            <div class="col-md-6">
                @Html.LabelFor(model => model.OpeningValue, new { data_lang_number = "fa", @class = "control-label", id = "lableExchage" })
                @Html.TextBoxFor(model => model.OpeningValue, new { data_lang_number = "fa", @class = "form-control from floating-label", @placeholder = Resources.OpeningValue, type = "number", min = "0" })
                @Html.ValidationMessageFor(model => model.OpeningValue, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-12">
                <b id="OpeningValueText" class="mdc-text-green-700"></b>
            </div>
        </div>
        <div class="form-group hidden" id="exchange">
            <div class="col-md-3">
                @Html.Label("ExchangeTypeID", Resources.ExchangeType, new { data_lang_number = "fa", @class = "control-label" })
                @Html.DropDownListFor(d => d.ExchangeTypeID, new SelectList(ViewBag.ExchangeLs, "ExchangeTypeID", "ExchangeTypeDescription"), Resources.PleaseSelect, new { data_lang_number = "fa", @class = "form-control" })
            </div>
            <div class="col-md-3">
                @Html.Label("ExchangeRate", "نرخ ارز موجودی اول دوره", new { data_lang_number = "fa", @class = "control-label" })
                @Html.TextBoxFor(d => d.ExchangeRate, new { data_lang_number = "fa", @class = "form-control from floating-label", @placeholder = Resources.ExchangeRate, type = "number", min = "1", @Value = 1 })
            </div>
            <div class="col-md-3">
                @Html.Label("EquivalencePrice", "مبلغ هم ارز ریالی موجودی اول دوره", new { data_lang_number = "fa", @class = "control-label" })
                @Html.TextBoxFor(model => model.EquivalencePrice, new { data_lang_number = "fa", @class = "form-control", @readonly = "readonly" })

            </div>
            <div class="col-md-3">
                @Html.Label("ExchangeType", "نوع نرخ ارز", new { data_lang_number = "fa", @class = "control-label" })
                <select class="form-control" id="ExchangeType" name="ExchangeType">
                    <option value="null">----</option>
                    <option value="1">استاندارد</option>
                    <option value="2">رسمی</option>
                    <option value="3">غیررسمی</option>
                    <option value="4">واقعی</option>
                </select>
            </div>
        </div>



        <div class="form-group">
            <div class="col-md-6">
                @Html.Label("SortOrder", Resources.SortOrder, new { data_lang_number = "fa", @class = "control-label" })
                <select name="SortOrder" class="form-control">
                    <option value="1">@Resources.High</option>
                    <option value="2">@Resources.Normal</option>
                    <option value="3">@Resources.Low</option>
                </select>
                @Html.ValidationMessageFor(model => model.SortOrder, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-4">
                @Html.TextBoxFor(model => model.MinPermissiveSignatureCount, new { data_lang_number = "fa", @class = "form-control from floating-label datepicker", @placeholder = Resources.MinPermissiveSignatureCount, type = "number", min = "0" })
            </div>
            <div class="col-md-4">
                @Html.TextBoxFor(model => model.MaxPermissiveSignatureCount, new { data_lang_number = "fa", @class = "form-control from floating-label datepicker", @placeholder = Resources.MaxPermissiveSignatureCount, type = "number", min = "0" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-2">
                @Html.Label("Permission", "اسامی امضا کنندگان مجاز", new { data_lang_number = "fa", @class = "control-label" })
            </div>
            <div class="col-md-10">
                <select id="Permission" name="Permission" required multiple>
                    @foreach (var item in SignitureLs)
                    {
                        <option value="@item.PermissiveSignatureID">@Utility.GetUserName(item.UserID)</option>
                    }
                </select>
                @Html.ValidationMessage("Permission", "لطفااز منولیست کاربران،افرادی که مجاز به امضا هستند تعریف کرده و سپس ازلیست بالاانتخاب نمایید", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-12">
                <div class="text-right">
                    <button type="submit" class="btn btn-primary btn-sm">@Resources.Save</button>
                </div>
            </div>
        </div>
    </div>
}

@Scripts.Render("~/bundles/jqueryval")
<script src="@Url.Content("~/Scripts/wordifyfa.js")"></script>
<script type="text/javascript">
    var pageSize = 20;
    // رفع مشکل عدم امکان تایپ در سرچ Select2 درون مودال
    $.fn.modal.Constructor.prototype.enforceFocus = function () { };

    // تابع استاندارد برای راه‌اندازی هر دو فیلد حساب یکتا
    function initUniqueAccountSelect2(elementSelector, typeId) {
        $(elementSelector).select2({
            dir: "rtl",
            containerCssClass: "form-control",

            width: '100%',

            ajax: {
                url: "@Url.Action("UniqueAccountLs", "Banks", new { Area = "BasicInfo" })",
                dataType: 'json',
                delay: 250,
                data: function (params) {
                    params.page = params.page || 1;
                    return {
                        pageSize: pageSize,
                        page: params.page,
                        pageLimit: 10,
                        typeid: typeId,
                        q: params.term
                    };
                },
                processResults: function (data) {
                    console.log("اطلاعات خام سرور (" + elementSelector + "):", data);

                    var rawList = Array.isArray(data) ? data : (data.results || data.query || []);

                    var mappedData = $.map(rawList, function (item) {
                        return {
                            id: item.Account_Code || item.id || item.Id || item.Code,
                            text: item.Account_Name || item.text || item.Text || item.Name
                        };
                    });

                    console.log("اطلاعات نگاشت شده (" + elementSelector + "):", mappedData);

                    return {
                        results: mappedData
                    };
                },
                cache: true
            },
            escapeMarkup: function (markup) { return markup; },
            minimumInputLength: 1
        });
    }

    $("#provinceID,#Backup_BankID,#Account_No,#Assign_Account_No,#Returns_Account_No").select2({
        dir: "rtl",
        containerCssClass: "form-control"
    });

    $(function () {
        $.material.init();

        $("body").on("keyup", "#OpeningValue", function () {
            if ($(this).val() != undefined) {
                $("#OpeningValueText").text(wordifyfa($(this).val(), 0));
            }
        });
        $("body").on("change", "#OpeningValue", function () {
            if ($(this).val() != undefined) {
                $("#OpeningValueText").text(wordifyfa($(this).val(), 0));
            }
        });
        $("body").on("change", "#ExchangeTypeID", function () {
            if ($(this).val() != undefined) {
                $("#OpeningValueText").text(wordifyfa($("#OpeningValue").val(), 0));
            }
        });
        $("#Permission").select2({
            placeholder: "@Resources.PleaseSelect",
            tags: true,
            dir: "rtl",
            containerCssClass: "form-control",
            templateSelection: formatRepoSelection
        });
        function formatRepoSelection(repo) {
            return repo.full_name || repo.text;
        }
    });

    $('#OpeningValue').keypress(function (event) {
        return event.charCode >= 48 && event.charCode <= 57;
    });

    $('#HasBackup').click(function () {
        if ($('#HasBackup').is(':checked')) {
            $('#backup').removeClass("hidden");
            if ($('#Backup_BankID').val() == "") {
                $('#ValidationMessage').html("<span class='text-danger field-validation-error' data-valmsg-for='Backup_BankID' data-valmsg-replace='true'><span for='Backup_BankID' class=''>لطفا وارد نمایید</span></span>");
            }
        }
        else {
            $('#backup').addClass("hidden");
            $('#Backup_BankID').val("");
        }
    });

    $('#HasExchangeTransaction').click(function () {
        if ($('#HasExchangeTransaction').is(':checked')) {
            $('#lableExchage').text('موجودی اول دوره ارزی');
            $('#exchange').removeClass("hidden");
            if ($('#ExchangeTypeID').val() == "") {
                $('#ValidationMessage').html("<span class='text-danger field-validation-error' data-valmsg-for='ExchangeTypeID' data-valmsg-replace='true'><span for='ExchangeTypeID' class=''>لطفا وارد نمایید</span></span>");
            }
            if ($('#ExchangeType').val() == 0) {
                $('#ValidationMessage').html("<span class='text-danger field-validation-error' data-valmsg-for='ExchangeType' data-valmsg-replace='true'><span for='ExchangeType' class=''>لطفا وارد نمایید</span></span>");
            }
            if ($('#ExchangeRate').val() == "") {
                $('#ValidationMessage').html("<span class='text-danger field-validation-error' data-valmsg-for='ExchangeRate' data-valmsg-replace='true'><span for='ExchangeRate' class=''>لطفا وارد نمایید</span></span>");
            }
            if ($('#EquivalencePrice').val() == "") {
                $('#EquivalencePrice').html("<span class='text-danger field-validation-error' data-valmsg-for='EquivalencePrice' data-valmsg-replace='true'><span for='EquivalencePrice' class=''>لطفا وارد نمایید</span></span>");
            }
        }
        else {
            $('#lableExchage').text('موجودی اول دوره');
            $('#exchange').addClass("hidden");
            $('#ExchangeTypeID').val(1);
            $('#ExchangeType').val(1);
            $('#ExchangeRate').val(1);
        }
    });

    $("#OpeningDate").datepicker({
        dateFormat: "yy/mm/dd",
        changeMonth: true,
        changeYear: true,
        showButtonPanel: true
    });

    $("body").on("change", "#provinceID", function () {
        var address = "@(Url.Action("GetCityLS", "Banks", new { Area= "BasicInfo" }))";
        $("#CityID").load(address, { id: $(this).val() }, function (data) {
            $("#CityID").val($("#CityID option:first").val()).show();
        });
    });

   // $(document).ready(function () {
    //    if ($('#Account_No').val() == '@(ConfigurationManager.AppSettings["Account_No"])') {
    //        $('.Has_Unique_Account').removeClass('hidden');
    //    }

     //   $('#Unique_Account_No').val('');
      //  var defaultTypeId = '@(ConfigurationManager.AppSettings["unique_account_type"])';

        // راه‌اندازی اولیه کامپوننت‌ها
     //   initUniqueAccountSelect2("#Unique_Account_No", defaultTypeId);
    //    initUniqueAccountSelect2("#Unique_Account_No_two", defaultTypeId);
   // });*************************

    $(document).ready(function () {
    var defaultTypeId = '@(ConfigurationManager.AppSettings["unique_account_type"])';
    $('#Unique_Account_No').val('');

    if ($('#Account_No').val() == '@(ConfigurationManager.AppSettings["Account_No"])') {
        $('.Has_Unique_Account').removeClass('hidden');
        // راه‌اندازی اولیه فقط در صورتی که فیلد از حالت مخفی خارج شده باشد
        initUniqueAccountSelect2("#Unique_Account_No", defaultTypeId);
    }
});









    $("#UniqueAccountType").change(function () {
        $('#Unique_Account_No').val(null).trigger('change');
        var selectedType = $(this).val();
        initUniqueAccountSelect2("#Unique_Account_No", selectedType);
    });

    $("#UniqueAccountType2").change(function () {
        $('#Unique_Account_No_two').val(null).trigger('change');
        var selectedType = $(this).val();
        initUniqueAccountSelect2("#Unique_Account_No_two", selectedType);
    });

    @*$('#Account_No').change(function () {
        $('.Has_Unique_Account').addClass('hidden');
        $('.Has_Unique_Account_Two').addClass('hidden');
        $.ajax({
            type: 'GET',
            url: '@Url.Action("HasUniqueAccount", "Banks")',
            dataType: "json",
            data: { 'Account_Code': $(this).val() },
            success: function (Response) {
                if (Response.Has_Unique_Account == true) {
                    $('.Has_Unique_Account').removeClass('hidden');
                }
                else {
                    $('#Unique_Account_No').val(null).trigger('change');
                }
                if (Response.Has_Unique_Account_Two == true) {
                    $('.Has_Unique_Account_Two').removeClass('hidden');
                }
                else {
                    $('#Unique_Account_No_two').val(null).trigger('change');
                }
            },
        });
    });*@

    $('#Account_No').change(function () {
    $('.Has_Unique_Account').addClass('hidden');
    $('.Has_Unique_Account_Two').addClass('hidden');
    $.ajax({
        type: 'GET',
        url: '@Url.Action("HasUniqueAccount", "Banks")',
        dataType: "json",
        data: { 'Account_Code': $(this).val() },
        success: function (Response) {

            // نمایش و راه‌اندازی حساب یکتای اول
            if (Response.Has_Unique_Account == true) {
                $('.Has_Unique_Account').removeClass('hidden');

                // مقداردهی Select2 دقیقا بعد از اینکه اِلمان در صفحه ظاهر شد
                var typeId1 = $('#UniqueAccountType').val() || '@(ConfigurationManager.AppSettings["unique_account_type"])';
                initUniqueAccountSelect2("#Unique_Account_No", typeId1);
            }
            else {
                $('#Unique_Account_No').val(null).trigger('change');
            }

            // نمایش و راه‌اندازی حساب یکتای دوم
            if (Response.Has_Unique_Account_Two == true) {
                $('.Has_Unique_Account_Two').removeClass('hidden');

                // مقداردهی Select2 دقیقا بعد از اینکه اِلمان در صفحه ظاهر شد
                var typeId2 = $('#UniqueAccountType2').val() || '@(ConfigurationManager.AppSettings["unique_account_type"])';
                initUniqueAccountSelect2("#Unique_Account_No_two", typeId2);
            }
            else {
                $('#Unique_Account_No_two').val(null).trigger('change');
            }
        },
    });
});


    $('#BankCreate').keypress(function (e) {
        if (e.which == 13) {
            var $targ = $(e.target);
            if (!$targ.is("textarea") && !$targ.is(":button,:submit")) {
                var focusNext = false;
                $(this).find(":input:visible:not([disabled],[readonly]), a").each(function () {
                    if (this === e.target) {
                        focusNext = true;
                    }
                    else if (focusNext) {
                        $(this).focus();
                        return false;
                    }
                });
                return false;
            }
        }
    });

    $('#BankCreate').submit(function () {
        if ($('#HasBackup').is(':checked') && $('#Backup_BankID').val() == "") {
            $('#ValidationMessage').html("<span class='text-danger field-validation-error' data-valmsg-for='Backup_BankID' data-valmsg-replace='true'><span for='Backup_BankID' class=''>لطفا وارد نمایید</span></span>");
        }
    });

    $("body").on("keyup", "#OpeningValue", function () {
        if ($.isNumeric($(this).val())) {
            if ($.isNumeric($("#ExchangeRate").val())) {
                $("#EquivalencePrice").val((parseInt($("#OpeningValue").val())) * (parseInt($("#ExchangeRate").val())));
            }
        }
    });

    $("body").on("keyup", "#ExchangeRate", function () {
        if ($.isNumeric($(this).val())) {
            if ($.isNumeric($("#OpeningValue").val())) {
                $("#EquivalencePrice").val((parseInt($("#OpeningValue").val())) * (parseInt($("#ExchangeRate").val())));
            }
        }
    });
</script>
