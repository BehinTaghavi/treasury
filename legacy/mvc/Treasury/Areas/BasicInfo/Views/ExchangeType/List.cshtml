@model IEnumerable<CSD.Treasury.Service.ExchangeTypesService.ExchangeType>
@{
    var i = 1;
}
<table class="table table-striped sortable">
    <thead>
        <tr class="mdc-bg-grey-200">
            <th>#</th>
            <th>
                @Resources.ExchangeType
            </th>
            @*<th>
                @Resources.ExchangeType-@Resources.EN
            </th>*@
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            @*var related1 = Utility.HasRelation("ExchangeTypes", "ExchangeTypeID", item.ExchangeTypeID.ToString(), "Receipt_Detail", "ExchangeTypeID");*@
            var related2 = Utility.HasRelation("ExchangeTypes", "ExchangeTypeID", item.ExchangeTypeID.ToString(), "Banks", "ExchangeTypeID");
            var related3 = Utility.HasRelation("ExchangeTypes", "ExchangeTypeID", item.ExchangeTypeID.ToString(), "ExchangeStandard", "ExchangeTypeID");
        <tr>
            <td>
                @(i++)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ExchangeTypeDescription)
            </td>
            @*<td>
            @Html.DisplayFor(modelItem => item.ExchangeTypeDescription2)
        </td>*@
            <td>

                @if (related2 || related3)
                {
                    <button class="btn  btn-material-grey btn-xs " disabled title="@Resources.RelationsError">@Resources.Edit</button>
                    <button class="btn  btn-material-grey btn-xs delete " disabled title="@Resources.RelationsError">@Resources.Delete</button>
                }
                else
                {
                    @Ajax.ActionLink(Resources.Edit, "Edit", "ExchangeType", new { Area = "BasicInfo", id = item.ExchangeTypeID }, new AjaxOptions
               {
                   OnSuccess = "modal(data,'" + Resources.Edit + " " + Resources.ExchangeType + "', 'md');"
               }, new { @class = "btn btn-material-light-blue-A700 btn-xs" })
                    @Html.ActionLink(Resources.Delete, "Delete", "ExchangeType", new { Area = "BasicInfo", ExchangeTypeID = item.ExchangeTypeID }, new { @class = "btn btn-danger btn-xs delete" })
                }




            </td>
        </tr>
        }
    </tbody>
</table>

<script>


    var deleteBtn = document.getElementsByClassName("delete");

    for (var i = 0; i < deleteBtn.length; i++) {
        deleteBtn[i].addEventListener("click", deleteItem);
    }
    function deleteItem(e) {
        e.preventDefault();
        var item = this;
        alertify.confirm("", '@Resources.AreYouSure',
                   function () {
                       var xmlhttp = new XMLHttpRequest();
                       xmlhttp.onreadystatechange = function () {
                           if (xmlhttp.readyState == 4 && xmlhttp.status == 200) {
                               var data = JSON.parse(xmlhttp.responseText);
                               if (data.result == true) {
                                   item.deleteParentByTagName("tr", "danger", 1500, function () {
                                       alertify.success(data.Message);
                                   })
                               }
                               else {
                                   alertify.error(data.Message);
                               }
                           }
                       };
                       xmlhttp.open("POST", item.href, true);
                       xmlhttp.send();
                   },
  function () {
  }).set('labels', { ok: '@Resources.Yes', cancel: '@Resources.NO' }).set({ transition: 'zoom' }).set('modal', false);
    }
</script>

