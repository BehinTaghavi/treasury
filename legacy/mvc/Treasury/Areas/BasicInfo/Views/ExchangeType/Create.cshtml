@using System.Configuration;

@model CSD.Treasury.DataModel.ExchangeType

@using (Ajax.BeginForm("Create", "ExchangeType", new AjaxOptions
{
    HttpMethod = "Post",
    OnSuccess = "successMessage(data);closeModal('md');updateTable();"

}, new { enctype = "multipart/form-data", @class = "form-horizontal", id = "ExchangeTypeCreate" }))
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            <div class="row">
                <label class="control-label col-sm-4" for="AccountNo">نام ارز</label>
                <div class="col-md-8">
                    @Html.EditorFor(model => model.ExchangeTypeDescription, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = "نام ارز" } })
                    @Html.ValidationMessageFor(model => model.ExchangeTypeDescription, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        @*<div class="form-group">
            <div class="row">
                <label class="control-label col-sm-4" for="AccountNo">معین مراودات ارزی</label>
                <div class="col-md-8">
                    @Html.DropDownListFor(model => model.AccountNo, new SelectList(ViewBag.v_accounts, "account_code", "Account_Name", "-1"), new { data_lang_number = "fa", @class = "form-control", placeholder = "معین مراوادت ارزی" })
                    @Html.ValidationMessageFor(model => model.AccountNo)
                </div>
            </div>
        </div>*@

        @if (ConfigurationManager.AppSettings["bilingual"] == "True")
        {
            <div class="form-group">
                <div class="col-md-10">
                    @Html.EditorFor(model => model.ExchangeTypeDescription2, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.ExchangeType + "-" + Resources.EN } })
                    @Html.ValidationMessageFor(model => model.ExchangeTypeDescription2, "", new { @class = "text-danger" })
                </div>
            </div>
        }



        <div class="form-group">
            <div class="col-sm-12">
                <div class="text-right">
                    <button type="submit" class="btn btn-primary btn-sm">@Resources.Save</button>
                </div>
            </div>
        </div>
    </div>
}
@Scripts.Render("~/bundles/jqueryval")
<script type="text/javascript">
    $(function () {
        $.material.init();
    });
    $('#ExchangeTypeCreate').keypress(function (e) {

        if (e.which == 13) {

            var $targ = $(e.target);

            if (!$targ.is("textarea") && !$targ.is(":button,:submit")) {
                var focusNext = false;
                $(this).find(":input:visible:not([disabled],[readonly]), a").each(function () {
                    if (this === e.target) {
                        focusNext = true;
                    }
                    else if (focusNext) {
                        $(this).focus();
                        return false;
                    }
                });

                return false;
            }
        }

    });
</script>
