@{
    ViewBag.Title = Resources.ExchangeType;
}
@section PageHeader{
    @Resources.List @Resources.ExchangeType
}
@section btnToolbar{
    <div class="mdc-bg-grey-50">
        <div class="btn-toolbar">
            <div class="clearfix">
                <div class="pull-right">

                    @Ajax.ActionLink(Resources.Create, "Create", "ExchangeType", new { Area = "BasicInfo" }, new AjaxOptions
               {
                   OnSuccess = "modal(data,'" + @Resources.Create + " " + @Resources.ExchangeType + "', 'md')"
               }, new { @class = "btn btn-material-green-600 btn-sm" })

                </div>
            </div>

        </div>
    </div>
}
@section list{
    <div id="Result">
        @Html.Action("List", "ExchangeType", new { Area = "BasicInfo" })
    </div>
}

<script type="text/javascript">
    function updateTable() {
        var url = '@(Url.Action("List", "ExchangeType", new { area = "BasicInfo" }))';
        $.ajax({
            url: url, type: 'get',
            success: function (data, status) {
                $("#Result").html(data);
            }
        });

    }
</script>

