@model IEnumerable<CSD.Treasury.Service.CashiersService.Cashier>

<table class="table table-striped sortable">
    <thead>
        <tr class="mdc-bg-grey-200">
            <th>
                @Resources.Name
            </th>
            <th>
                @Resources.Unique_Account_No
            </th>
            <th>
                @Resources.account_code
            </th>
            <th>
               
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Utility.GetUserName(item.UserID)
                </td>
                <td>

                    @Utility.GetUniqueAccount(item.Unique_Account_No)

                </td>
                <td>
                    @Utility.Getaccounts(item.Account_no)
                </td>
                <td>
                    @Utility.GetCashdesk(item.CashDeskID)
                </td>
                <td>

                    @Ajax.ActionLink(Resources.Edit, "Edit", "Cashier", new { Area = "BasicInfo", id = item.CashierID }, new AjaxOptions
                   {
                       OnSuccess = "modal(data,'" + Resources.Edit + " " + Resources.Cashier + "', 'md');"
                   }, new { @class = "btn btn-success btn-xs" })


                    @Html.ActionLink(Resources.Delete, "Delete", "Cashier", new { Area = "BasicInfo", id = item.CashierID }, new { @class = "btn btn-danger btn-xs delete" })


                    @Ajax.ActionLink(Resources.Details, "Details", "Cashier", new { Area = "BasicInfo", id = item.CashierID }, new AjaxOptions
               {
                   OnSuccess = "modal(data,'" + Resources.Details + " " + Resources.Cashier + "', 'md');"
               }, new { @class = "btn btn-success btn-xs" })
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    //$(document).ready(function () {
    //    $(function () {
    //        $("#myTable").tablesorter();
    //    });
    //});

    var deleteBtn = document.getElementsByClassName("delete");
    for (var i = 0; i < deleteBtn.length; i++) {
        deleteBtn[i].addEventListener("click", deleteItem);
    }
    function deleteItem(e) {
        e.preventDefault();
        var item = this;
        alertify.confirm("", '@Resources.AreYouSure',
                   function () {
                       var xmlhttp = new XMLHttpRequest();
                       xmlhttp.onreadystatechange = function () {
                           if (xmlhttp.readyState == 4 && xmlhttp.status == 200) {
                               var data = JSON.parse(xmlhttp.responseText);
                               if (data.result == true) {
                                   item.deleteParentByTagName("tr", "danger", 1500, function () {
                                       alertify.success(data.Message);
                                   })
                               }
                               else {
                                   alertify.error(data.Message);
                               }
                           }
                       };
                       xmlhttp.open("POST", item.href, true);
                       xmlhttp.send();
                   },
  function () {
  }).set('labels', { ok: '@Resources.Yes', cancel: '@Resources.NO' }).set({ transition: 'zoom' }).set('modal', false);
    }
</script>

