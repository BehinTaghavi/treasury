@model CSD.Treasury.Service.CashiersService.Cashier
@{
    ViewBag.Title = "Edit";
}

@using (Ajax.BeginForm("Edit", "Cashier", new AjaxOptions
{
    HttpMethod = "Post",
    OnSuccess = "successMessage(data);closeModal('md');updateTable();"
}, new { enctype = "multipart/form-data", id = "CashierEdit" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="clearfix">
            <div class="col-sm-3">
                <div class="form-group">
                    <div class="col-xs-12">
                        @Html.DropDownList("UniqueAccountType", new SelectList(ViewBag.unique_account_type, "Code", "Description", ViewBag.uniqueTypeId), string.Empty, new { data_lang_number = "fa", @class = "form-control floating-label UniqueAccountType", @placeholder = Resources.Type, data_bind = "Unique_Account_No", data_code_att = "Code", data_name_att = "Name", updatetargetid = "UniqueAccountList" })
                    </div>
                </div>
            </div>
            <div class="col-sm-9">
                <div class="form-group">

                    
                    @Html.DropDownListFor(model => model.Unique_Account_No, new SelectList(ViewBag.SlectedLs, "Account_Code", "Account_Name", new { Type_Code = Model.Unique_Account_No }), new { required = "required", data_lang_number = "fa", @class = "form-control floating-label js-data-example-ajax", placeholder = Resources.Unique_Account_Code + "/" + Resources.Unique_Account_No })
                    @Html.ValidationMessageFor(model => model.Unique_Account_No)
                    @*@Html.Hidden("Unique_Account_No", (string)ViewBag.uniqueAccount_Code)
        <div class="dropdown keep-open lookup">
            <div class="clearfix">
                <div class="col-xs-4">
                    <input type="text" value="@ViewBag.uniqueAccount_Code" lookup data-action="UniqueAccount" data-related="Name" placeholder="@Resources.Unique_Account_Code" name="Code" id="Code" data-toggle="dropdown" class="form-control dropdown-toggle floating-label" aria-expanded="true">
                </div>
                <div class="col-xs-8">
                    <input type="text" value="@ViewBag.uniqueAccount_Name" lookup data-action="UniqueAccount" data-related="Code" placeholder="@Resources.Unique_Account_No" name="Name" id="Name" data-toggle="dropdown" class="form-control dropdown-toggle floating-label" aria-expanded="true">
                </div>
            </div>
            <ul class="dropdown-menu" style="width: 100%">
                <li class="UniqueAccountList" id="UniqueAccountList">
                    @Html.Action("UniqueAccount", "Request", new { Area = "Payment" })
                </li>
            </ul>
        </div>
        @Html.ValidationMessageFor(model => model.Unique_Account_No)*@
                </div>
            </div>
        </div>

        @Html.HiddenFor(model => model.CashierID)
        <div class="clearfix">
            <div class="col-sm-9">
                <div class="form-group">
                    @Html.Hidden("InitialAccount_no", Model.Account_no)
                    @Html.DropDownListFor(model => model.Account_no, new SelectList(ViewBag.v_accounts, "account_code", "Account_Name", Model.Account_no), " ", new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.account_code })
                    @Html.ValidationMessageFor(model => model.Account_no)
                </div>
            </div>
            <div class="col-sm-6">
                <div class="form-group">
                    @Html.DropDownListFor(model => model.UserID, new SelectList(ViewBag.UserLS, "UserID", "User_FullName", Model.UserID), " ", new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.Users })
                    @Html.ValidationMessageFor(model => model.UserID)
                </div>
            </div>
        </div>
        <div class="clearfix">
            <div class="col-sm-9">
                @Html.DropDownListFor(model => model.CashDeskID, new SelectList(ViewBag.CashdeskLsLS, "CashDeskID", "CashDeskDescription", Model.CashDeskID), " ", new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.CashdeskDescription })
                @Html.ValidationMessageFor(model => model.CashDeskID)
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-12">
                <div class="text-right">
                    <button type="submit" class="btn btn-primary btn-sm">@Resources.Save</button>
                </div>
            </div>
        </div>
    </div>
}

@Scripts.Render("~/bundles/jqueryval")
<script>

    $(function () {
        $.material.init();
        $("#Account_no").select2({
            tags: true,
            dir: "rtl",
            containerCssClass: "form-control"
        });
    });
    var pageSize = 20;
    $("#UniqueAccountType").change(function () {
        $('#Unique_Account_No').val('');
        var typeid = $(this).val();
        $("#Unique_Account_No").select2({
            dir: "rtl",
            containerCssClass: "form-control",
            ajax: {
                url: "/Payment/Request/UniqueAccountLs",
                dataType: 'json',
                delay: 250,

                data: function (params) {
                    params.page = params.page || 1;
                    return {
                        pageSize: pageSize,
                        page: params.page,
                        pageLimit: 10,
                        typeid: typeid,
                        q: params.term, // search term
                    };
                },
                processResults: function (data, params) {

                    params.page = params.page || 1;
                    return {
                        results: data.query,
                        pagination: {
                            more: (params.page * pageSize < data.total_count)
                        }
                    };
                },

                cache: true
            },
            escapeMarkup: function (markup) { return markup; }, // let our custom formatter work
            minimumInputLength: 1,
            //templateResult: formatRepo, // omitted for brevity, see the source of this page
            //templateSelection: formatRepoSelection // omitted for brevity, see the source of this page
        });
    });
    $('#CashierEdit').keypress(function (e) {

        if (e.which == 13) {

            var $targ = $(e.target);

            if (!$targ.is("textarea") && !$targ.is(":button,:submit")) {
                var focusNext = false;
                $(this).find(":input:visible:not([disabled],[readonly]), a").each(function () {
                    if (this === e.target) {
                        focusNext = true;
                    }
                    else if (focusNext) {
                        $(this).focus();
                        return false;
                    }
                });

                return false;
            }
        }

    });
    @*$("body").on("change", "#UniqueAccountType", function () {
        var _this = $(this);
        var address = "@(Url.Action("UniqueAccount", "Request", new { Area= "Payment" }))";
        if (_this.val() != 0) {
            $("#UniqueAccountList").load(address, { UniqueAccountTypeId: _this.val(), Bind: _this.attr("data-bind"), CodeField: _this.attr("data-code-att"), NameField: _this.attr("data-name-att"), UpdateTargetId: _this.attr("updatetargetid") });
        }
        else {
            $("#UniqueAccountList").load(address, { UniqueAccountTypeId: 0, Bind: $(this).attr("data-bind"), CodeField: $(this).attr("data-code-att"), NameField: $(this).attr("data-name-att"), UpdateTargetId: $(this).attr("updatetargetid") });
        }
    });
    var formData = new FormData(document.getElementsByTagName("form")[0]);
    var lookup = document.querySelectorAll("[lookup]");
    for (var i = 0; i < lookup.length; i++) {
        lookup[i].onkeyup = function () {
            var xmlhttp = new XMLHttpRequest();
            xmlhttp.onreadystatechange = function () {
                if (xmlhttp.readyState == 4 && xmlhttp.status == 200) {
                    document.getElementById("UniqueAccountList").innerHTML = xmlhttp.responseText;
                }
            }
            var type = document.getElementById("UniqueAccountType");
            var address = "/Payment/Request/" + this.getAttribute("data-action") + "?UniqueAccountTypeId=" + type.value + "&Bind=" + type.getAttribute("data-bind") +
                ((this.value != "") ? "&" + this.getAttribute("Name") + "=" + ((this.value != "") ? this.value : "") : "") +
                ((document.getElementById(this.getAttribute("data-related")).value != "") ? "&" + this.getAttribute("data-related") + "=" + ((document.getElementById(this.getAttribute("data-related")).value != "") ? document.getElementById(this.getAttribute("data-related")).value : " ") : "");
            xmlhttp.open("GET",
                address
                , true);
            xmlhttp.send();
        }
    }
    function getLookupDataItem(e) {
        console.log(e);
        document.getElementById(e.getAttribute("data-bind")).value = e.getAttribute("data-content").trim();
        for (var j = 0; j < e.querySelectorAll("[data-target]").length; j++) {
            var elm = document.getElementById(e.querySelectorAll("[data-target]")[j].getAttribute("data-target"));;
            elm.value = e.querySelectorAll("[data-target]")[j].innerHTML; elm.classList.remove("empty");;
        }
    }
    $('.dropdown.keep-open').on({
        "click": function () { this.classList.add("open"); this.closable = true; },
        "hide.bs.dropdown": function () { this.classList.remove("open"); return this.closable; }
    });*@
</script>
