<script type="text/javascript">
    function updateTable(BankId) {
        var url = '@(Url.Action("List", "ChequeFormatType", new { area = "BasicInfo" }))';
        $.ajax({
            url: url, type: 'get',
            data: { BankId: BankId },
            success: function (data, status) {
                $("#Result").html(data);
            }
        });
    }
</script>

