@using CSD.Treasury.UI.Models
@{
    int i = 0;
    List<CSD.Treasury.Service.BasicBanksService.BasicBank> BankLs= (List<CSD.Treasury.Service.BasicBanksService.BasicBank>) ViewBag.BankList;
}

    @foreach (var item in BankLs)
    {
        i = i + 1;
        <div class="panel-group" id="accordion">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h4 class="panel-title clearfix">
                        <a data-toggle="collapse" data-parent="#accordion" href="#collapse@(i)">↴ @Utility.GetBasicBankInfo(item.BasicBankId)</a>                       
                        <a class="pull-left" data-ajax="true" data-ajax-success="modal(data,'@(Resources.Create + " " + Resources.ChequeFormatType +" " + @Resources.Bank+ " " +Utility.GetBasicBankInfo(item.BasicBankId))', 'md')" href="@Url.Action("Create", "ChequeFormatType", new { Area = "BasicInfo" ,BankId=item.BasicBankId})">+ @(Resources.Create + " " + Resources.ChequeFormatType )</a>
                        @*@Ajax.ActionLink(Resources.Create + " " + Resources.ChequeFormatType, "Create", "ChequeFormatType", new { Area = "BasicInfo",BankId=item.BasicBankId}, new AjaxOptions
                         {
                             OnSuccess = "modal(data,'" + @Resources.Create + " " + @Resources.ChequeFormatType + "', 'md')"
                         }, new { data_lang_number="fa", @class = "pull-left" })*@
                    </h4>
                </div>
                <div id="collapse@(i)" class="panel-collapse collapse ">
                    <div class="panel-body">
                        
                            @Html.Action("GetChequeTypeByBankId", "ChequeFormatType", new { area = "BasicInfo", BankId = item.BasicBankId })
                        
                      
                    </div>
                </div>
            </div>

        </div>
    }

