            <div class="col-md-10">
                @Html.DropDownListFor(model => model.BankID, new SelectList(ViewBag.BsicBankLSLs, "BasicBankId", "BasicBankDescription",Model.BankID), " ", new { data_lang_number="fa", @class = "form-control floating-label", @placeholder = Resources.Bank })
                @Html.ValidationMessageFor(model => model.BankID)
            </div>
        </div>*@
        @*@if (CSD.Treasury.UI.Models.Utility.CheckIfHasFile(Model.ChequeFormatID))
        {
            <div class="form-group">
                <div class="col-md-10">
                    فایل ضمیمه:   @Html.ActionLink(Model.ChequeFormatID.ToString(), "GetContentAttachedFile", "Attachment", new { Area = "Payment", relateID = Model.ChequeFormatID }, new { target = "_blank" })
                </div>
            </div>
        }*@
      

        <div class="form-group">
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.FormatDescriptionID_Main, new SelectList(ViewBag.GetChequeFormatTypeLs, "ChequeFormatType_DescriptionID", "ChequeFormatType_Description1", new { Model.FormatDescriptionID_Main }), Resources.PleaseSelect, new { data_lang_number="fa", @class = "form-control floating-label", @placeholder = Resources.Type })
                @Html.ValidationMessageFor(model => model.FormatDescriptionID_Main, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
