@{
    var tableId = Guid.NewGuid().ToString("N");
}
@section PageHeader{
    @Resources.List @Resources.Branch @Resources.Company @System.Configuration.ConfigurationManager.AppSettings["CompanyName"]
}
@section btnToolbar{
    <div class="mdc-bg-grey-50">
        <div class="btn-toolbar">
            <div class="clearfix">
                <div class="pull-right">
                    @Ajax.ActionLink(Resources.Create, "Create", "Branch", new { Area = "BasicInfo" }, new AjaxOptions
               {
                   OnSuccess = "modal(data,'" + @Resources.Create + " " + @Resources.Branch + "', 'md')"
               }, new { @class = "btn btn-material-green-600 btn-sm" })
                </div>
            </div>
        </div>
    </div>
}

@section list{
<div id="branchList" ls-action="@(Url.Action("List", "Branch", new { area = "BasicInfo" }))">
    @Html.Action("List", "Branch", new { Area = "BasicInfo", Model })
</div>
}

<script>
    function updateTable(listId) {
        var url = document.getElementById(listId).getAttribute("ls-action");
        $.ajax({
            url: url, type: 'get',
            success: function (data, status) {
                $("#" + listId).html(data);
            }
        });
    }
</script>

