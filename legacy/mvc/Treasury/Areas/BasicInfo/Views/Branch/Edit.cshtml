@model CSD.Treasury.DataModel.cmpBranch
@{
    ViewBag.Title = "Edit";
}
@using (Ajax.BeginForm("Edit", "Branch", new AjaxOptions
{
    HttpMethod = "Post",
    OnSuccess = "successMessage(data);closeModal('md');updateTable('branchList');"
}, new { enctype = "multipart/form-data", @class = "form-horizontal",id= "BranchEdit" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.cmpBranchID)
<div class="form-horizontal">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">
        <div class="col-md-10">
            @Html.Hidden("InitialcmpBranchName", Model.cmpBranchName)
            @Html.TextBoxFor(model => model.cmpBranchName, new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.BranchName })
            @Html.ValidationMessageFor(model => model.cmpBranchName, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-10">
            @Html.TextBoxFor(model => model.cmpBranchName2, new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.BranchName + "-" + Resources.EN })
            @Html.ValidationMessageFor(model => model.cmpBranchName2, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-10">
            @Html.TextAreaFor(model => model.cmpBranchAddress, new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.BranchAddress })
            @Html.ValidationMessageFor(model => model.cmpBranchAddress, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-10">
            @Html.TextAreaFor(model => model.cmpBranchAddress2, new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.BranchAddress + " " + Resources.EN })
            @Html.ValidationMessageFor(model => model.cmpBranchAddress2, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-10">
            @Html.CheckBoxFor(model => model.IsMainBranch, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.EN } })
            @Html.ValidationMessageFor(model => model.IsMainBranch, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.CityID, new SelectList(ViewBag.City, "CityID", "CityDescription"), new { data_lang_number = "fa", @class = "form-control" })
            @Html.ValidationMessageFor(model => model.CityID, "", new { @class = "text-danger" })
        </div>
    </div>
    @Html.HiddenFor(model => model.cmpBranchID)

    <div class="form-group">
        <div class="col-sm-12">
            <div class="text-right">
                <button type="submit" class="btn btn-primary btn-sm">@Resources.Save</button>
            </div>
        </div>
    </div>
</div>
}
@Scripts.Render("~/bundles/jqueryval")
<script>
    $(function () {
        $.material.init();
    });
    $('#BranchEdit').keypress(function (e) {

        if (e.which == 13) {

            var $targ = $(e.target);

            if (!$targ.is("textarea") && !$targ.is(":button,:submit")) {
                var focusNext = false;
                $(this).find(":input:visible:not([disabled],[readonly]), a").each(function () {
                    if (this === e.target) {
                        focusNext = true;
                    }
                    else if (focusNext) {
                        $(this).focus();
                        return false;
                    }
                });

                return false;
            }
        }

    });
</script>