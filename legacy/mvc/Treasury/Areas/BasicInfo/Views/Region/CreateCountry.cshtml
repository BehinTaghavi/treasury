@model CSD.Treasury.Service.CountryService.Country
@{
    ViewBag.Title = "Create";
}

@using (Ajax.BeginForm("CreateCountry", "Region", new AjaxOptions
{
    HttpMethod = "Post",
    OnSuccess = "successMessage(data);closeModal('sm');updateTable();"
}, new { enctype = "multipart/form-data", @class = "form-horizontal",id= "CreateCountry" }))
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">         
            <div class="col-md-10">
                @Html.EditorFor(model => model.CountryDescription, new { htmlAttributes = new { data_lang_number="fa", @class = "form-control floating-label", placeholder = Resources.Name } })
                @Html.ValidationMessageFor(model => model.CountryDescription, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">          
            <div class="col-md-10">
                @Html.EditorFor(model => model.CountryDescription2, new { htmlAttributes = new { data_lang_number="fa", @class = "form-control floating-label", placeholder = Resources.ENname } })
                @Html.ValidationMessageFor(model => model.CountryDescription2, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-sm-12">
                <div class="text-right">
                    <button type="submit" class="btn btn-primary btn-sm">@Resources.Save</button>
                </div>
            </div>
        </div>
    </div>
}

@Scripts.Render("~/bundles/jqueryval")
<script>
        $(function () {
            $.material.init();
        });
        $('#CreateCountry').keypress(function (e) {

            if (e.which == 13) {

                var $targ = $(e.target);

                if (!$targ.is("textarea") && !$targ.is(":button,:submit")) {
                    var focusNext = false;
                    $(this).find(":input:visible:not([disabled],[readonly]), a").each(function () {
                        if (this === e.target) {
                            focusNext = true;
                        }
                        else if (focusNext) {
                            $(this).focus();
                            return false;
                        }
                    });

                    return false;
                }
            }

        });
</script>
