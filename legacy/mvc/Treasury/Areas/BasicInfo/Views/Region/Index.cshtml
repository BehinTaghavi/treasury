@{
    ViewBag.Title = Resources.Region;
}
@section PageHeader{
    @Resources.List @Resources.Region
}
@section btnToolbar{
    <div class="mdc-bg-grey-50">
        <div class="btn-toolbar">
            <div class="clearfix">
                <div class="pull-right">
                    @Ajax.ActionLink(Resources.Create, "CreateCountry", "Region", new { Area = "BasicInfo" }, new AjaxOptions
               {
                   OnSuccess = "modal(data,'" + Resources.Create + " " + Resources.Country + "', 'sm');"
               }, new { @class = "btn btn-material-green-600 btn-sm" })
                </div>
            </div>
        </div>
    </div>

}
@section list{
    <div id="Result">
        @Html.Action("ListCountry", "Region", new { Area = "BasicInfo" })
    </div>
}


<script type="text/javascript">
    function updateTable() {
        var url = '@(Url.Action("ListCountry", "Region", new { area = "BasicInfo" }))';
        $.ajax({
            url: url, type: 'get',
            success: function (data, status) {
                $("#Result").html(data);
            }
        });
    }
</script>



