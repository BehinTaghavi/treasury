@model IEnumerable<CSD.Treasury.Service.CountryService.Country>

<table class="table table-striped sortable">
    <thead>
        <tr>
            <th>
                @Resources.Name@Resources.Country
            </th>
            <th>
                @Resources.Name@Resources.Country-@Resources.EN
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var related1 = Utility.HasRelation("Country", "CountryID", item.CountryID.ToString(), "Province", "CountryID");
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.CountryDescription)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CountryDescription2)
                </td>
                <td>

                    @Ajax.ActionLink(Resources.Edit, "EditCountry", "Region", new { Area = "BasicInfo", id = item.CountryID }, new AjaxOptions
               {
                   OnSuccess = "modal(data,'" + Resources.Edit + " " + Resources.Country + "', 'sm');modal('hide');updateTable();"
               }, new { @class = "btn btn-success btn-xs" })
                    @if (related1)
                    {
                        <button class="btn  btn-material-grey btn-xs delete " disabled title="@Resources.RelationsError">@Resources.Delete</button>
                    }
                    else
                    {
                        @Html.ActionLink(Resources.Delete, "DeleteCountry", "Region", new { Area = "BasicInfo", CountryID = item.CountryID }, new { @class = "btn btn-danger btn-xs delete" })
                    }


                    @Ajax.ActionLink(Resources.Province, "Listprovince", "Region", new { Area = "BasicInfo", CountryID = item.CountryID }, new AjaxOptions
               {
                   OnSuccess = "modal(data,'" + Resources.Province + "', 'md')"
               }, new { @class = "btn btn-material-grey btn-xs" })
                </td>
            </tr>
        }
    </tbody>
</table>
@section scripts{
    <script>
        $(document).ready(function () {
            $(function () {
                $("#myTable").tablesorter();
            });
        });
    </script>
}
<script>
    var deleteBtn = document.getElementsByClassName("delete");

    for (var i = 0; i < deleteBtn.length; i++) {
        deleteBtn[i].addEventListener("click", deleteItem);
    }
    function deleteItem(e) {
        e.preventDefault();
        var item = this;
        alertify.confirm("", '@Resources.AreYouSure',
                   function () {
                       var xmlhttp = new XMLHttpRequest();
                       xmlhttp.onreadystatechange = function () {
                           if (xmlhttp.readyState == 4 && xmlhttp.status == 200) {
                               var data = JSON.parse(xmlhttp.responseText);
                               if (data.result == true) {
                                   item.deleteParentByTagName("tr", "danger", 1500, function () {
                                       alertify.success(data.Message);
                                   })
                               }
                               else {
                                   alertify.error(data.Message);
                               }
                           }
                       };
                       xmlhttp.open("POST", item.href, true);
                       xmlhttp.send();
                   },
  function () {
  }).set('labels', { ok: '@Resources.Yes', cancel: '@Resources.NO' }).set({ transition: 'zoom' }).set('modal', false);
    }

</script>

