                        str += "<option value='" + result[i].BankID + "'>" + result[i].Bank_AccountNumber + " - " + result[i].BranchName + "</option>"
                    }
                    $("#BankId").html("<option>انتخاب شعبه</option>" + str);
                }
            })
        });





    })*@

</script>

