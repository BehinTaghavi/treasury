@model CSD.Treasury.UI.Areas.Report.Models.GardeshHesabSearchModel
@using CSD.Treasury.Resourse
@section PageHeader{
    گزارش سپرده بانکی
}
@{
    ViewBag.Title = "SearchView";
}
@using (Ajax.BeginForm("List", "Naghdinegi", new { Area = "Report" },
                                                    new AjaxOptions()
                                                    {
                                                        UpdateTargetId = "Result",
                                                        InsertionMode = InsertionMode.Replace,
                                                    }, new { id = "SearchForm" }))
{
    @*@using (Html.BeginForm("List", "Naghdinegi", new { Area = "Report" }, FormMethod.Get, new { id = "SearchForm" }))
        {*@
    @*@Html.HiddenFor(d=>d.Seporde,new { @value = true })*@
    <input type="hidden" id="custId" name="Seporde" value=true>
    <div class="clearfix">
        <div class="col-sm-3">
            <div class="form-group">
                @Html.TextBoxFor(d => d.FromDate, null, new { data_lang_number = "fa", @class = "form-control until floating-label datepicker", @placeholder = Resources.From + " " + Resources.Date, @readonly = "readonly", @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.FromDate)
            </div>
        </div>
        <div class="col-sm-8">
            <div class="form-group" id="ShowDate">

            </div>
        </div>
        @*<div class="col-sm-3">
            <div class="form-group">
                @Html.TextBoxFor(d => d.ToDate, null, new { data_lang_number = "fa", @class = "form-control until floating-label datepicker", @placeholder = Resources.To + " " + Resources.Date, @readonly = "readonly", @autocomplete = "off" })
                @Html.ValidationMessageFor(model => model.ToDate)
            </div>
        </div>*@
    </div>
    <div class="clearfix">
        <div class="col-sm-12">
            <div class="text-left">
                <button id="report" type="submit" class="btn btn-info btn-sm">@Resources.Report</button>
            </div>
        </div>
    </div>
}
<div id="Result"></div>
<script>

    $(document).ready(function () {
        $('.js-example-basic-multiple').select2({
            dir: "rtl",
            containerCssClass: "form-control",
        });
    });

    $(".until.datepicker").datepicker({
        isRTL: true,
        dateFormat: "yy/mm/dd",
        // maxDate: new Date()
    });
    $("#FromDate").change(
        function () {
            var address = "@(Url.Action("GetDates", "ExpiredCheckPayable", new { Area = "Report" }))";
            $("#ShowDate").load(address, { Date: $('#FromDate').val() }, function (data) {

            });
        }
    );
</script>

