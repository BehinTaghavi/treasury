@model CSD.Treasury.UI.Models.SearchModelExpiredCheque
@using  CSD.Treasury.Resourse
@section PageHeader{
 گزارش اسناد پرداختنی /تعهدات پرداختنی
}
@section btnToolbar{

    @using (Ajax.BeginForm("ShowALLExpired", "ExpiredCheckPayable", new { Area = "Report" },
                                                        new AjaxOptions()
                                                        {
                                                            UpdateTargetId = "Result",
                                                            InsertionMode = InsertionMode.Replace,
                                                        }, new { id = "SearchForm" }))
    {

        <div class="mdc-bg-grey-50">
            <div class="btn-toolbar">
                <div class="clearfix">
                    <div class="pull-right">
                        <a class="btn btn-default btn-sm" id="search" data-poload="@Url.Action("Search", "ExpiredCheckPayable", new { area = "Report" })">
                            <i class="zmdi zmdi-search zmdi-hc-lg"></i>&nbsp;&nbsp;&nbsp;&nbsp;@Resources.SearchForm
                        </a> <button id="report" type="button" class="btn btn-info btn-sm" onclick="$('.modal.default').modal('hide')">@Resources.Report</button>
                    </div>
                    <div class="pull-right">
                        <div id="progroup" data-has-content="empty"></div>
                    </div>
                </div>
            </div>
        </div>
    }
    }

    @section list{
        <div id="Result">
            @Html.Action("ShowALLExpired", "ExpiredCheckPayable", new { Area = "Report", Model })
        </div>
    }<script>
    function updateTable() {
        var url = '@(Url.Action("ListChecksIssued", "Payment", new { area = "Report"  }))';
        $.ajax({
            url: url, type: 'get',
            success: function (data, status) {
                $("#Result").html(data);
            }
        });
    }

    document.getElementById("search").addEventListener("click", showSearchPanel);
    function showSearchPanel() {
        var e = this;
        $.get(this.getAttribute("data-poload"), function (d) {
            $("#modal-content").html(d);
            //$('.modal.default').modal('show');
            //modal(data, '" + Resources.Show + " " + Resources.RequestPayment + "', 'md');
            modal(d, '@Resources.Search', 'md');
        });
        }
          $(function () {  
        $('body').on("click", "#report", function () {
            var data = $('#SearchForm').serializeArray();
            var xhttp = new XMLHttpRequest();
            xhttp.onreadystatechange = function () {
                if (xhttp.readyState == 4 && xhttp.status == 200) {
                    document.open();
                    document.write(xhttp.responseText);
                    document.close();
                }
            };
            xhttp.open("POST", "@Url.Action("ExpiredCheckPayableReport", "ExpiredCheckPayable", new { Area = "Report" })", true);
            xhttp.send(new FormData(document.querySelector("#SearchForm")));
         
        })
    });
</script>