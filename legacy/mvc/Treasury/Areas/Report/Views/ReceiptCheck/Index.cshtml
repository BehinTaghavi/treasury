@using CSD.Treasury.Resourse
@model CSD.Treasury.UI.Models.ReceiptSearch
@{
    ViewBag.Title = "Index";
}
@section PageHeader{
    @if (Model.isCheck)
    {
        @(Resources.Report + " " + Resources.ReceiptCheck)
    }
    else
    {
        @( Resources.Report + " " + Resources.Others + " " + Resources.Receive + "ها")
    }

}
