                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-4" style="@(Model.isCheck?"display:block":"display:none")">

                                <div style="padding: 8px 0;">
                                    <div class="clearfix">
                                        <div class="col-xs-4">
                                            <label for="DueDateTo" class="control-label">@Resources.Date  @Resources.Receive @Resources.To</label>
                                        </div>
                                        <div class="col-xs-8">
                                            @Html.TextBoxFor(model => model.RecieptDateTo, new { data_lang_number = "fa", @class = "form-control from datepicker", @placeholder = @Resources.Date + " " + Resources.Receive })
                                        </div>
                                    </div>
                                </div>
