
@using CSD.Treasury.UI.Models;
@using CSD.Treasury.Resourse
@section PageHeader{
   گزارش وضعیت اسناد دریافتنی
}
@using (Html.BeginForm("Index", "ExpiredCheckReceivable", new { Area = "Report" }, FormMethod.Post, new { id = "SearchForm" }))
{
    <div class="clearfix">
        <div class="col-sm-3">
            <div class="form-group">
                @Html.TextBox("Date", null, new { data_lang_number = "fa", @class = "form-control until floating-label datepicker", @placeholder = Resources.Date, @autocomplete = "off", @readonly = "readonly" })
                @Html.ValidationMessage("Date")
            </div>
        </div>
        <div class="col-sm-8">
            <div class="form-group" id="ShowDate">

            </div>
        </div>
    </div>
    <div class="clearfix">
        <div class="col-sm-12">
            <div class="text-left">
                <button id="report" type="submit" class="btn btn-info btn-sm">@Resources.Report</button>
            </div>
        </div>
    </div>
}
@Scripts.Render("~/bundles/jqueryval")
<script>

    $(".until.datepicker").datepicker({
        isRTL: true,
        dateFormat: "yy/mm/dd",

    });
      $("#Date").change(
        function () {

            var address = "@(Url.Action("GetDates", "ExpiredCheckPayable", new { Area = "Report" }))";
            $("#ShowDate").load(address, { Date: $('#Date').val() }, function (data) {

            });

        }
    );

</script>