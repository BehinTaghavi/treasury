@using CSD.Treasury.Resourse
@section PageHeader{
گزارش دریافت ،پرداخت در روز
}

@using (Html.BeginForm("Index1", "GardesheHesab", new { Area = "Report" }, FormMethod.Post, new { id = "SearchForm" }))
{


    <div class="clearfix">
        <div class="col-sm-3">
            <div class="form-group" >
                <select class = "form-control floating-label" id="BankType" name="BankType" placeholder ="">
                    <option>نوع حساب</option>
                    <option value="false">حسابهای جاری</option>
                    <option value="True">سپرده های بانکی</option>
                </select>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="form-group">
                @*@Html.DropDownListFor(d => d.BasicBank, Enumerable.Empty<SelectListItem>(), new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.Bank, @autocomplete = "off" })*@
                @Html.DropDownListFor(d => d.BasicBank, new SelectList(ViewBag.BasicBank, "BasicBankId", "BasicBankDescription"), "", new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.Bank, @autocomplete = "off" })
            </div>
        </div>
        <div class="col-sm-3">
            <div class="form-group">
                @Html.DropDownListFor(model => model.BankId, Enumerable.Empty<SelectListItem>(), new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.BankAccountNumber, @autocomplete = "off" })
            </div>
        </div>
       
        <div class="col-sm-3">
            <div class="form-group">
                @Html.TextBoxFor(d => d.FromDate, null, new { data_lang_number = "fa", @class = "form-control until floating-label datepicker", @placeholder =  Resources.Date, @autocomplete = "off", @readonly = "readonly" })
                @Html.ValidationMessageFor(model => model.FromDate)
            </div>
        </div>
    
       
    </div>
    <div class="clearfix">
        <div class="col-sm-12">
            <div class="text-left">
                <button id="report" type="submit" class="btn btn-info btn-sm">@Resources.Report</button>
            </div>
        </div>
    </div>
}

