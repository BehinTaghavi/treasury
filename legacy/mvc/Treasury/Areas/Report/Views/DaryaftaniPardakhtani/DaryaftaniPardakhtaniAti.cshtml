@model  List<CSD.Treasury.DataModel.DaryaftaniPardakhtaniAti_Result>
@using CSD.Treasury.Resourse
@{
    ViewBag.Title = "DaryaftaniPardakhtaniAti";
    Layout = "~/Views/Shared/Layout/Admin.cshtml";
}
@section PageHeader{
    دریافتنی و پرداختنی آتی
}
@section btnToolbar{
    <div class="mdc-bg-grey-50">
        <div class="btn-toolbar">
            <div class="row">
                <div class="col-sm-12">
                    @using (Ajax.BeginForm("list", "ReceiptCheck", new { Area = "Report" },
new AjaxOptions()
{
UpdateTargetId = "Result",
InsertionMode = InsertionMode.Replace,
}, new { id = "SearchForm" }))
                    {

                        <div class="clearfix">
                            <div class="col-sm-4">
                                <div class="text-left">
                                    <button id="report" type="button" class="btn btn-info btn-sm" onclick="$('.modal.default').modal('hide')">@Resources.Report</button>
                                </div>
                            </div>
                        </div>
                     
                    }
                </div>

            </div>


        </div>
    </div>
}
<table class="table table-striped sortable">
