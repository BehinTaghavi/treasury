@model CSD.Treasury.UI.Models.DaryaftaniPardakhtaniAti
@using CSD.Treasury.Resourse
@{
    ViewBag.Title = "IndexPerZinaf";
    Layout = "~/Views/Shared/Layout/Admin.cshtml";
}
@section PageHeader{
    دریافتنی و پرداختنی برحسب ذینفع
}
@section btnToolbar{
    <div class="mdc-bg-grey-50">
        <div class="btn-toolbar">
            <div class="clearfix">
                <div>
                    @using (Ajax.BeginForm("ListPerZinafSarresid", "DaryaftaniPardakhtani", new { Area = "Report" },
                        new AjaxOptions()
                        {
                            UpdateTargetId = "Result",
                            InsertionMode = InsertionMode.Replace,
                        },  new { id = "SearchForm" }))
                    {
                        <div class="col-sm-4">
                            <div class="form-group">
                                <select id="Type" name="Type" class="form-control">
                                    <option value="0">-----</option>
                                    <option value="1">@Resources.Receive</option>
                                    <option value="2">@Resources.Paid</option>
                                    <option value="3">همه</option>
                                </select>
                            </div>
                        </div>

                        <div class="pull-right">
                            <div class="col-sm-12">
                                <div class="text-left">
                                    <button type="submit" class="btn btn-info btn-sm">@Resources.Search</button>
                                    <button id="report" type="button" class="btn btn-info btn-sm" onclick="$('.modal.default').modal('hide')">@Resources.Report</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
}
@*id="@tableId"*@

<div id="Result">
    @Html.Action("ListPerZinafSarresid", "DaryaftaniPardakhtani", new { Area = "Report", Type = 3 })
</div>

@section scripts{
    <script type="text/javascript">
        function updateTable() {
            var url = '@(Url.Action("ListPerZinafSarresid", "DaryaftaniPardakhtani", new { area = "Report" }))';
            $.ajax({
                url: url, type: 'get',
                success: function (data, status) {
                    $("#Result").html(data);
                }
            });
        }
        $(function () {
            $('body').on("click", "#report", function () {
                var data = $('#SearchForm').serializeArray();
                var xhttp = new XMLHttpRequest();
                xhttp.onreadystatechange = function () {
                    if (xhttp.readyState == 4 && xhttp.status == 200) {
                        document.open();
                        document.write(xhttp.responseText);
                        document.close();
                    }
                };
                xhttp.open("POST", "@Url.Action("ReportDaryaftaniPardakhtani", "DaryaftaniPardakhtani", new { Area = "Report" })", true);
                xhttp.send(new FormData(document.querySelector("#SearchForm")));
            });
        });
   
    </script>
}


