                                        @*@Html.DropDownListFor(model => model.BankAccountNumber, Enumerable.Empty<SelectListItem>(), new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.BankAccountNumber})*@
                                        @*@Html.DropDownList("BankAccountName", new SelectList(ViewBag.Banks, "BankID", "Bank_AccountNumber"), Resources.PleaseSelect, new { data_lang_number = "fa", @class = "form-control" })*@
