        <div class="btn-toolbar">
            <div class="row">
                <div class="col-sm-12">
                    @using (Ajax.BeginForm("list", "Payment", new { Area = "Report" },
new AjaxOptions()
{
    UpdateTargetId = "Result",
    InsertionMode = InsertionMode.Replace,
}, new { id = "SearchForm" }))
                    {
                        <div class="clearfix">
                            <div class="col-xs-4">
                                <div class="clearfix">
                                    <div class="col-xs-4">
                                        <label for="ChequeFormatType" class="control-label">@Resources.ChequeFormatType</label>
