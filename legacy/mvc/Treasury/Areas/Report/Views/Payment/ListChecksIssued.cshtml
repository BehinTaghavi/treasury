@model CSD.Treasury.UI.Models.SearchModelRequestPayment
@using CSD.Treasury.UI.Models
@using CSD.Treasury.UI.Helper
@using CSD.Treasury.Common.Enumeration
@using CSD.Treasury.MVCHelpers
@using CSD.Treasury.Resourse

@{

    int i = Model.PageIndex * Model.PageSize;
    Model.Area = "Report";
    int ix = Model.PageIndex;
}
<table class="table sortable">
    <thead>
        <tr class="mdc-bg-grey-100">
            <th class="text-center">#</th>
            <th>@Resources.Number</th>
            <th>@Resources.DueDate</th>
            <th>@Resources.ChequeNo</th>
            <th>@Resources.PayAmount (ریال)</th>
            <th>@Resources.Unique_Account_No/@Resources.Unique_Account_Code</th>
            <th>@Resources.Bank</th>
            <th>@Resources.Behalf</th>
            <th>پرداخت شده</th>
            <th>@Resources.Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>

        @foreach (var item in Model.List)
        {
            <tr>
                <td data-lang-number="fa">@{i++;} @i</td>
              
                <td data-lang-number="fa">@(item.RequestID)</td>
                <td data-lang-number="fa">
                    @if (!string.IsNullOrEmpty(item.DueDate))
                {
                        @(item.DueDate.Substring(0, 4) + "/" + item.DueDate.Substring(4, 2) + "/" + item.DueDate.Substring(6, 2))
                    }
                </td>
                <td data-lang-number="fa">@(item.ChequeNo)</td>
                <td data-lang-number="fa">@Math.Truncate(item.PayAmount).ToString("#,##0")</td>
                <td data-lang-number="fa">
                @if (item.Account_Name!=null)
                {
                    if (item.Account_Name.Count() >= 7)
                    {
                    @(item.Account_Name.Substring(0, 7) + "...")@(item.Unique_Account_No)
                    }
                    else
                    {
                    @(item.Account_Name)@(item.Unique_Account_No)
                }
                }


                </td>
                <td>@(item.BasicBankDescription)/@(item.Bank_AccountNumber)</td>
                <td>
                    @if (item.BehalfDescription.Count() > 15)
                {
                        @(item.BehalfDescription.Substring(0, 15) + "...")
                    }
                    else
                    {
                        @(item.BehalfDescription)
                    }
                </td>
                <td>
                    @if(item.Paid!=null)
                    {
                        <span>بله</span>
                    }
                    else
                    {
                        <span>خیر</span>
                    }
                </td>
                <td>
                    @if (item.CancelCheque != null)
                    {
                    @Resources.CancelCheque
                    }
                    else if (item.Cancellation != null)
                    {
                        @Resources.Cancel
                    }
                    else if (item.Delivered != null)
                    {
                        @Resources.Delivered
                    }
                    else if (item.Paid != null)
                    {
                        @Resources.Paid
                    }
                    else if (item.ConfirmPayment != null)
                    {
                        @Resources.ConfirmPayment
                    }
                    else if (item.Confirmed != null)
                    {
                        @Resources.Confirm
                    }
                    else if (item.Unknown != null)
                    {
                        <text>@Resources.Unknown</text>
                    }
                </td>

                <td>
                    @if (!string.IsNullOrEmpty(item.ChequeElements_PrintLayout))
                {
                    var elem = item.ChequeElements_PrintLayout.Split(',');
                        @Ajax.ActionLink(Resources.Show + " " + Resources.Cheque, "ShowChequePrint", "ChequePayment", new
               {
                   area = "Payment",
                   ApproveIssuance = elem.Contains("ApproveIssuance"),
                   Bearer = elem.Contains("Bearer"),
                   BranchExporterReceivable = elem.Contains("BranchExporterReceivable"),
                   ChequeFormatID = elem[0],
                   CurrentAccount = elem.Contains("CurrentAccount"),
                   DueDate = elem[1],
                   NonTransferable = elem.Contains("NonTransferable"),
                   RemoveOrdersFor = elem.Contains("RemoveOrdersFor"),
                   RemoveRemit = elem.Contains("RemoveRemit"),
                   RequestId = item.RequestID.ToString(),
                   ShebaAccount = elem.Contains("ShebaAccount"),
                   TableName = elem[2],
                   WithoutCrossing = elem.Contains("WithoutCrossing"),
                   checkIsUnderwritten = elem.Contains("checkIsUnderwritten")

               }, new AjaxOptions
               {
                   OnSuccess = "modal(data, '" + Resources.CheckIssuance + "', 'lg:not(.xlg)')"
               }, null)
                    }
                </td>

            </tr>
                    }
    </tbody>
</table>
<hr />
<div class="container-fluid">
    <div class="clearfix">
        <div class="pull-right">
            <span class="pagination pagination-total">
                @Resources.Total : @Model.TotalItemCount
                @Resources.Page @(ix + 1)
                @Resources.From @Model.TotalPageCount
            </span>
        </div>
        <div class="pull-left">
            <nav class="text-center">
                <ul class="pagination  pagination-sm">
                    @{
                        var start = ix;
                        if (start > 0)
                        {
                            int c = 0;
                            while (start > 0 && c < 4)
                            {
                                c++;
                                start--;
                            }
                        }
                        if (ix != 0)
                        {
                            Model.PageIndex = 0;
                            <li>
                                @Ajax.ActionLink("<<", "ListChecksIssued", "Payment", Model,
    new AjaxOptions
    {
        UpdateTargetId = "Result",
        InsertionMode = InsertionMode.Replace,
        HttpMethod = "post",
    })

                            </li>
                        }
                        for (int j = start; j < Model.TotalPageCount && j < start + 10; j++)
                        {
                            if (ix != j)
                            {
                                Model.PageIndex = j;
                                <li>
                                    @Ajax.ActionLink((j + 1).ToString(), "ListChecksIssued", "Payment", Model,
    new AjaxOptions
    {
        UpdateTargetId = "Result",
        HttpMethod = "post",
        InsertionMode = InsertionMode.Replace,
    })
                                </li>
                            }
                            else
                            {
                                <li class="active">
                                    <span>@(j + 1) <span class="sr-only">(current)</span></span>
                                </li>
                            }
                        }
                        if (start + 9 < Model.TotalPageCount)
                        {
                            <li>
                                @Ajax.ActionLink(">>", "ListChecksIssued", "Payment", Model,
    new AjaxOptions
    {
        UpdateTargetId = "Result",
        HttpMethod = "post",
        InsertionMode = InsertionMode.Replace,
    })
                            </li>
                        }
                    }
                </ul>
            </nav>
        </div>
    </div>

</div>