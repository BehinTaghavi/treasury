@model CSD.Treasury.DataModel.UserInfo
@using CSD.Treasury.Common.Enumeration
@using (Ajax.BeginForm("Edit1", "User", new AjaxOptions
{
    HttpMethod = "Post",
    LoadingElementId = "loading",
    OnSuccess = "successMessage(data);closeModal('md');updateTable();"
}, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.UserID)
    @Html.HiddenFor(model => model.LocationID)
    @Html.HiddenFor(model => model.UserPassword)
    @Html.HiddenFor(model => model.CreatedTime)
    @Html.HiddenFor(model => model.IsAdmin)
    @Html.HiddenFor(model => model.LastLoginTime)
    @Html.HiddenFor(model => model.LastIPAddress)
    @Html.HiddenFor(model => model.SkinName)
    @Html.HiddenFor(model => model.UserImage)
    @Html.HiddenFor(model => model.IsActive)
    @Html.HiddenFor(model => model.DefualtLanguage)
    @Html.HiddenFor(model => model.LocationByCostCenterID)
    
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            <div class="col-md-5">
                @Html.TextBoxFor(model => model.User_FullName, new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.FullName })
                @Html.ValidationMessageFor(model => model.User_FullName, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-5">
                @Html.EditorFor(model => model.User_FullName2, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control", placeholder = Resources.FullName + Resources.EN } })
                @Html.ValidationMessageFor(model => model.User_FullName2, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-5">
                @Html.Hidden("InitialUserName", Model.UserName)
                @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.UserName } })
                @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
            </div>
        </div>
        @*<div class="form-group">
            <div class="col-md-5">
                @Html.EditorFor(model => model.UserPassword, new { htmlAttributes = new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.Password } })
                @Html.ValidationMessageFor(model => model.UserPassword, "", new { @class = "text-danger" })
            </div>
        </div>*@
        <div class="form-group">
            <div class="col-sm-12">
                <div class="text-right">
                    <button type="submit" class="btn btn-primary btn-sm">@Resources.Edit</button>
                </div>
            </div>
        </div>
    </div>
}

@Scripts.Render("~/bundles/jqueryval")
<script>
    $(function () {
        $.material.init();
    });
    
    function formatRepoSelection(repo) {
        return repo.full_name || repo.text;
    }
    
</script>

