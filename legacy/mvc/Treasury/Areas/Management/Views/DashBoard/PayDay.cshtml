@model List<CSD.Treasury.DataModel.GetAllRequestStatus_Result>
    @{ 
        int i = 0;
    }
@using CSD.Treasury.UI.Models
@using CSD.Treasury.Common.Enumeration

@foreach (var item in Model)
{
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>@Resources.RequestId</th>
                <th>@Resources.RequestDate</th>
                <th>@Resources.DueDate</th>
                <th>@Resources.PayAmount (ریال)</th>
                @if (Request.IsAuthenticated && (User.IsInRole("Admin")|| User.IsInRole("Manager")))
                {
                    <th>@Resources.Location</th>
                    <th>@Resources.UserName</th>
                }
                <th>@Resources.Priority</th>
                <th>@Resources.Status</th>
                <th>@Resources.Behalf</th>
                <th>@Resources.PayType</th>
            </tr>
        </thead>
        <tr>
            <td>
                @{i++;}
                @i
            </td>
            <td>
                @(item.RequestID)
            </td>
            <td>
                <span data-lang-number="fa">
                    @(item.RequestDate.Substring(0, 4) + "/" + item.RequestDate.Substring(4, 2) + "/" + item.RequestDate.Substring(6, 2))
                </span>
            </td>
            <td>
                @if (item.DueDate != null && item.DueDate != "")
                {
                    <span data-lang-number="fa">
                        @Utility.GetPersianDate(item.DueDate)
                    </span>
                }
            </td>
            <td>
                <b data-lang-number="fa" class="mdc-text-light-blue-900">
                    @Math.Truncate(item.PayAmount).ToString("#,##0")
                </b>
            </td>
            @if (Request.IsAuthenticated && ( User.IsInRole("Admin")|| User.IsInRole("Manager")))
            {
                <td>
                    @Utility.GetUserLocation(item.UserID)
                </td>
                    <td>
                        @Utility.GetUserName(item.UserID)
                    </td>
            }
            <td>
                @switch (item.Priority)
                {
                    case (short)Priority.High:
                        <i class='zmdi zmdi-alert-circle zmdi-hc-2x mdc-text-green-700' title="@TreasuryEnums.GetTitleFromResource("Priority", Enum.GetName(typeof(Priority), item.Priority))"></i>
                        break;
                    case (short)Priority.Normal:
                        <i class='zmdi zmdi-alert-circle zmdi-hc-2x mdc-text-lime-600' title="@TreasuryEnums.GetTitleFromResource("Priority", Enum.GetName(typeof(Priority), item.Priority))"></i>
                        break;
                    case (short)Priority.Low:
                        <i class='zmdi zmdi-alert-circle zmdi-hc-2x mdc-text-amber-600' title="@TreasuryEnums.GetTitleFromResource("Priority", Enum.GetName(typeof(Priority), item.Priority))"></i>
                        break;
                }
            </td>
            <td>
                @if (item.Delivered != null)
                {
                    @Resources.Delivered
                }
                else if (item.Paid != null)
                {
                    @Resources.Paid
                }
                else if (item.ConfirmPayment != null)
                {
                    @Resources.ConfirmPayment
                }
                else if (item.Confirmed != null)
                {
                    @Resources.Confirm
                }
               
            </td>
         
            <td>
                @Utility.GetBehalf(item.BehalfID)
            </td>
            <td>
                @if (item.Pay_TypeDetailID_source == 1)
                {
                    <text>چک روز</text>
                }
                else if (item.Pay_TypeDetailID_source == 2)
                {
                    <text>چک انتظامی</text>
                }

                else if (item.Pay_TypeDetailID_source == 4)
                {
                    <text>چک مدت دار</text>
                }
                else if (item.Pay_TypeDetailID_source == 5)
                {
                    <text>چک نقل و انتقال</text>
                }
                else if (item.Pay_TypeDetailID_source == 6)
                {

                    <text>سفته</text>
                }
                else if (item.Pay_TypeDetailID_source == 7)
                {
                    <text>پرداخت نقدی</text>
                }
                else if (item.Pay_TypeDetailID_source == 8)
                {
                    <text>پرداخت کارت</text>
                }


            </td>
           
          


        </tr>
    </table>
}