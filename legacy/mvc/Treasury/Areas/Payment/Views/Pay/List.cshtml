@model CSD.Treasury.UI.Models.SearchModelRequestPayment
@using CSD.Treasury.UI.Models
@using CSD.Treasury.UI.Helper
@using CSD.Treasury.Common.Enumeration
@using System.Configuration
@using CSD.Treasury.MVCHelpers
@{
    int i = Model.PageIndex * Model.PageSize;
    Model.Area = "Payment";
    int ix = Model.PageIndex;
    var admin = User.IsInRole("Admin");
    var manager = User.IsInRole("Manager");

}
<script src="@Url.Content(" ~/Scripts/material.min.js")"></script>
<script>
    $(function () {
        $.material.init();
    });
</script>
<table class="table sortable">
    <thead>
        <tr class="mdc-bg-grey-100">
            <th class="text-center">#</th>
            @if ((admin || manager) && Model.Status != "DeliveredPayment")
            {

                if (admin && Model.Status == "DuringPayment")
                {
                    <th class="text-center">
                        @Resources.ConfirmPayment
                    </th>
                }
                else if (Model.Status == "GetCash" || Model.Status == "ATM" || Model.Status == "InternetPay")
                {
                    <th class="text-center">
                        @Resources.Paid
                    </th>
                }
                else if (Model.Status == "ChequeReadyToDelivery")
                {
                    <th class="text-center">
                        @Resources.ConfirmDelivered
                    </th>
                }
                else if (Model.Status == "ChequeReadyToDelivery")
                {
                    <th class="text-center">
                        @Resources.ChequeReadyToDelivery
                    </th>
                }
                else if (Model.Status == "InternetPay")
                {
                    <th class="text-center">
                        @Resources.Internet @Resources.PayAmount
                    </th>
                }
                else if (Model.Status == "Satna")
                {
                    <th class="text-center">
                        @Resources.Satna @Resources.PayAmount
                    </th>
                }
                else if (Model.Status == "safte")
                {
                    <th class="text-center">
                        سفته
                    </th>
                }
                else
                {
                    <th class="text-center">

                    </th>
                }
            }

            @if (Model.Status == "DeliveredPayment")
            {
                <th class="text-center">

                </th>
            }
            <th>@Resources.Number</th>
            <th>@Resources.RequestDate</th>
            <th>@Resources.PayAmount </th>

            <th>@Resources.Unique_Account_No/@Resources.Unique_Account_Code</th>

            @*<th>@Resources.Priority</th>*@
            <th>@Resources.Status</th>
            @if (Model.Status == "Satna" || Model.Status == "InternetPay" || Model.Status == "ATM" || Model.Status == "GetCash")
            {
                <th>تاریخ برداشت</th>
            }
            else
            {
                <th>@Resources.DueDate</th>
            }

            <th data-defaultsort='disabled'>@Resources.Behalf</th>

            <th data-defaultsort='disabled'>@Resources.PayType</th>
            <th>@Resources.ChequeNo</th>
            @*<th data-defaultsort='disabled'></th>*@
            <th data-defaultsort='disabled'></th>
        </tr>
    </thead>

    @foreach (var item in Model.List)
    {
        string options = "";
        if (item.Pay_TypeDetailID_source != null && item.Pay_TypeDetailID_source != 6 && item.Pay_TypeDetailID_source != 7 && item.Source_PaymentValue != null && item.Source_TypeID != 3)
        {

            List<CSD.Treasury.Service.ChequeFormatTypesService.ChequeFormatType> chequeFormatTypeLs = Utility.GetChequeFormatTypeLs(int.Parse(item.Source_PaymentValue), true);
            foreach (var lb in chequeFormatTypeLs)
            {
                options += "<option value='" + lb.ChequeFormatID + "'>" + Utility.GetChequeDesc(lb.FormatDescriptionID_Main) + "</option>";
            }
        }
        var related = Utility.HasRelation("Request_Payment", "RequestID", item.RequestID.ToString(), "Payment", "RequestID");
        var rel = "";
        if (item.AggrigateOrDuplicationStatusID == (int)RequestDescription.ResultOfIntegrationRequest)
        {
            rel = Guid.NewGuid().ToString("N");
        }
        <tbody>
            @if (item.AggrigateOrDuplicationStatusID != (int)RequestDescription.Integration && item.AggrigateOrDuplicationStatusID != (int)RequestDescription.ResultOfDuplication && item.AggrigateOrDuplicationStatusID != (int)RequestDescription.IntegrationRequest)
            {
            <tr id="@Hash.GetHashString(item.RequestID.ToString())" style="@(item.AggrigateOrDuplicationStatusID == (int)RequestDescription.ResultOfIntegrationRequest && item.AggrigateOrDuplicationStatusID == (int)RequestDescription.Duplication ? "opacity: .5" : "")" class="@((item.AggrigateOrDuplicationStatusID == (int)RequestDescription.ResultOfIntegrationRequest && item.AggrigateOrDuplicationStatusID == (int)RequestDescription.Duplication) || item.Cancellation != null || item.CancelCheque != null ? "mdc-bg-grey-300" : "")@(item.AggrigateOrDuplicationStatusID == (int)RequestDescription.ResultOfIntegrationRequest && item.AggrigateOrDuplicationStatusID == (int)RequestDescription.ResultOfIntegration ? "mdc-bg-green-200" : "")">
                <td class="text-center">
                    @{i++;}
                    @i
                </td>
                <td class="text-right">
                    @if (((item.ConfirmPayment == null && Model.Status == "DuringPayment") || (item.Delivered == null && Model.Status == "ChequeReadyToDelivery") || (item.Paid == null && Model.Status == "ATM" && item.Delivered == null) || (item.Paid == null && ((Model.Status == "safte" && item.Delivered == null) || Model.Status == "InternetPay" || Model.Status == "Satna" || Model.Status == "GetCash"))) && item.Cancellation == null && item.CancelCheque == null)
                    {

                        if (ConfigurationManager.AppSettings["PayWhenCheckDelivered"] == "True" && ((item.Delivered == null && Model.Status == "ChequeReadyToDelivery")))
                        {
                            if (item.BankBalanceStatus == "HasPrice")
                            {
                                <div class="checkbox" style="display: inline-block">
                                    <label>
                                        <input type="checkbox" class="dataprop" value="@item.RequestID" />
                                        @*<text> موجودی کافیست</text>*@
                                    </label>
                                </div>
                            }
                            else if (item.BankBalanceStatus == "HasBackUp")
                            {
                                <div class="checkbox" style="display: inline-block">
                                    <label>
                                        <input type="checkbox" class="dataprop" value="@item.RequestID" />
                                        <text> برداشت از پشتیبان</text>
                                    </label>
                                </div>
                            }
                            else if (item.BankBalanceStatus == "NoPrice")
                            {
                                <text> موجودی کافی نیست</text>
                            }
                            else if (item.BankBalanceStatus == "NoPriceNoBackUp")
                            {
                                <text>موجودی حساب جاری
                                    <br />
                                    و حساب پشتیبان کافی نیست </text>
                            }
                        }
                        else if (ConfigurationManager.AppSettings["PayWhenCheckPrinted"] == "True" && ((item.Paid == null && Model.Status == "ATM") || (item.Paid == null && (Model.Status == "InternetPay" || Model.Status == "Satna" || Model.Status == "GetCash"))))
                        {
                            if (item.BankBalanceStatus == "HasPrice")
                            {
                                <div class="checkbox" style="display: inline-block">
                                    <label>
                                        <input type="checkbox" class="dataprop" value="@item.RequestID" />
                                        @*<text> موجودی کافیست</text>*@
                                    </label>
                                </div>
                            }
                            else if (item.BankBalanceStatus == "HasBackUp")
                            {
                                <div class="checkbox" style="display: inline-block">
                                    <label>
                                        <input type="checkbox" class="dataprop" value="@item.RequestID" />
                                        <text> برداشت از پشتیبان</text>
                                    </label>
                                </div>
                            }
                            else if (item.BankBalanceStatus == "NoPrice")
                            {
                                <text> موجودی کافی نیست</text>
                            }
                            else if (item.BankBalanceStatus == "NoPriceNoBackUp")
                            {
                                <text>موجودی حساب جاری
                                    <br />
                                    و حساب پشتیبان کافی نیست </text>
                            }
                        }
                        else
                        {

                            if (admin || (manager && Model.Status == "ChequeReadyToDelivery"))
                            {
                                <div class="checkbox" style="display: inline-block">
                                    <label>
                                        <input type="checkbox" class="dataprop" value="@item.RequestID" />
                                    </label>
                                </div>
                            }
                        }

                    }
                    @*else
            {
            <text>تایید شده</text>
            }*@
                    @*@if (item.ChildList != null && item.ChildList.Count != 0)
            {
                <a style="display: inline-block" class="show_hide btn btn-xs btn-link" rel=".@rel"><i class="zmdi zmdi-chevron-left zmdi-hc-3x"></i></a>
            }*@
                    @if (item.AggrigateOrDuplicationStatusID == (int)RequestDescription.ResultOfIntegrationRequest)
                    {
                        @*<button type="button" class="showSubRequest" rel></button>*@
                        @*<a style="display: inline-block" class="show_hide btn btn-xs btn-link" rel=".@rel"><i class="zmdi zmdi-chevron-left zmdi-hc-3x"></i></a>*@
                        @Ajax.ActionLink(">>", "ResultOfIntegrationRequest", "Pay", new { area = "Payment", requestId = item.RequestID }, new AjaxOptions
                   {
                       UpdateTargetId = rel,
                       InsertionMode = InsertionMode.Replace,
                       OnSuccess = "$('#" + rel + "').show()"
                   }, new { @class = "show_hide btn btn-xs btn-link ", rel = rel })

                    }
                </td>



                <td data-lang-number="fa">@(item.RequestID)</td>

                <td>
                    <span data-lang-number="fa">
                        @(item.RequestDate.Substring(0, 4) + "/" + item.RequestDate.Substring(4, 2) + "/" + item.RequestDate.Substring(6, 2))
                    </span>
                </td>
                <td>
                    <b data-lang-number="fa" style="font-size: 15px" class="mdc-text-light-blue-900">
                        @if (item.PayAmount == 0)
                        {
                            @Math.Truncate(item.ExchangeAmount.Value).ToString("#,##0")

                        }
                        else
                        {
                            @Math.Truncate(item.PayAmount).ToString("#,##0")
                        }

                    </b>
                </td>

                <td>
                    @(item.Account_Name)/@(item.Unique_Account_No)
                </td>


                @*<td>
            @switch (item.Priority)
            {
                case (short)Priority.High:
                    <b class='mdc-text-green-700'>@TreasuryEnums.GetTitleFromResource("Priority", Enum.GetName(typeof(Priority), item.Priority))</b>
                    break;
                case (short)Priority.Normal:
                    <b class='mdc-text-lime-600'>@TreasuryEnums.GetTitleFromResource("Priority", Enum.GetName(typeof(Priority), item.Priority))</b>
                    break;
                case (short)Priority.Low:
                    <b class='mdc-text-amber-600'>@TreasuryEnums.GetTitleFromResource("Priority", Enum.GetName(typeof(Priority), item.Priority))</b>
                    break;
            }
        </td>*@
                <td>

                    @if (item.Cancellation != null)
                    {
                        @Resources.Cancel
                    }
                    else if (item.CancelCheque != null)
                    {
                        if (item.Pay_TypeDetailID_source == 2)
                        {
                            <span>دریافت لاشه چک انتظامی</span>
                        }
                        else if (item.Pay_TypeDetailID_source == 1 || item.Pay_TypeDetailID_source == 4)
                        {
                            <span> عودت چک</span>
                        }
                        @*@Resources.CancelCheque*@
                    }
                    else if (item.AccVoucherNo != null)
                    {
                        <span>شماره سند : @(item.AccVoucherNo)</span>
                    }
                    else if (item.Paid != null)
                    {
                        @Resources.Paid
                    }
                    else if (item.Delivered != null)
                    {
                        @Resources.Delivered
                    }
                    else if (item.mojavezeEmza == true)
                    {
                        <span> مجوز امضا</span>
                    }
                    else if (item.ChequeElements_PrintLayout != null)
                    {
                        <span> چاپ چک</span>
                    }

                    else if (item.ConfirmPayment != null)
                    {
                        @Resources.ConfirmPayment
                    }
                    else if (item.Confirmed != null)
                    {
                        @Resources.Confirm
                    }
                    else if (item.Unknown != null)
                    {
                        <text>@Resources.Unknown</text>
                    }
                </td>


                <td>
                    <span data-lang-number="fa">
                        @if (!string.IsNullOrEmpty(item.DueDate))
                        {
                            @(item.DueDate.Substring(0, 4) + "/" + item.DueDate.Substring(4, 2) + "/" + item.DueDate.Substring(6, 2))
                        }
                    </span>
                </td>
                <td>
                    <b>
                        @{
                            var BehalfDesc = item.BehalfDescription;
                            if (BehalfDesc.Count() >= 15)
                            {
                                @(BehalfDesc.Substring(0, 15) + "...")
                            }
                            else
                            {
                                @BehalfDesc
                            }
                        }
                    </b>
                </td>

                <td>
                    @if (item.Pay_TypeDetailID_source == 1)
                    {
                        <text>چک روز</text>
                    }
                    else if (item.Pay_TypeDetailID_source == 2)
                    {
                        <text>چک انتظامی</text>
                    }

                    else if (item.Pay_TypeDetailID_source == 4)
                    {
                        <text>چک مدت دار</text>
                    }
                    else if (item.Pay_TypeDetailID_source == 5)
                    {
                        <text>چک نقل و انتقال</text>
                    }
                    else if (item.Pay_TypeDetailID_source == 6)
                    {
                        <text>سفته</text>
                    }
                    else if (item.Pay_TypeDetailID_source == 7)
                    {
                        <text>پرداخت نقدی</text>
                    }
                    else if (item.Pay_TypeDetailID_source == 8)
                    {
                        <text>پرداخت کارت</text>
                    }
                    else if (item.Pay_TypeDetailID_source == 32)
                    {
                        <text>پرداخت اینترنتی</text>
                    }
                    else if (item.Pay_TypeDetailID_source == 33)
                    {
                        <text>پرداخت ساتنا</text>
                    }
                </td>
                <td data-lang-number="fa">@(item.ChequeNo)</td>
                <td>


                    @*@if (item.Cancellation == null && item.CancelCheque == null)
            {*@
                    <div class="dropdown">
                        <button class="btn btn-material-light-blue-A700 btn-sm dropdown-toggle" type="button" id="dropdownMenu1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                            عملیات
                            &nbsp;&nbsp;<span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownMenu1">
                            <li>
                                @*@if (item.Pay_TypeDetailID_source != 33)
                {
                 @Ajax.ActionLink(Resources.CheckIssuance, "ShowChequeDetails", "Pay", item, new AjaxOptions
            {
                OnSuccess = "modal(data, '" + Resources.CheckIssuance + "', 'md')"
            }, null)
                }*@
                                @Ajax.ActionLink("نمایش", "RequestPayment", "Request", new { area = "Payment", requestId = item.RequestID, Type = 0 }, new AjaxOptions
                           {
                               OnSuccess = "modal(data,'" + Resources.Show + " " + Resources.RequestPayment + "', 'md');"
                           }, null)
                            </li>

                            @if (Request.IsAuthenticated && (admin || manager) && item.Pay_TypeDetailID_source != 7)
                            {
                                <li>
                                    @Ajax.ActionLink(Resources.BankBalance, "Index", "BankBalance", new { Area = "BasicInfo", Date = Utility.ToPersianDate(DateTime.Now), BankID = item.Source_PaymentValue, showSum = true }, new AjaxOptions
                               {
                                   OnSuccess = "modal(data,'" + Resources.BankBalance + "', 'lg:not(.xlg)');"
                               }
, null)
                                </li>
                            }
                            @if (item.Paid == null && item.Delivered == null && item.ChequeNo == null && item.mojavezeEmza == false && item.ConfirmPayment != null)
                            {
                                <li>
                                    @Ajax.ActionLink("لغو تایید پرداخت", "ReturnConfirmation", "Request", new { area = "Payment", requestId = item.RequestID }, new AjaxOptions
                               {
                                   HttpMethod = "Get",
                                   Confirm = "آیا از برگشت تایید پرداخت اطمینان دارید؟",
                                   OnSuccess = "successMessage(data);location.reload();",

                               }, new { title = "ثبت برداشت برای درخواست شماره: " + item.RequestID })


                                    @*@Html.ActionLink("حذف", "Delete", "Request", new { Area = "Payment", requestIds = item.RequestID }, new { @class = "delete" })*@
                                </li>
                            }
                            @if (item.ConfirmPayment != null && User.IsInRole("ChequePrint") && item.Cancellation == null && item.CancelCheque == null)
                            {
                                if (item.Pay_TypeDetailID_source != null && item.Pay_TypeDetailID_source != 6 && item.Pay_TypeDetailID_source != 7 && item.Pay_TypeDetailID_source != 8 && item.Pay_TypeDetailID_source != 32 && item.Pay_TypeDetailID_source != 33)
                                {


                                    if (item.ChequeNo == null && Model.Status == "DuringPayment")
                                    {



                                        if (!string.IsNullOrEmpty(options) && Utility.CheckIfHasCheques(int.Parse(item.Source_PaymentValue))
                                        //&& item.MozavezeChapeChequeDarad == 1
                                        )
                                        {
                                            <li>

                                                @Ajax.ActionLink(Resources.CheckIssuance, "ShowChequeDetails", "Pay", item, new AjaxOptions
                                           {
                                               OnSuccess = "modal(data, '" + Resources.CheckIssuance + "', 'md')"
                                           }, null)
                                            </li>
                                        }
                                        else if (item.Source_PaymentValue != null)
                                        {

                                            <li>

                                                <a class="issuance disabled" data-html="true" data-container="body" data-toggle="popover" data-placement="right" data-trigger="hover" data-content='برای بانک @Utility.GetBasicBankInfoWithBankId(int.Parse(item.Source_PaymentValue)) طراحی چک انجام نشده است! یا اینکه دسته چکی تعریف نشده است!'>
                                                    @Resources.CheckIssuance
                                                </a>
                                            </li>
                                        }
                                    }
                                    else
                                    {
                                        //var HasPAyment = Utility.IfHasPayment(item.RequestID);

                                        if (!item.mojavezeEmza.Value)
                                        {
                                            <li>
                                                @Ajax.ActionLink(Resources.PermissiveSignature, "SavepermisiveForRequest", "Request", new { Area = "Payment", RequestId = item.RequestID }, new AjaxOptions
                                           {
                                               OnSuccess = "modal(data,'" + @Resources.PermissiveSignature + "', 'md')"
                                           }, null)
                                            </li>
                                        }
                                        else if (Model.Status == "DeliveredPayment")
                                        {
                                            //HasPAyment &&
                                            <li>
                                                @Html.ActionLink(Resources.PaymentForm, "PaymentChequeReport", "RequestPayment", new { Area = "Report", RequestId = item.RequestID, Status = Model.Status }, null)
                                            </li>

                                        }

                                        if (!string.IsNullOrEmpty(item.ChequeElements_PrintLayout) && item.Cancellation == null && item.CancelCheque == null)
                                        {
                                            var elem = item.ChequeElements_PrintLayout.Split(',');
                                            <li>
                                                @Ajax.ActionLink(Resources.Show + " " + Resources.Cheque, "ShowChequePrint", "ChequePayment", new
                                           {
                                               ApproveIssuance = elem.Contains("ApproveIssuance"),
                                               Bearer = elem.Contains("Bearer"),
                                               BranchExporterReceivable = elem.Contains("BranchExporterReceivable"),
                                               ChequeFormatID = elem[0],
                                               CurrentAccount = elem.Contains("CurrentAccount"),
                                               DueDate = elem[1],
                                               NonTransferable = elem.Contains("NonTransferable"),
                                               RemoveOrdersFor = elem.Contains("RemoveOrdersFor"),
                                               RemoveRemit = elem.Contains("RemoveRemit"),
                                               RequestId = item.RequestID.ToString(),
                                               ShebaAccount = elem.Contains("ShebaAccount"),
                                               TableName = elem[2],
                                               WithoutCrossing = elem.Contains("WithoutCrossing"),
                                               checkIsUnderwritten = elem.Contains("checkIsUnderwritten")

                                           }, new AjaxOptions
                                           {
                                               OnSuccess = "modal(data, '" + Resources.CheckIssuance + "', 'lg:not(.xlg)')"
                                           }, null)
                                            </li>
                                        }

                                    }

                                }
                                if (item.Pay_TypeDetailID_source == 7 && item.Paid != null)
                                {
                                    <li>
                                        @Html.ActionLink(Resources.PaymentForm, "PaymentformReport", "RequestPayment", new { Area = "Report", RequestId = item.RequestID }, null)
                                    </li>
                                }
                            }
                            @if (item.Pay_TypeDetailID_source == 2 && Model.Status == "DeliveredPayment" && item.CovertCheque == null)
                            {
                                <li>
                                    @*@Html.ActionLink("تبدیل به چک روز", "ShowModalDatetime", "Pay", new { Area = "Payment", RequestId = item.RequestID })*@
                                    @Ajax.ActionLink("تبدیل به چک روز", "ShowModalDatetime", "Pay", new { Area = "Payment", RequestId = item.RequestID }, new AjaxOptions
                               {
                                   OnSuccess = "modal(data, 'تبدیل به چک روز', 'sm')"
                               })
                                </li>


                            }
                            @*|| Model.Status == "DuringPayment"*@
                            @if ((Model.Status == "ChequeReadyToDelivery" || Model.Status == "DeliveredPayment")
&& item.AggrigateOrDuplicationStatusID != (int)RequestDescription.IntegrationRequest
&& item.ChequeNo != null && item.Cancellation == null && item.Delivered != null)
                            {
                                <li>
                                    @Ajax.ActionLink("نمایش سند", "ShowVocherList", "Vocher_Row", new { Area = "Management", IsPayment = false, requestId = item.RequestID, IsReturend = false, Receipt_Pay_TypeID = 1, BehalfGroupID = Utility.GetBehalfGroupBybehalfId(item.BehalfID).BehalfGroupID, StatusID = item.Pay_TypeDetailID_source, ReferenceId = item.RequestID }, new AjaxOptions
                               {
                                   OnSuccess = "modal(data, 'نمایش سند', 'lg.ang')"
                               })
                                </li>
                                //چک مدت دار
                                //سند دوم

                                if (item.Pay_TypeDetailID_source == 4 || (item.Pay_TypeDetailID_source == 2 && item.CancelCheque != null) || (item.Pay_TypeDetailID_source == 1 && item.CancelCheque != null))
                                {
                                    var Status = 3;
                                    var title = "نمایش سند برداشت";
                                    if (item.Pay_TypeDetailID_source == 2)
                                    {
                                        Status = -2;
                                        title = "سند تحویل لاشه چک";
                                    }
                                    if (item.Pay_TypeDetailID_source == 1)
                                    {
                                        Status = -1;
                                        title = "سند عودت چک";
                                    }
                                    <li>
                                        @Ajax.ActionLink(title, "ShowVocherList", "Vocher_Row", new { Area = "Management", IsPayment = false, requestId = item.RequestID, IsReturend = false, Receipt_Pay_TypeID = 1, BehalfGroupID = Utility.GetBehalfGroupBybehalfId(item.BehalfID).BehalfGroupID, StatusID = Status, ReferenceId = item.RequestID }, new AjaxOptions
                                   {
                                       OnSuccess = "modal(data, 'نمایش سند', 'lg.ang')"
                                   })
                                    </li>
                                }
                            }
                            @*@if (Model.Status == "DeliveredPayment" && item.AggrigateOrDuplicationStatusID != (int)RequestDescription.ResultOfIntegrationRequest && item.Cancellation == null)
        {
            <li>
                @Ajax.ActionLink("نمایش سند", "ShowVocherList", "Vocher_Row", new { Area = "Management", IsPayment = false, requestId = item.RequestID, IsReturend = false, Receipt_Pay_TypeID = 1, BehalfGroupID = Utility.GetBehalfGroupBybehalfId(item.BehalfID).BehalfGroupID, StatusID = 4, ReferenceId = item.RequestID }, new AjaxOptions
           {
               OnSuccess = "modal(data, 'نمایش سند', 'lg.ang')"
           })
            </li>
        }*@
                            @if (((Model.Status == "GetCash" || Model.Status == "ATM" || Model.Status == "InternetPay" || Model.Status == "Satna" || Model.Status == "safte") && item.Paid != null && item.CancelCheque == null && item.Cancellation == null))
                            {
                                <li>
                                    @Ajax.ActionLink("نمایش سند", "ShowVocherList", "Vocher_Row", new { Area = "Management", IsPayment = false, requestId = item.RequestID, IsReturend = false, Receipt_Pay_TypeID = 1, BehalfGroupID = Utility.GetBehalfGroupBybehalfId(item.BehalfID).BehalfGroupID, StatusID = item.Pay_TypeDetailID_source, ReferenceId = item.RequestID }, new AjaxOptions
                               {
                                   OnSuccess = "modal(data, 'نمایش سند', 'lg.ang')"
                               })
                                </li>
                            }
                            @if (item.AggrigateOrDuplicationStatusID == (int)RequestDescription.ResultOfIntegrationRequest && Model.Status != "DuringPayment")
                            {
                                <li>
                                    @Html.ActionLink("لیست پرداخت ها", "IntegratedRequest", "RequestPayment", new { area = "Report", RequestId = item.RequestID }, new { target = "_blank" })
                                </li>
                                <li>
                                    @Html.ActionLink("پرداخت ها-فرمت بانک", "IntegratedRequest", "RequestPayment", new { area = "Report", RequestId = item.RequestID, Bankformat = true }, new { target = "_blank" })
                                </li>
                                <li>
                                    @Html.ActionLink(Resources.PaymentForm, "PaymentChequeAgreggatedReport", "RequestPayment", new { Area = "Report", RequestId = item.RequestID }, null)
                                </li>
                            }@if (((item.Confirmed != null)
|| ((
(item.Pay_TypeDetailID_source == 1 || item.Pay_TypeDetailID_source == 2 || item.Pay_TypeDetailID_source == 4 || item.Pay_TypeDetailID_source == 6)
))) && item.CancelCheque == null && item.AggrigateOrDuplicationStatusID != (int)RequestDescription.ResultOfIntegrationRequest)
                            {
                                if (item.Cancellation == null && item.CancelCheque == null)
                                {

                                    <li>

                                        @if ((item.ChequeNo != 0 && item.ChequeNo != null) && item.Delivered == null)
                                        {
                                            @Html.ActionLink("ابطال چک", "CancelRequest", "Request", new { Area = "Payment", RequestId = item.RequestID, Status = Model.Status }, new { @class = "CancelRequest" })
                                        }
                                        else if (item.CovertCheque == null && (item.Pay_TypeDetailID_source != 5) && ((Model.Status == "safte" && item.Delivered != null) || Model.Status == "ChequeReadyToDelivery" || Model.Status == "DeliveredPayment" || (Model.Status == "DuringPayment" && item.ChequeNo != null && item.mojavezeEmza.Value)))
                                        {
                                            var Title = "عودت چک";
                                            if (Model.Status == "safte")
                                            {
                                                Title = "عودت سفته";
                                            }
                                            if (item.Pay_TypeDetailID_source == 2)
                                            {
                                                Title = "دریافت لاشه چک انتظامی";
                                            }
                                            @Html.ActionLink(Title, "CancelRequest", "Request", new { Area = "Payment", RequestId = item.RequestID, Status = Model.Status }, new { @class = "CancelRequest" })
                                            // Resources.CancelCheque;
                                        }

                                    </li>
                                    <li>
                                        @if (item.Delivered != null
&& item.ExtendDueDate == null
&& item.Pay_TypeDetailID_source == 4
&& item.ChequeNo != null && item.mojavezeEmza.Value)
                                        {
                                            @Ajax.ActionLink("تمدید چک", "ExtendDueDate", "Pay", new { Area = "Payment", RequestId = item.RequestID }, new AjaxOptions
                                       {
                                           OnSuccess = "modal(data, 'تمدید چک', 'sm')"
                                       })
                                        }
                                    </li>
                                }
                            }
                            @*@if (item.ChequeNo > 0 && item.AggrigateOrDuplicationStatusID != (int)RequestDescription.ResultOfIntegrationRequest && item.Cancellation == null && item.CancelCheque == null && item.Pay_TypeDetailID_source != 33 && item.Delivered != null)*@
                            @if (item.ChequeNo > 0 && item.AggrigateOrDuplicationStatusID != (int)RequestDescription.ResultOfIntegrationRequest && item.Cancellation == null && item.CancelCheque == null && item.Delivered != null)
                            {
                                <li>
                                    @Html.ActionLink("برگه پرداخت", "ChequeReport", "RequestPayment", new { Area = "Report", RequestId = item.RequestID, Status = Model.Status }, null)
                                </li>
                            }

                            @if ((item.Pay_TypeDetailID_source == 33) || (item.Pay_TypeDetailID_source == 4) || (item.Pay_TypeDetailID_source == 1))
                            {
                                <li>
                                    @Html.ActionLink("سند پرداخت حواله", "ChequeReport", "RequestPayment", new { Area = "Report", RequestId = item.RequestID, Status = Model.Status }, null)
                                </li>
                            }

                        </ul>
                    </div>
                    @*}*@

                </td>
            </tr>
            }



        </tbody>
        <tbody id="@rel"></tbody>

    }
</table>


<hr />
<div class="container-fluid">
    <div class="clearfix">
        <div class="pull-right">
            <span class="pagination pagination-total">
                (@Resources.Total : @Model.TotalItemCount)
                @Resources.Page @(ix + 1)
                @Resources.From @Model.TotalPageCount
            </span>
        </div>
        <div class="pull-left">
            <nav class="text-center">
                <ul class="pagination  pagination-sm">
                    @{
                        var start = ix;
                        if (start > 0)
                        {
                            int c = 0;
                            while (start > 0 && c < 4)
                            {
                                c++;
                                start--;
                            }
                        }
                        if (ix != 0)
                        {
                            Model.PageIndex = 0;
                            <li>
                                @Ajax.ActionLink("<<", "List", "Pay", Model,
                        new AjaxOptions
                        {
                            UpdateTargetId = "Result",
                            InsertionMode = InsertionMode.Replace,
                            HttpMethod = "post",
                            OnSuccess = "reLoadListSuccess()"
                        })

                            </li>
                        }
                        for (int j = start; j < Model.TotalPageCount && j < start + 10; j++)
                        {
                            if (ix != j)
                            {
                                Model.PageIndex = j;
                                <li>
                                    @Ajax.ActionLink((j + 1).ToString(), "List", "Pay", Model,
                        new AjaxOptions
                        {
                            UpdateTargetId = "Result",
                            HttpMethod = "post",
                            InsertionMode = InsertionMode.Replace,
                            OnSuccess = "reLoadListSuccess()"
                        })
                                </li>
                            }
                            else
                            {
                                <li class="active">
                                    <span>@(j + 1) <span class="sr-only">(current)</span></span>
                                </li>
                            }
                        }
                        if (start + 9 < Model.TotalPageCount)
                        {
                            <li>
                                @Ajax.ActionLink(">>", "List", "Pay", Model,
                        new AjaxOptions
                        {
                            UpdateTargetId = "Result",
                            HttpMethod = "post",
                            InsertionMode = InsertionMode.Replace,
                            OnSuccess = "reLoadListSuccess()"
                        })
                            </li>
                        }
                    }
                </ul>
            </nav>
        </div>
    </div>

</div>
<script>

        var deleteBtn = document.getElementsByClassName("delete");

        for (var i = 0; i < deleteBtn.length; i++) {
            deleteBtn[i].addEventListener("click", deleteItem);
        }
        function deleteItem(e) {
            e.preventDefault();
            var item = this;
            alertify.confirm("", '@Resources.AreYouSure',
                       function () {
                           var xmlhttp = new XMLHttpRequest();
                           xmlhttp.onreadystatechange = function () {
                               if (xmlhttp.readyState == 4 && xmlhttp.status == 200) {
                                   var data = JSON.parse(xmlhttp.responseText);
                                   if (data.result == true) {
                                       item.deleteParentByTagName("tr", "danger", 1500, function () {
                                           alertify.success(data.message);
                                       })
                                   }
                                   else {
                                       alertify.error(data.message);
                                   }
                               }
                           };
                           xmlhttp.open("POST", item.href, true);
                           xmlhttp.send();
                       },
      function () {
      }).set('labels', { ok: '@Resources.Yes', cancel: '@Resources.NO' }).set({ transition: 'zoom' }).set('modal', false);
        }
    $('[data-toggle="tooltip"]').tooltip();
    function reLoadListSuccess() {
        $("#_delPrdS").remove();
        $("#_disPrdS").remove();
        document.getElementById("progroup").setAttribute("data-has-content", "empty");
    }
    var CancelBtn = document.getElementsByClassName("CancelRequest");

    for (var i = 0; i < CancelBtn.length; i++) {
        CancelBtn[i].addEventListener("click", CancelItem);
    }

    function CancelItem(e) {
        e.preventDefault();
        var item = this;
        alertify.confirm("", '@Resources.AreYouSure',
                   function () {
                       var xmlhttp = new XMLHttpRequest();
                       xmlhttp.onreadystatechange = function () {
                           if (xmlhttp.readyState == 4 && xmlhttp.status == 200) {
                               var data = JSON.parse(xmlhttp.responseText);
                               if (data.result == true) {
                                   alertify.success(data.message);
                                   updateTable();
                               }
                               else {
                                   alertify.error(data.message);
                               }
                           }
                       };
                       xmlhttp.open("POST", item.href, true);
                       xmlhttp.send();
                   },
  function () {
  }).set('labels', { ok: '@Resources.Yes', cancel: '@Resources.NO' }).set({ transition: 'zoom' }).set('modal', false);
    }

</script>
