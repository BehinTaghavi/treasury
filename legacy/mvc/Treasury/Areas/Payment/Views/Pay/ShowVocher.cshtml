@model List<CSD.Treasury.DataModel.Show_Voucher_Row_Result>
@{
    ViewBag.Title = "ShowVocher";
}
<table class="table table-striped">
    <thead>
        <tr class="mdc-bg-grey-200">
            <th>معین</th>
            <th>تفصیل اول</th>
            <th>تفصیل دوم</th>
            <th>شرح</th>
            <th>بدهکار</th>
            <th>بستانکار</th>
            <th>شماره چک</th>
            <th>نرخ ارز</th>
            <th>تاریخ</th>

        </tr>

    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <span>@(item.Account_No)</span>
                </td>
                <td>
                    <span>
                        @(item.Unique_Account_No)/@(item.Unique_Account_No_Title)
                    </span>

                </td>
                <td>
                    <span>
                        @(item.Unique_Account_No_two)/@(item.Unique_Account_No_two_Title)
                    </span>
                </td>
                <td>
                    @(item.Description)
                </td>
                <td>
                    @(item.Debit)ریال
                </td>
                <td>
                    @(item.Credit)ریال
                </td>
                <td>
                    @(item.Value_Field)
                </td>
                <td></td>
                <td>
                    @(item.Date_Field)
                </td>
            </tr>
        }
    </tbody>
</table>
