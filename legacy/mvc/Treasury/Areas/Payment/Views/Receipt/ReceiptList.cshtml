@section PageHeader{
    @switch ((int)ViewBag.State)
    {
        case -1:
            <text>
                واگذاری چک های دریافتی به حساب بانک
            </text>

            break;
        case -2:
            <text>
                وصول / برگشت  چک های واگذاری
            </text>
            break;
        case -2000:
            <text>
                عودت چک های واگذاری
            </text>
            break;

        case -3:
            < text >
            وصول مستقیم - نقد
            </ text >
            break;
        case -4:
            <text>
                وصول مستقیم چک نزدصندوق
            </text>
            break;
        case -5:
            <text>
                خرج چک دریافتی
            </text>
            break;
        @*case -18:
                <text>
               خرج چک های دریافتی - مشتری
                </text>
            break;*@
        case -6:
            <text>
                عودت چک نزد صندوق
            </text>
            break;
        case -7:
            <text>
                تبدیل چک انتظامی به چک دریافتنی
            </text>
            break;
        case -8:
            <text>
                حقوقی کردن چک های برگشتی
            </text>
            break;
        case -9:
            <text>
                عودت چک پس از برگشت از بانک
            </text>
            break;
        case -10:
            <text>
                ابطال چک های نزد صندوق
            </text>
            break;
        case -15:
            <text>
                تحویل لاشه چک های انتظامی
            </text>
            break;
        @*case -14:
            <text>
                تحویل لاشه چک های انتظامی
            </text>
            break;*@
        case -16:
            <text>
                عودت چک های خرج شده
            </text>
            break;
        case -17:
            <text>
                ثبت وصول چک های برگشتی
            </text>
            break;
        case -20:
            <text>
                تمدید چک سررسید شده دریافتنی
            </text>
            break;
        case -21:
            <text>
                تعویض چک دریافتنی سررسیدشده
            </text>
            break;
        case -22:
            <text>
                تنزیل اسناد دریافتنی واگذار شده به بانک
            </text>
            break;

        case -24:
            <text>
                واگذاری چک های برگشتی به حساب بانک
            </text>
            break;
        case -26:
            <text>
                واگذاري مجدد به بانک-چک برگشتي-اقدام حقوقي شده
            </text>
            break;


    }
}

<div ng-app="treasury" ng-controller="receiptListPlanController">


    <div loading class="mdc-bg-blue-grey-50" style="
    padding: 15px;
    margin: -15px -15px 15px -15px;
    border-bottom: 1px solid #f8f8f8;">
        <form ng-submit="ShowReceipt(0)">
            <div class="clearfix">
                <div class="col-sm-3" ng-if="(ReceiptPayTypeDetailLs | receiptPayTypeDetailsFilter:State).length > 0">
                    <div class="form-group">
                        <div class="clearfix custom-inline-control">
                            <label class="control-label">نوع دریافت</label>
                            <select class="form-control"
                                    style="max-width: 150px"
                                    ng-model="searchModel.RecieptType.Receipt_Pay_TypeDetailID"
                                    ng-options="option.Receipt_Pay_TypeDetailID as option.Receipt_Pay_TypeDetailDescription for option in (ReceiptPayTypeDetailLs | receiptPayTypeDetailsFilter:State)"></select>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <div class="clearfix custom-inline-control">
                            <label class="control-label">تاریخ دریافت از</label>
                            <div class="input-append">
                                <input date-p
                                       class="form-control Date"
                                       type="text"
                                       ui-mask="9999/99/99"
                                       ng-pattern="DatePattern"
                                       autocomplete="off"
                                       placeholder="____/__/__" lang="en"
                                       ng-model="searchModel.RecieptDateFrom">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <div class="clearfix custom-inline-control">
                            <label class="control-label">تا</label>
                            <div class="input-append">
                                <input date-p
                                       class="form-control Date"
                                       type="text"
                                       ui-mask="9999/99/99"
                                       ng-pattern="DatePattern"
                                       autocomplete="off"
                                       placeholder="____/__/__" lang="en"
                                       ng-model="searchModel.RecieptDateTo">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <div class="clearfix custom-inline-control">
                            <label class="control-label">@Resources.ReceiptDetailId</label>
                            <div class="input-append">
                                <input class="form-control"
                                       type="text"
                                       ng-model="searchModel.ReceiptDetailId">
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="clearfix">
                <div class="col-sm-3">
                    <div class="form-group">
                        <div class="clearfix custom-inline-control">
                            <label class="control-label">تاریخ سررسید از</label>
                            <div class="input-append">
                                <input date-p
                                       class="form-control Date"
                                       type="text"
                                       ui-mask="9999/99/99"
                                       ng-pattern="DatePattern"
                                       autocomplete="off"
                                       placeholder="____/__/__" lang="en"
                                       ng-model="searchModel.DueDateFrom">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <div class="clearfix custom-inline-control">
                            <label class="control-label">تا</label>
                            <div class="input-append">
                                <input date-p
                                       class="form-control Date"
                                       type="text"
                                       ui-mask="9999/99/99"
                                       ng-pattern="DatePattern"
                                       autocomplete="off"
                                       placeholder="____/__/__" lang="en"
                                       ng-model="searchModel.DueDateTo">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        <div class="clearfix custom-inline-control">
                            <label class="control-label">صادر کننده چک</label>
                            <div class="input-append">
                                <a class="btn btn-sm"
                                   ng-class="searchModel.UniqueAccount.Name == null ? 'btn-material-grey-500' : 'btn-material-light-blue-A700'"
                                   ng-click="changeUniqueAccount(searchModel.UniqueAccount)"
                                   style="margin: 4px 0;"
                                   ng-bind-html='searchModel.UniqueAccount.Name != null ? searchModel.UniqueAccount.Name : "صادر کننده چک"'>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3" ng-if="State == -2">
                    <div class="clearfix custom-inline-control">
                        <label class="control-label">شماره حساب واگذاری</label>
                        <select ng-required="item.checked" name="BankAccountLs_{{$index}}" class="form-control" ng-model="searchModel.RecieptType.PlaningTypeReferenceID">
                            <option ng-repeat="uc in BankAccountLs" value="{{uc.BankID}}">{{uc.Bank_AccountNumber}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <button id="searchFormButton" type="submit" class="btn btn-material-blue-500">جستجو</button>
        </form>
    </div>
    <form name="form" novalidate>
        <div style="padding: 20px; margin: -15px -15px 10px -15px; position: relative;">
            <div class="table-responsive">
                <div class="clearfix" ng-if="State != 11 && State != 12 && State != 7">
                    <div class="pull-right">
                        <ul uib-pagination total-items="bigTotalItems" items-per-page="maxSize" ng-change="pageChanged()" ng-model="currentPage" previous-text="قبل" next-text="بعد" max-size="maxSize" class="pagination-sm" boundary-link-numbers="true" rotate="false"></ul>
                    </div>
                    <div class="pull-left" ng-if="State != -21">
                        <button class="btn btn-success btnSave"
                                ng-model="button"
                                ng-disabled="form.$invalid || !hasChecked()"
                                ng-click="save($event)">
                            اعمال برنامه ریزی
                        </button>
                    </div>
                </div>
                @*واگذاری چک های دریافتی به حساب بانک - چک های نزد صندوق
                    State = -1, chequeState = 2*@
                <table class="table table-striped" ng-if="State == -1">
                    <thead>
                        <tr>
                            <th>
                            </th>
                            <th>@Resources.ReceiptDetailId</th>
                            <th>بانک</th>
                            <th>نوع چک</th>
                            <th>مبلغ</th>
                            <th>شماره چک</th>
                            <th>سررسید</th>
                            <th>شماره حساب واگذاری</th>
                            <th>تاریخ واگذاری</th>
                            @*<th>@Resources.account_code</th>*@
                            <th>تفصیل دوم</th>
                            <th>صادر کننده چک</th>
                            <th>شماره فیش واگذاری</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in receiptList" ng-init="item.ChequeState = 2">
                            <td>
                                <input type="checkbox" ng-checked="all" ng-model="item.checked" />
                            </td>
                            <td>{{item.ReceiptDetailId}}</td>
                            <td>{{item.Bank}}</td>
                            <td>{{item.Receipt_Pay_TypeTitle}}</td>
                            <td><b>{{item.Price | number}} {{item.ExchangeTypeTitle}}</b></td>
                            <td>{{item.ChequeNumber}}</td>
                            <td>{{item.DueDate}}</td>
                            <td ng-if="item.ExchangeRate == 0"
                                ng-class="{'mdc-bg-red-50':(item.checked && !item.BankId), 'mdc-bg-green-50':(item.checked && item.BankId)}">
                                <select ng-required="item.checked" name="BankAccountLs_{{$index}}" ui-select2="select2Options" style="max-width: 150px" class="form-control" ng-model="item.BankId" ng-change="checkUA2(item, 2)">
                                    <option ng-repeat="uc in BankAccountLs" value="{{uc.BankID}}">{{uc.Bank_AccountNumber}}</option>
                                </select>
                            </td>
                            <td ng-if="item.ExchangeRate != 0"
                                ng-class="{'mdc-bg-red-50':(item.checked && !item.BankId), 'mdc-bg-green-50':(item.checked && item.BankId)}">
                                <select ng-required="item.checked" name="BankAccountLs_{{$index}}" ui-select2="select2Options" style="max-width: 150px" class="form-control" ng-model="item.BankId" ng-change="checkUA2(item, 2)">
                                    <option ng-repeat="uc in BankAccountLsArzi" value="{{uc.BankID}}">{{uc.Bank_AccountNumber}}</option>
                                </select>
                            </td>
                            <td class="text-center"
                                ng-class="{'mdc-bg-green-50' : (item.StateDate && item.checked), 'mdc-bg-red-50' : (!item.StateDate && item.checked)}"
                                @*ng-init="minDate = 'item.LastStateDate';"*@>
                                <div class="input-append">
                                    <input date-p
                                           ng-required="item.checked"
                                           readonly
                                           name="StateDate_{{$index}}"
                                           class="form-control"
                                           @*maxDate="{{maxDate}}"*@
                                           minDate="{{item.LastStateDate}}"
                                           type="text"
                                           placeholder="____/__/__" lang="en"
                                           ng-model="item.StateDate">
                                </div>
                            </td>
                            <td></td>
                            <td>{{item.Unique_Account_No}}</td>
                            <td>
                                <button type="button" class="btn btn-sm" ng-class="{'btn-white':(!item.checked), 'btn-material-light-green-A700':(item.checked && item.PlaningTypeValue), 'btn-material-blue-A700':(item.checked && !item.PlaningTypeValue)}" ng-click="setDescription(item, 'شماره فیش واگذاری')">شماره فیش واگذاری</button>
                                <input type="hidden" ng-model="item.PlaningTypeValue" name=" PlaningTypeValue_{{$index}}" />
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="mdc-bg-grey-200">
                            <td colspan="3" class="text-left"><h3>جمع کل</h3></td>
                            <td colspan="9" class="text-right"><h3>{{sumPrice() | number}} ریال</h3></td>
                        </tr>
                    </tfoot>
                </table>

                @*واگذاری چک های برگشتی به حساب بانک
                    State = -24, chequeState = 24*@
                <table class="table table-striped" ng-if=" State == -24 ">
                    <thead>
                        <tr>
                            <th>
                            </th>
                            <th>@Resources.ReceiptDetailId</th>
                            <th>بانک</th>
                            <th>نوع چک</th>
                            <th>مبلغ</th>
                            <th>شماره چک</th>
                            <th>سررسید</th>
                            <th>شماره حساب واگذاری</th>
                            <th>تاریخ واگذاری</th>
                            <th>صادر کننده چک</th>
                            <th>شماره فیش واگذاری</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in receiptList" ng-init="item.ChequeState = 24">
                            <td>
                                <input type="checkbox" ng-checked="all" ng-model="item.checked" />
                            </td>
                            <td>{{item.ReceiptDetailId}}</td>
                            <td>{{item.Bank}}</td>
                            <td>{{item.Receipt_Pay_TypeTitle}}</td>
                            <td><b>{{item.Price | number}} {{item.ExchangeTypeTitle}}</b></td>
                            <td>{{item.ChequeNumber}}</td>
                            <td>{{item.DueDate}}</td>
                            <td ng-class="{'mdc-bg-red-50':(item.checked && !item.BankId), 'mdc-bg-green-50':(item.checked && item.BankId)}">
                                <select ng-required="item.checked" name="BankAccountLs_{{$index}}" ui-select2="select2Options" style="max-width: 150px" class="form-control" ng-model="item.BankId" ng-change="checkUA2(item, 2)">
                                    <option ng-repeat="uc in BankAccountLs" value="{{uc.BankID}}">{{uc.Bank_AccountNumber}}</option>
                                </select>
                            </td>
                            <td class="text-center"
                                ng-class="{'mdc-bg-green-50' : (item.StateDate && item.checked), 'mdc-bg-red-50' : (!item.StateDate && item.checked)}"
                                <div class="input-append">
                                    <input date-p
                                           ng-required="item.checked"
                                           readonly
                                           name="StateDate_{{$index}}"
                                           class="form-control"
                                           minDate="{{item.LastStateDate}}"
                                           type="text"
                                           placeholder="____/__/__" lang="en"
                                           ng-model="item.StateDate">
                                </div>
                            </td>
                            <td>{{item.Unique_Account_No}}</td>
                            <td>
                                <button type="button" class="btn btn-sm" ng-class="{'btn-white':(!item.checked), 'btn-material-light-green-A700':(item.checked && item.PlaningTypeValue), 'btn-material-blue-A700':(item.checked && !item.PlaningTypeValue)}" ng-click="setDescription(item, 'شماره فیش واگذاری')">شماره فیش واگذاری</button>
                                <input type="hidden" ng-model="item.PlaningTypeValue" name=" PlaningTypeValue_{{$index}}" />
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="mdc-bg-grey-200">
                            <td colspan="3" class="text-left"><h3>جمع کل</h3></td>
                            <td colspan="9" class="text-right"><h3>{{sumPrice() | number}} ریال</h3></td>
                        </tr>
                    </tfoot>
                </table>

                @*واگذاری چک های برگشتی اقدام حقوق شده به حساب بانک
                    State = -24, chequeState = 24*@
                <table class="table table-striped" ng-if=" State == -26 ">
                    <thead>
                        <tr>
                            <th>
                            </th>
                            <th>@Resources.ReceiptDetailId</th>
                            <th>بانک</th>
                            <th>نوع چک</th>
                            <th>مبلغ</th>
                            <th>شماره چک</th>
                            <th>سررسید</th>
                            <th>شماره حساب واگذاری</th>
                            <th>تاریخ واگذاری</th>
                            <th>صادر کننده چک</th>
                            <th>شماره فیش واگذاری</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in receiptList" ng-init="item.ChequeState = 26">
                            <td>
                                <input type="checkbox" ng-checked="all" ng-model="item.checked" />
                            </td>
                            <td>{{item.ReceiptDetailId}}</td>
                            <td>{{item.Bank}}</td>
                            <td>{{item.Receipt_Pay_TypeTitle}}</td>
                            <td><b>{{item.Price | number}} {{item.ExchangeTypeTitle}}</b></td>
                            <td>{{item.ChequeNumber}}</td>
                            <td>{{item.DueDate}}</td>
                            <td ng-class="{'mdc-bg-red-50':(item.checked && !item.BankId), 'mdc-bg-green-50':(item.checked && item.BankId)}">
                                <select ng-required="item.checked" name="BankAccountLs_{{$index}}" ui-select2="select2Options" style="max-width: 150px" class="form-control" ng-model="item.BankId" ng-change="checkUA2(item, 2)">
                                    <option ng-repeat="uc in BankAccountLs" value="{{uc.BankID}}">{{uc.Bank_AccountNumber}}</option>
                                </select>
                            </td>
                            <td class="text-center"
                                ng-class="{'mdc-bg-green-50' : (item.StateDate && item.checked), 'mdc-bg-red-50' : (!item.StateDate && item.checked)}">
                                <div class="input-append">
                                    <input date-p
                                           ng-required="item.checked"
                                           readonly
                                           name="StateDate_{{$index}}"
                                           class="form-control"
                                           minDate="{{item.LastStateDate}}"
                                           type="text"
                                           placeholder="____/__/__" lang="en"
                                           ng-model="item.StateDate">
                                </div>
                            </td>
                            <td>{{item.Unique_Account_No}}</td>
                            <td>
                                <button type="button" class="btn btn-sm" ng-class="{'btn-white':(!item.checked), 'btn-material-light-green-A700':(item.checked && item.PlaningTypeValue), 'btn-material-blue-A700':(item.checked && !item.PlaningTypeValue)}" ng-click="setDescription(item, 'شماره فیش واگذاری')">شماره فیش واگذاری</button>
                                <input type="hidden" ng-model="item.PlaningTypeValue" name=" PlaningTypeValue_{{$index}}" />
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="mdc-bg-grey-200">
                            <td colspan="3" class="text-left"><h3>جمع کل</h3></td>
                            <td colspan="9" class="text-right"><h3>{{sumPrice() | number}} ریال</h3></td>
                        </tr>
                    </tfoot>
                </table>
                @*ثبت وصول /  برگشت چک های واگذاری - چک های واگذار شده*@
                @*State = -2, chequeState = 11, chequeState = 6, chequeState = 12*@
                <table class="table table-striped" ng-if="State == -2 || State == -17 ">
                    <thead>
                        <tr>
                            <th>
                            </th>
                            <th>شماره رسید دریافت</th>
                            @*<th>تاریخ واگذاری</th>*@
                            <th>شماره حساب واگذاری</th>
                            <th>نوع چک</th>
                            <th>مبلغ</th>
                            <th>شماره چک</th>
                            <th>سررسید</th>
                            <th>وصول</th>
                            <th ng-if="State == -2 ">برگشت</th>
                            <th></th>
                            <th>تاریخ</th>
                            <th>@*@Resources.account_code*@</th>
                            <th>تفصیل دوم</th>
                            <th>صادر کننده چک</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in receiptList | filterReceiptList">
                            <td>
                                <input type="checkbox" ng-checked="all" ng-model="item.checked" />
                            </td>
                            <td>{{item.ReceiptDetailId}}</td>
                            <td>
                                {{item.Unique_Account_No_One}}
                                @*{{(BankAccountLs | filter: {'BankID': item.BankID})[0].Bank_AccountNumber}}*@
                            </td>
                            <td>{{item.Receipt_Pay_TypeTitle}}</td>
                            <td><b>{{item.Price | number}} {{item.ExchangeTypeTitle}}</b></td>
                            <td>{{item.ChequeNumber}}</td>
                            <td>{{item.DueDate}}</td>
                            @*&& item.ExchangeTypeID != 0*@
                            <td ng-if="State == -2 " class="text-center" ng-class="{'mdc-bg-green-50' : (item.ChequeState && item.checked), 'mdc-bg-red-50' : (!item.ChequeState && item.checked)}">
                                <input type="radio" name="{{$index}}" ng-model="item.ChequeState" value="11" ng-change="checkUA2(item, 1)" />
                            </td>


                            <td ng-if="State == -2" class="text-center" ng-class="{'mdc-bg-green-50' : (item.ChequeState && item.checked), 'mdc-bg-red-50' : (!item.ChequeState && item.checked)}">
                                <input type="radio" name="{{$index}}" ng-model="item.ChequeState" value="12" ng-change="checkUA2(item, 3)" />
                            </td>
                            <td ng-if="item.ExchangeTypeID == 0"></td>
                            <td class="text-center"
                                ng-class="{'mdc-bg-green-50' : (item.StateDate && item.checked), 'mdc-bg-red-50' : (!item.StateDate && item.checked)}">
                                <div class="input-append"
                                     @*ng-init="minDatett = 'item.LastStateDate'"*@>
                                    <input date-p
                                           ng-required="item.checked"
