    <div style="padding: 20px; margin: -15px -15px 10px -15px; position: relative;">
        <ul uib-pagination total-items="bigTotalItems" items-per-page="maxSize" ng-change="pageChanged()" ng-model="currentPage" previous-text="قبل" next-text="بعد" max-size="maxSize" class="pagination-sm" boundary-link-numbers="true" rotate="false"></ul>
        <div class="table-responsive">
            <table class="table" style="font-size: 12px">
                <thead>
                    <tr>
                        <th>ش.د</th>
                        <th>نوع دریافت</th>
                        <th>تاریخ</th>
                        <th>پرداخت کننده</th>
                        <th>بابت</th>
                        <th>بانک</th>
                        <th>مبلغ </th>
                        <th>سررسید</th>
                        <th>ش چک</th>
                        <th></th>
                        <th></th>

                    </tr>
                </thead>
                <tbody ng-repeat="item in receiptList">
                    <tr ng-class="{'mdc-bg-yellow-50':item.showReceiptPlanList}">
                        <td data-lang-number="fa">{{item.ReceiptDetailId}}</td>
                        <td>{{item.Receipt_Pay_TypeDetailDescription}}</td>
                        <td data-lang-number="fa">{{item.Date}}</td>
                        <td>{{item.Unique_Account}}</td>
                        <td>{{item.Behalf}}</td>
                        <td data-lang-number="fa">{{item.Bank ? item.Bank : '-'}}</td>
                        <td data-lang-number="fa"><b>{{item.Price | number}}</b></td>
                        <td data-lang-number="fa">{{item.DueDate}}</td>
                        <td data-lang-number="fa">{{item.Cheque_Number ? item.Cheque_Number : '-'}}</td>
                        <td>
                            <div class="dropdown">
                                <button ng-click="checkAccess(item.ReceiptDetailId)" class="btn btn-material-light-blue-A700 btn-xs dropdown-toggle" type="button" id="dropdownMenu1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                                   عملیات
                                    &nbsp;&nbsp;<span class="caret"></span>
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="dropdownMenu1">
                                    <li>
                                        <a ng-href="/Payment/Receipt/ReceiptReport?ReceiptDetailId={{item.ReceiptDetailId}} &ReceiptPayTypeId={{item.RecieptTypeId}}&headerId={{item.headerId}}">گزارش</a>
                                    </li>
                                    <li>
                                        <a ng-href="/Payment/Receipt/ReceiptReportdelivey?ReceiptDetailId={{item.ReceiptDetailId}} &ReceiptPayTypeId={{item.RecieptTypeId}}&headerId={{item.headerId}}">فرم رسید دریافت اسناد بهادار</a>
                                    </li>
                                    <li>
                                        <a ng-if="item.RecieptTypeId==21 ||item.RecieptTypeId==25" ng-href="/Payment/Receipt/CheckdeliveyReport?ReceiptDetailId={{item.ReceiptDetailId}} &ReceiptPayTypeId={{item.RecieptTypeId}}&headerId={{item.headerId}}">فرم تحویل لاشه</a>
                                    </li>
                                    <li>
                                        <a ng-click="ShowReceiptDetails(item.ReceiptDetailId)">مشاهده</a>
                                    </li>
                                    <li>
                                        <a  ng-if="CanEditReceiptDetail" ng-href="/Payment/Receipt/ShowReceiptForm?ReceiptDetailId={{item.ReceiptDetailId}} &ReceiptPayTypeId={{item.RecieptTypeId}}&headerId={{item.headerId}}">ویرایش</a>
                                    </li>
                                    <li>
                                        <a  ng-if="CanDeleteReceiptDetail" ng-href="#" ng-click="DeleteReceiptDetails(item.ReceiptDetailId,item.ReferenceReceiptId)">حذف</a>
                                    </li>
                                    <li>
                                        <a ng-if="CanDeleteReceiptDetailStates" ng-href="#" ng-click="DeleteALLReceiptDetailsPlanState(item.ReceiptDetailId , item.hasVoucher)"> حذف همه وضعیت ها</a>
                                    </li>
                                </ul>
                            </div>
                            @*ng-click="Edit(item)"*@
                            @*<a ng-click="showVocherList(item.ReceiptDetailId,0)" class="btn btn-info btn-xs">نمایش سند</a>*@
                        </td>
                        <td>
                            <button class="btn btn-xs btn-material-red-900" ng-click="GetReceiptPlanList(item)">نمایش-ویرایش-ارسال اسناد</button>
                        </td>
                        <td class="text-left">
                            <a ng-if="item.showReceiptPlanList" ng-click="item.showReceiptPlanList = false" style="cursor: pointer"><i class="zmdi zmdi-hc-2x zmdi-chevron-up"></i></a>
                            <a ng-if="!item.showReceiptPlanList && item.receiptPlanList" ng-click="item.showReceiptPlanList = true" style="cursor: pointer"><i class="zmdi zmdi-hc-2x zmdi-chevron-down"></i></a>
                        </td>
                    </tr>
                    <tr ng-if="item.showReceiptPlanList">
                        <td colspan="15" style="padding   : 0 0 5px 0;">
                            <div class="mdc-bg-grey-300" style="border-radius: 0 0 4px 4px;padding: 2px;">
                                <table class="table" style="background-color: transparent; margin: 0">
                                    <thead>
                                        <tr>
                                            <th>نوع برنامه ریزی</th>
                                            <th>تاریخ</th>
                                            <th>معین / معین در معین</th>
                                            <th>تفصیل اول</th>
                                            <th>تفصیل دوم</th>
                                            <th>  </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr ng-repeat="plan in item.receiptPlanList" class="mdc-bg-grey-50">
                                            <td>{{plan.PlaningTypeID}}</td>
                                            <td>{{plan.Date}}</td>
                                            <td>{{plan.Account_code}}</td>
                                            <td>{{plan.Unique_Account_No}}</td>
                                            <td>{{plan.Unique_Account_No_Two}}</td>
                                            <td>
                                                <a ng-click="showVocherList(item.ReceiptDetailId,plan.StateID,plan.PlaningID)" class="btn btn-material-blue-grey-600 btn-xs">نمایش سند</a>
                                                <a ng-if="plan.IsLastStateId && plan.PlaningID!= 21 && plan.PlaningID!= 1 && plan.PlaningID!=17 && plan.PlaningID!=19  && plan.PlaningID!=18 " ng-click="DeleteReceiptDetailsPlanState(plan.StateID, plan.hasVoucher)" class="btn btn-material-blue-grey-600 btn-xs">حذف وضعیت</a>
                                                @*&& plan.PlaningID!= 1 && plan.PlaningID!=17 && plan.PlaningID!=19  && plan.PlaningID!=18 && plan.PlaningID!=4*@
                                                @*<a ng-if="plan.PlaningTypeID!= 1" ng-click="DeleteALLReceiptDetailsPlanState(plan.ReceiptDetailId)" class="btn btn-material-blue-grey-600 btn-xs">حذف تمام وضعیت ها</a>*@
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <ul uib-pagination total-items="bigTotalItems" items-per-page="maxSize" ng-change="pageChanged()" ng-model="currentPage" previous-text="قبل" next-text="بعد" max-size="maxSize" class="pagination-sm" boundary-link-numbers="true" rotate="false"></ul>

    </div>
