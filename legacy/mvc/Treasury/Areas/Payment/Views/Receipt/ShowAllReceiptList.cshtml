                                   ng-click="changeUniqueAccount(searchModel.UniqueAccount)"
                                   style="margin: 4px 0;"
                                   ng-bind-html='searchModel.UniqueAccount.Name != "" ? searchModel.UniqueAccount.Name : "انتخاب"'>
                                </a>
                                <a class="btn btn-sm btn-material-grey-500"
                                   ng-click="searchModel.UniqueAccount = { Name: '', Code: '' }"
                                   style="margin: 4px 0;">
                                    <i class="zmdi zmdi-delete"></i>
                                </a>
                                <input type="hidden" name="UniqueAccount" required ng-model="searchModel.UniqueAccount.Code" />



                            </div>
                        </div>
                    </div>
                </div>
