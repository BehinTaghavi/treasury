                        <div class="clearfix custom-inline-control">
                            <label class="control-label">عطف</label>
                            <div class="input-append">
                                <input class="form-control" type="text" id="ReferenceValue" ng-model="searchModel.ReferenceValue" />

                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3" ng-if="State == -2">
                    <div class="clearfix custom-inline-control">
                        <label class="control-label">شماره حساب واگذاری</label>
                        <select ng-required="item.checked" name="BankAccountLs_{{$index}}" class="form-control" ng-model="searchModel.RecieptType.PlaningTypeReferenceID">
                            <option ng-repeat="uc in BankAccountLs" value="{{uc.BankID}}">{{uc.Bank_AccountNumber}}</option>
                        </select>
                    </div>
                </div>
            </div>
            @*<div class="clearfix">
                    <div class="col-sm-3">
                        <div class="form-group">
                            <div class="clearfix custom-inline-control">
                                <label class="control-label">گروه بابت</label>
                                <div class="input-append">
                                    <select class="form-control" name="BehalfGroupID_{{$index}}" ng-model="searchModel.BehalfGroupID" ng-options="option.BehalfGroupID as option.BehalfGroupDescription for option in BehalfGroupLs" ng-change="console.log(item);loadBehalf(searchModel.BehalfGroupID); item.references = []"></select>


                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="col-sm-3">
                        <div class="form-group">
                            <div class="clearfix custom-inline-control">
                                <label class="control-label"> بابت</label>
                                <div class="input-append">
                                    <select class="form-control" name="BehalfID_{{$index}}" ng-model="searchModel.BehalfID"  ng-options="option.BehalfID as option.BehalfDescription for option in BehalfList"></select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-3">
                        <div class="form-group">
                            <div class="clearfix custom-inline-control">
                                <label class="control-label">عطف</label>
                                <div class="input-append">
                                    <input class="form-control" type="text" id="Refrence" ng-model="searchModel.Refrence" />

                                </div>
                            </div>
                        </div>
                    </div>

                </div>*@
            <div class="text-left">
                <button id="searchFormButton" type="submit" class="btn btn-material-blue-500">جستجو</button>
            </div>
        </form>
    </div>
    <div class="btn-group">
        <button type="button" class="btn btn-material-green-600 dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
