<script src="@Url.Content("~/Scripts/Resources/app.js")"></script>
<script src="@Url.Content("~/Scripts/Resources/Controller/Receipt/receiptController.js")"></script>
<script src="@Url.Content("~/Scripts/Resources/Controller/ReceiptUC.js")"></script>
@section PageHeader{
    @if (!string.IsNullOrEmpty(ViewBag.Info))
    {
        @ViewBag.Info
    }
    else
    {
        <p> @ViewBag.ReceiptPayTypeName</p>
        <p class="field-validation-valid text-info">@(ViewBag.hasvoucher)</p>
    }
}
@if (ViewBag.message != null)
{
    <div class="alert-material-red"> @(ViewBag.message)</div>
}
else
{
    <div ng-app="treasury" ng-controller="receiptController" ng-init="hasvoucher = '@(ViewBag.hasvoucher)';price = '@(ViewBag.Price)';lastStatedate = '@(ViewBag.lastStatedate)';DateNow = '@(ViewBag.DateNow)' ">
