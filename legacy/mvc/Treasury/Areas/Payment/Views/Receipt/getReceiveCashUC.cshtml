<div class="row" ng-controller="Receive_uc_Controller">
    <label class="control-label col-sm-2" for="UniqueAccountType">@Resources.UniqueAccountType</label>
    <div class="col-sm-3">
        @Html.DropDownList("UniqueAccountType", new SelectList(ViewBag.unique_account_type, "Code", "Description"), Resources.PleaseSelect, new { data_lang_number="fa", @class = "form-control", data_bind = "Unique_Account_No" })
    </div>
    <div class="col-sm-7">
        <div class="dropdown keep-open lookup">
            <div class="clearfix">
                <div class="col-xs-4">
                    <input type="text" lookup data-action="UniqueAccount" autocomplete="off" data-related="Name" placeholder="@Resources.Unique_Account_Code" name="Code" id="Code" data-toggle="dropdown" class="form-control dropdown-toggle floating-label" aria-expanded="true">
                </div>
                <div class="col-xs-8">
                    <input type="text" lookup data-action="UniqueAccount" autocomplete="off" data-related="Code" placeholder="@Resources.Unique_Account_No" name="Name" id="Name" data-toggle="dropdown" class="form-control dropdown-toggle floating-label" aria-expanded="true">
                </div>
            </div>
            <ul class="dropdown-menu" style="width: 100%">
                <li id="UniqueAccountList"></li>
            </ul>
        </div>
    </div>
</div>

<script>
    $(function () {
        $.material.init();
        $("body").on("change", "#UniqueAccountType", function () {
            var address = "@(Url.Action("UniqueAccount", "Request", new { Area= "Payment" }))";
            if ($(this).val() != 0) {

                $("#UniqueAccountList").load(address, { UniqueAccountTypeId: $(this).val(), Bind: $(this).attr("data-bind") });
            }
            else {
                $("#UniqueAccountList").load(address, { UniqueAccountTypeId: 0, Bind: $(this).attr("data-bind") });
            }
        });
    });
    var lookup = document.querySelectorAll("[lookup]");
    for (var i = 0; i < lookup.length; i++) {
        lookup[i].onkeyup = function () {
            var xmlhttp = new XMLHttpRequest();
            xmlhttp.onreadystatechange = function () {
                if (xmlhttp.readyState == 4 && xmlhttp.status == 200) {
                    document.getElementById("UniqueAccountList").innerHTML = xmlhttp.responseText;
                }
            }
            var type = document.getElementById("UniqueAccountType");
            var address = "/Payment/Request/" + this.getAttribute("data-action") + "?UniqueAccountTypeId=" + type.value + "&Bind=" + type.getAttribute("data-bind") +
                ((this.value != "") ? "&" + this.getAttribute("Name") + "=" + ((this.value != "") ? this.value : "") : "") +
                ((document.getElementById(this.getAttribute("data-related")).value != "") ? "&" + this.getAttribute("data-related") + "=" + ((document.getElementById(this.getAttribute("data-related")).value != "") ? document.getElementById(this.getAttribute("data-related")).value : " ") : "");
            xmlhttp.open("GET",
                address
                , true);
            xmlhttp.send();
        }
     


    }
    function findAncestor(el, cls) {
        while ((el = el.parentElement) && !el.classList.contains(cls));
        return el;
    }
    function getLookupDataItem(e) {
        document.getElementById(e.getAttribute("data-bind")).value = e.getAttribute("data-content");
        document.getElementById("Unique_Account_PName").value = e.getAttribute("data-Name");

        for (var j = 0; j < e.querySelectorAll("[data-target]").length; j++) {
            var elm = document.getElementById(e.querySelectorAll("[data-target]")[j].getAttribute("data-target"));
            elm.value = e.querySelectorAll("[data-target]")[j].innerHTML; elm.classList.remove("empty");
        }
        $("#" + e.getAttribute("data-bind")).trigger('change');
        $("#Unique_Account_PName").trigger('change');
    }
    $('.dropdown.keep-open').on({
        "click": function () { this.classList.add("open"); this.closable = true; },
        "hide.bs.dropdown": function () { this.classList.remove("open"); return this.closable; }
    });
</script>
