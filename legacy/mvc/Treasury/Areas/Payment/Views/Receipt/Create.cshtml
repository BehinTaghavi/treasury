@model CSD.Treasury.DataModel.Reciept_Header
@using CSD.Treasury.Service.PermissiveSignaturesService
@{
    ViewBag.Title = "Create";
    var SignitureLs = (List<CSD.Treasury.Service.PermissiveSignaturesService.PermissiveSignature>)ViewBag.PermissiveSignatures;
}

<div id="Result">
    @using (Ajax.BeginForm("Create", "Receipt", new AjaxOptions
    {
        HttpMethod = "Post",
        OnSuccess = "successMessage(data);closeModal('lg:not(.xlg)');",

    }, new { enctype = "multipart/form-data", @class = "form-horizontal" }))
    {


        <div class="form-group">
            <div class="col-sm-12">
                <div class="text-right">
                    <button type="submit" class="btn btn-primary btn-sm">@Resources.Create</button>
                </div>
            </div>
        </div>

    }

    @Scripts.Render("~/bundles/jqueryval")


</div>
