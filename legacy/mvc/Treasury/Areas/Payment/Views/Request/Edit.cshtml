                            @Html.DropDownListFor(model => model.Main_Unique_Account_No, Enumerable.Empty<SelectListItem>(), new { data_lang_number = "fa", @class = "form-control floating-label", placeholder = Resources.Unique_Account_Code + "/" + Resources.Unique_Account_No })
                        }

                        @*@Html.HiddenFor(d => d.Main_Unique_Account_No, (string)ViewBag.main_Unique_Account_Code)
                            <div class="dropdown keep-open lookup">
                                <div class="clearfix">
                                    <div class="col-xs-4">
                                        <input type="text" value="@ViewBag.uniqueAccount_Code2" lookup data-action="UniqueAccount"  autocomplete="off" data-related="Name2" placeholder="@Resources.Unique_Account_Code"  autocomplete="off" name="Code2" id="Code2" data-toggle="dropdown" class="form-control dropdown-toggle floating-label" aria-expanded="true">
                                    </div>
                                    <div class="col-xs-8">
                                        <input type="text" value="@ViewBag.uniqueAccount_Name2" lookup data-action="UniqueAccount"  autocomplete="off" data-related="Code2" placeholder="@Resources.Unique_Account_No" autocomplete="off" name="Name2" id="Name2" data-toggle="dropdown" class="form-control dropdown-toggle floating-label" aria-expanded="true">
                                    </div>
                                </div>
                                <ul class="dropdown-menu" style="width: 100%">
                                    <li class="UniqueAccountList" id="acc2">
                                    </li>
                                </ul>
                            </div>*@
                        @Html.ValidationMessageFor(model => model.Unique_Account_No)
                    </div>
                </div>
            </div>



            <hr />
            <div class="form-group">
                <div class="row">
                    <label class="control-label col-sm-2" for="BehalfGropId">@Resources.BehalfGroupID</label>
                    <div class="col-sm-3">
                        <div class="form-group">
                            @Html.DropDownList("BehalfGropId", new SelectList(ViewBag.BehalfsGroupLs, "BehalfGroupID", "BehalfGroupDescription", ViewBag.BehalfGroupId), new { data_lang_number = "fa", @class = "form-control" })
                            @*@Html.ValidationMessageFor(model => model.BehalfGropId)*@
                        </div>
                    </div>
                    <label class="control-label col-sm-2" for="BehalfID">@Resources.Behalf</label>
                    <div class="col-sm-3">
                        <div class="form-group">
                            @Html.DropDownList("BehalfID", new SelectList(ViewBag.BehalfsLs, "BehalfID", "BehalfDescription"), new { data_lang_number = "fa", @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.BehalfID)
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <button id="Behalfs" class="btn btn-material-light-blue-A700 btn-sm" type="button">@Resources.Create @Resources.Behalf</button>
                    </div>

                </div>
            </div>
            <div>
                <div id="RefrenceLable">
                    @Html.Raw(Utility.GetReferenceTypeValue(Model.RequestID))
                </div>
            </div>




        </div>
        <div class="col-sm-5">
            <div class="form-group">
                <div class="row">
                    <label class="control-label col-sm-2" for="Priority">@Resources.Priority</label>
                    <div class="col-sm-4">
                        <select id="Priority" name="Priority" class="form-control" placeholder=@Resources.Priority>
                            @foreach (var item in EnumUtility.ToList(typeof(Priority), "", "", "", false))
                            {
                                <option value="@(item.Id)" @(item.Id == Model.Priority ? "selected='selected'" : "")>
                                    @item.Title
                                </option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <div class="row">
                    <label class="control-label col-xs-2">
                        @Resources.PayAmount
                    </label>
                    <div class="col-xs-7">
                        @Html.TextBoxFor(model => model.PayAmount, new { @min = "1", required = "required", data_lang_number = "fa", @class = "form-control", placeholder = Resources.PayAmount })

                        @Html.ValidationMessageFor(model => model.PayAmount)
                    </div>
                </div>
                
                <div class="form-group">
                    <div class="row">
                        <label id="labelExchange" class="control-label col-xs-2 hidden">
                            @Resources.ExchangeRate
                        </label>
                        <div class="col-xs-3">
                            @Html.TextBoxFor(model => model.ExchangeTypeID, new { @type = "hidden", @readonly = "readonly", data_lang_number = "fa", @class = "form-control" })
                            @Html.TextBoxFor(model => model.ExchangeRate, new { @readonly = "readonly", data_lang_number = "fa", @class = "form-control hidden" })
                            @*@Html.ValidationMessageFor(model => model.ExchangeRate)*@
                        </div>
                        <label id="labelExchangeInfo" class="control-label col-xs-2 hidden">
                            @Resources.ExchangeTypeDescription
                        </label>
                        <div id="ExchangeInfo" class="col-xs-3"></div>
                    </div>

                </div>




                @*@if (Model.Pay_TypeDetailID_source == 7)
        {
            <button type="button" class="btn btn-material-grey-600" id="addExchange">اضافه کردن ارز</button>
