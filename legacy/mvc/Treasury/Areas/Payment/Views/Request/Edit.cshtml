                                <div class="col-xs-7">
                                    <input class="form-control Exchange_Amount" data-lang-number="fa" data-val="true" data-val-number="The field Exchange_Amount must be a number." data-val-required="The Exchange_Amount field is required." id="item_Exchange_Amount" name="Request_Payment_BreakPriceLs[@i].Exchange_Amount" placeholder="مبلغ" relatedid="@id" type="number" value="@((Int64)item.Exchange_Amount)">
                                    <span class="field-validation-valid" data-valmsg-for="Request_Payment_BreakPriceLs[@i].Exchange_Amount" data-valmsg-replace="true"></span>
