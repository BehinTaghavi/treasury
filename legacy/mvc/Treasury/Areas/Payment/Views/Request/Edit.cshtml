@Scripts.Render("~/bundles/jqueryval")
<script src="@Url.Content("~/Scripts/wordifyfa.js")"></script>
<script type="text/javascript">

    $(function () {
        $.material.init();
        $('#Behalfs').click(function () {
            if ($('#BehalfGropId').val() == "") {
                alert("@Resources.PleaseSelect @Resources.BehalfGroup");
            }
            else {
                $.ajax({
                    type: "Post",
                    url: "/BasicInfo/Behalf/Index",
                    data: { BehalfGroupID: $('#BehalfGropId').val(), BehalfGroupDescription: " ", FromCreateRequest: true },

                    success: function (data, status) {
                        modal(data, '@Resources.BehalfGroup ', 'md');

                    }
                });
            }
        });
    });
    $('#requestForm').submit(function () {
        $('#btnSubmit').attr('disabled', 'disabled');
    });

    $(document).ready(function () {
        var ExchangeTypeID = @(Model.ExchangeTypeID.HasValue ? Model.ExchangeTypeID.Value : 0);
        if (ExchangeTypeID != 0) {
            document.getElementById("Pay_TypeDetailID_source").selectedIndex = @Model.Pay_TypeDetailID_source ; //"1";
            document.getElementById("Pay_TypeDetailID_source").setAttribute("disabled", "disabled");
            //*************************************************
            $('#ExchangeRate').removeClass("hidden");
            $('#labelExchange').removeClass("hidden");
            $('#ExchangeInfo').removeClass("hidden");
            $('#ExchangeTypeId').removeClass("hidden");

            //*************************************************
        }

        $(".js-data-example-ajax").select2({
            dir: "rtl",
            containerCssClass: "form-control"
        }
            );
        if ($('#ExchangeTypeID').val() != 1) {
            $('#ShowExchangeRate').removeClass("hidden");
        }
        $("#BehalfGropId").select2({
            dir: "rtl",
            containerCssClass: "form-control",
        });
        $("#Unique_Account_No").select2({
            dir: "rtl",
            containerCssClass: "form-control",
            ajax: {
                url: "/Payment/Request/UniqueAccountLs",
                dataType: 'json',
                delay: 250,

                data: function (params) {
                    params.page = params.page || 1;
                    return {
                        pageSize: 20,
                        page: params.page,
                        pageLimit: 10,
                        typeid: $('#UniqueAccountType').val(),
                        q: params.term, // search term

                    };
                },
                processResults: function (data, params) {

                    params.page = params.page || 1;
                    return {
                        results: data.query,
                        pagination: {
                            more: (params.page * 20 < data.total_count)

                        }
                    };
                },

                cache: true
            },



            escapeMarkup: function (markup) { return markup; },
            minimumInputLength: 1,

        });
    });
    var today = new Date();
    var day = today.getDate();
    var month = today.getMonth() + 1; //January is 0!
    var year = today.getFullYear();
    if (day < 10) day = '0' + day
    if (month < 10) month = '0' + month
    today = year + '-' + month + '-' + day;
    $(".moment-date").text(moment(today, 'YYYY-M-D').format('jYYYY/jM/jD'));
    $("#RequestDate").val(moment(today, 'YYYY-M-D').format('jYYYY/jMM/jDD').split('/').join(""))
    $("#FiscalYear").val(moment(today, 'YYYY-M-D').format('jYYYY'))
    $(".datepicker").val(moment(today, 'YYYY-M-D').format('jYYYY/jM/jD')).datepicker({
        isRTL: true,
        dateFormat: "yy/m/d",
        maxDate: new Date()
    });
    $('.timepicker').timepicker({
        template: false,
        showInputs: false,
        minuteStep: 1,
        showMeridian: false
    });
    $(function () {
        $(".Exchange_AmountText").text(wordifyfa($(".Exchange_Amount[relatedId=" + $(this).attr("id") + "]").val(), 0) + " " + $(".ExchangeTypeID[relatedId=" + $(this).attr("id") + "] option:selected").text());
        var interval = setInterval(function () {
            $(".Exchange_Amount").each(function (index) {
                var e = $.Event('keyup');
                e.which = 65; // Character 'A'
                $(this).trigger(e);
            });
        }, 1000)


        $("body").on("keyup", ".Exchange_Amount", function () {
            var val = $(this).val();
            var relatedId = $(this).attr("relatedid");
            $(".Exchange_AmountText[id=" + relatedId + "]").text(wordifyfa(val, 0) + " " + $(".ExchangeTypeID[relatedId=" + relatedId + "] option:selected").text());
        });
        $("body").on("change", ".Exchange_Amount", function () {
            var relatedId = $(this).attr("relatedId");
            var val = $(this).val();
            $(".Exchange_AmountText[id=" + relatedId + "]").text(wordifyfa(val, 0) + " " + $(".ExchangeTypeID[relatedId=" + relatedId + "] option:selected").text());
        });
        $("body").on("change", ".ExchangeTypeID", function () {
            var relatedId = $(this).attr("relatedId");
            $(".Exchange_AmountText[id=" + relatedId + "]").text(wordifyfa($(".Exchange_Amount[relatedId=" + relatedId + "]").val(), 0) + " " + $(".ExchangeTypeID[relatedId=" + relatedId + "] option:selected").text());
        })
        var exchangeNumber = "@i";
        $("body").on("click", "#addExchange", function () {
            var _id = guid();
            exchangeNumber = parseInt(exchangeNumber) + 1;
