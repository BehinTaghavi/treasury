                        @Html.DropDownList("UniqueAccountType2", new SelectList(ViewBag.unique_account_type2, "Code", "Description", ViewBag.uniqueTypeId2), string.Empty, new { data_lang_number = "fa", @class = "form-control floating-label UniqueAccountType", placeholder = "نوع ذینفع", data_bind = "Main_Unique_Account_No", data_code_att = "Code2", data_name_att = "Name2", updatetargetid = "acc2" })
                    </div>
                    <label class="control-label col-sm-2" for="@Model.Main_Unique_Account_No">@Resources.Unique_Account_Code </label>
                    <div class="col-md-5">
                        @if (ViewBag.SlectedLsMain != null)
                        {
                            @Html.DropDownListFor(model => model.Main_Unique_Account_No, new SelectList(ViewBag.SlectedLsMain, "Account_Code", "Account_Name", new { Type_Code = Model.Main_Unique_Account_No }), new { required = "required", data_lang_number = "fa", @class = "form-control floating-label js-data-example-ajax", placeholder = Resources.Unique_Account_Code + "/" + Resources.Unique_Account_No })
                        }
