@model CSD.Treasury.DataModel.Request_Payment

@using CSD.Treasury.Common.Enumeration;
@{
    ViewBag.Title = Resources.Edit + "" + Resources.RequestPayment;
    int i = -1;
    //var Request_Payment_BreakPriceLs = ViewBag.Request_Payment_BreakPriceLs;
}
@section PageHeader{
    <div class="clearfix">
        <div class="pull-right">
            @Resources.Edit @Resources.RequestPayment
        </div>
        <div class="pull-left">
            @Html.ActionLink(Resources.Return, "Index", "Request", new { Area = "Payment", PageIndex = ViewBag.PageIndex }, new { @class = "btn btn-default btn-sm" })
        </div>
    </div>

}


@using (Html.BeginForm("Edit", "Request", new { PageIndex = ViewBag.PageIndex }, FormMethod.Post, new { id = "requestForm" }))
{
    <div class="clearfix">
        <div class="pull-left"><span class="moment-date mdc-text-grey-600" data-lang-number="fa">@Model.RequestDate</span></div>

        <div class="pull-right">
            <button id="btnSubmit" type="submit" class="btn btn-primary" onsubmit="$(this).prop('disabled', true);">@Resources.Save</button>
        </div>

    </div>
    @Html.AntiForgeryToken()
    @Html.Hidden("RequestCreatedTime", DateTime.Now.ToString("h:mm"))
    @Html.HiddenFor(model => model.RequestDate)
    @Html.HiddenFor(model => model.RequestID)
    @Html.HiddenFor(model => model.UserID)
    <div class="container-fluid">

        @if (Request.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("RequestPayment") || User.IsInRole("Manager")))
        {
            <div class="form-group">
                <label class="control-label" for="Pay_TypeDetailID_source">@Resources.PayType</label>
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            @if (ViewBag.DisablePay_TypeDetailID_source)
                            {
                                @Html.DropDownListFor(d => d.Pay_TypeDetailID_source, new SelectList(ViewBag.Receipt_Pay_TypeDetailLs, "Receipt_Pay_TypeDetailID", "Receipt_Pay_TypeDetailDescription"), Resources.PleaseSelect, new { data_lang_number = "fa", @class = "form-control",@disabled= "disabled", @readonly= "readonly" })
                                @Html.HiddenFor(model=>model.Pay_TypeDetailID_source)   
                            }
                            else
                            {
                                @Html.DropDownListFor(d => d.Pay_TypeDetailID_source, new SelectList(ViewBag.Receipt_Pay_TypeDetailLs, "Receipt_Pay_TypeDetailID", "Receipt_Pay_TypeDetailDescription"), Resources.PleaseSelect, new { data_lang_number = "fa", @class = "form-control" })
                            }

                            @Html.ValidationMessageFor(model => model.Pay_TypeDetailID_source)
                        </div>
                    </div>
                </div>
                
                <div class="row">                
                    <div class="col-sm-6" style="display:@((Model.Pay_TypeDetailID_source.HasValue && (Model.Pay_TypeDetailID_source == 1 || Model.Pay_TypeDetailID_source == 4 || Model.Pay_TypeDetailID_source == 5 || Model.Pay_TypeDetailID_source == 7)) ? "block" : "none")">
                        <div class="form-group">
                            @Html.DropDownListFor(d => d.Source_TypeID, new SelectList(ViewBag.SourceDestinationTypesLs, "Source_DestinationTypeID", "Source_DestinationTypeDescription"), Resources.PleaseSelect, new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.From })
                            @Html.ValidationMessageFor(model => model.Source_TypeID)
                        </div>
                    </div>
                    <div class="col-sm-6" style="display:@((Model.Pay_TypeDetailID_source.HasValue && (Model.Pay_TypeDetailID_source == 1 || Model.Pay_TypeDetailID_source ==2 || Model.Pay_TypeDetailID_source == 4 || Model.Pay_TypeDetailID_source ==5 || Model.Pay_TypeDetailID_source ==7)) ? "block" : "none")">
                        <div class="form-group">
                            <select id="Source_PaymentValue" name="Source_PaymentValue" class="form-control floating-label" placeholder="@Resources.Number @Resources.Source">
                                @Html.Raw(ViewBag.PaymentValueLs)
                            </select>
                            @Html.ValidationMessageFor(model => model.Source_PaymentValue)
                        </div>
                    </div>
                </div>
                <div class="row">

                    <div class="col-sm-6" style="display:@((Model.Pay_TypeDetailID_source.HasValue && Model.Pay_TypeDetailID_source == 5) ? "block" : "none")">
                        <div class="form-group">
                            @Html.DropDownListFor(d => d.Destination_TypesID, new SelectList(ViewBag.SourceDestinationTypesLs, "Source_DestinationTypeID", "Source_DestinationTypeDescription"), Resources.PleaseSelect, new { data_lang_number = "fa", @class = "form-control floating-label", @placeholder = Resources.To })
                            @Html.ValidationMessageFor(model => model.Destination_TypesID)
                        </div>
                    </div>
                    <div class="col-sm-6" style="display:@((Model.Pay_TypeDetailID_source.HasValue && Model.Pay_TypeDetailID_source == 5) ? "block" : "none")">
                        <div class="form-group">
                            <select id="Destination_PaymentValue" name="Destination_PaymentValue" class="form-control floating-label" placeholder="@Resources.Number @Resources.Source">
                                @Html.Raw(ViewBag.DestinationValueLs)
                            </select>
                            @Html.ValidationMessageFor(model => model.Destination_PaymentValue)
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <hr />
    <div class="clearfix">
        <div class="col-sm-7">
