unt" placeholder="مبلغ" relatedid="' + _id + '" type="number" value="1000"><span class="field-validation-valid" data-valmsg-for="Request_Payment_BreakPriceLs[' + exchangeNumber + '].Exchange_Amount" data-valmsg-replace="true"></span></div></div><div class="row"><label class="control-label col-xs-10 col-xs-offset-2 col-sm-offset-2 col-md-offset-2 col-lg-offset-2"><b id="' + _id + '" class="mdc-text-green-700 Exchange_AmountText"> </b></label></div></div></div></div>')
                }
