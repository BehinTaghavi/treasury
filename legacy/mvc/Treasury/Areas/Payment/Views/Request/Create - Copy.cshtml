    @Scripts.Render("~/bundles/jqueryval")
    <script src="@Url.Content(" ~/Scripts/wordifyfa.js")"></script>
    <script type="text/javascript">

        $(function () {
            $.material.init();
        });

        $('#CreateRequset').submit(function () {
            if ($("#CreateRequset").valid()) {
                $('#btnSubmit').attr('disabled', 'disabled');
            }
        });

        $('#CreateRequset').keypress(function (e) {

            if (e.which == 13) {

                var $targ = $(e.target);

                if (!$targ.is("textarea") && !$targ.is(":button,:submit")) {
                    var focusNext = false;
                    $(this).find(":input:visible:not([disabled],[readonly]), a").each(function () {
                        if (this === e.target) {
                            focusNext = true;
                        }
                        else if (focusNext) {
                            $(this).focus();
                            return false;
                        }
                    });

                    return false;
                }
            }

        });

        var today = new Date();
        var day = today.getDate();
        var month = today.getMonth() + 1; //January is 0!
        var year = today.getFullYear();
        if (day < 10) day = '0' + day
        if (month < 10) month = '0' + month
        today = year + '-' + month + '-' + day;
        $(".moment-date").text(moment(today, 'YYYY-M-D').format('jYYYY/jM/jD'));
        $("#RequestDate").val(moment(today, 'YYYY-M-D').format('jYYYY/jMM/jDD').split('/').join(""))
        $("#FiscalYear").val(moment(today, 'YYYY-M-D').format('jYYYY'))
        $(".datepicker").val(moment(today, 'YYYY-M-D').format('jYYYY/jM/jD')).datepicker({
            isRTL: true,
            dateFormat: "yy/m/d",
            maxDate: new Date()
        });
        $('.timepicker').timepicker({
            template: false,
            showInputs: false,
            minuteStep: 1,
            showMeridian: false
        });
        $(function () {
            $(".Exchange_AmountText").text(wordifyfa($(".Exchange_Amount[relatedId=" + $(this).attr("id") + "]").val(), 0) + " " + $(".ExchangeTypeID[relatedId=" + $(this).attr("id") + "] option:selected").text());
            $("body").on("keyup", ".Exchange_Amount", function () {
                var val = $(this).val();
                var relatedId = $(this).attr("relatedid");
                $(".Exchange_AmountText[id=" + relatedId + "]").text(wordifyfa(val, 0) + " " + $(".ExchangeTypeID[relatedId=" + relatedId + "] option:selected").text());
            });
            $("body").on("change", ".Exchange_Amount", function () {
                var relatedId = $(this).attr("relatedId");
                var val = $(this).val();
                $(".Exchange_AmountText[id=" + relatedId + "]").text(wordifyfa(val, 0) + " " + $(".ExchangeTypeID[relatedId=" + relatedId + "] option:selected").text());
            });
            $("body").on("change", ".ExchangeTypeID", function () {
                var relatedId = $(this).attr("relatedId");
                $(".Exchange_AmountText[id=" + relatedId + "]").text(wordifyfa($(".Exchange_Amount[relatedId=" + relatedId + "]").val(), 0) + " " + $(".ExchangeTypeID[relatedId=" + relatedId + "] option:selected").text());
            })
            var exchangeNumber = "@i";
            $("body").on("click", "#addExchange", function () {
                var _id = guid();
                exchangeNumber = parseInt(exchangeNumber) + 1;
                $("#exchangePanel").append('<div class="panel"><div class="panel-body mdc-bg-grey-100" style="position: relative"><div class="form-group"><div class="row"><label class="control-label col-xs-2">نوع ارز</label><div class="col-xs-3"><select class="form-control ExchangeTypeID" data-lang-number="fa" data-val="true" data-val-number="The field ExchangeTypeID must be a number." data-val-required="The ExchangeTypeID field is required." id="item_ExchangeTypeID" name="Request_Payment_BreakPriceLs[' + exchangeNumber + '].ExchangeTypeID" placeholder="نوع ارز" relatedid="' + _id + '"><option value="1">ريال</option><option value="2">دلار</option><option value="28">يورو</option></select><span class="field-validation-valid" data-valmsg-for="Request_Payment_BreakPriceLs[' + exchangeNumber + '].ExchangeTypeID" data-valmsg-replace="true"></span></div><label class="control-label col-xs-2 ShowExchangeRate hidden">نرخ ارز</label><div class="col-xs-3 ShowExchangeRate hidden"><input value="1" class="form-control Exchange_Rate" data-lang-number="fa" data-val="true" data-val-number="The field Exchange_Rate must be a number." data-val-required="The Exchange_Rate field is required." id="item_Exchange_Rate" name="Request_Payment_BreakPriceLs[' + exchangeNumber + '].Exchange_Rate" placeholder="نرخ ارز" relatedid="' + _id + '" type="number"><span class="field-validation-valid" data-valmsg-for="Request_Payment_BreakPriceLs[' + exchangeNumber + '].Exchange_Rate" data-valmsg-replace="true"></span></div></div></div><div class="form-group form-group-material-indigo-500"><div class="row"><label class="control-label col-xs-2">مبلغ</label><div class="col-xs-7"><input class="form-control Exchange_Amount" data-lang-number="fa" data-val="true" data-val-number="The field Exchange_Amount must be a number." data-val-required="The Exchange_Amount field is required." id="item_Exchange_Amount"  name="Request_Payment_BreakPriceLs[' + exchangeNumber + '].Exchange_Amount" placeholder="مبلغ" relatedid="' + _id + '" type="number" value="1000"><span class="field-validation-valid" data-valmsg-for="Request_Payment_BreakPriceLs[' + exchangeNumber + '].Exchange_Amount" data-valmsg-replace="true"></span></div></div><div class="row"><label class="control-label col-xs-10 col-xs-offset-2 col-sm-offset-2 col-md-offset-2 col-lg-offset-2"><b id="' + _id + '" class="mdc-text-green-700 Exchange_AmountText"> </b></label></div></div></div></div>')
                //<a class="btn btn-link mdc-text-red-A700 removeItem" style="line-height: 30px;text-align: center;position: absolute;left: 15px;top: 15px;width: 15px;cursor: pointer;font-size: 20px; z-index: 10" title="حذف"><i class="zmdi zmdi-close"></i></a>
                //Remove current form validation information
                $("form")
                    .removeData("validator")
                    .removeData("unobtrusiveValidation");

                //Parse the form again
                $.validator
                    .unobtrusive
                    .parse("form");
            });
            $("body").on("click", ".removeItem", function () {
                $(this).parent().parent().remove();
            });

            function guid() {
                function s4() {
                    return Math.floor((1 + Math.random()) * 0x10000)
                        .toString(16)
                        .substring(1);
                }
                return s4() + s4() + '-' + s4() + '-' + s4() + '-' +
                    s4() + '-' + s4() + s4() + s4();
            }
            $("body").on("change", "#referenceTypeID", function () {
                var txt = ""
                if ($(this).val() != 0) {
                    var txt = $("#referenceTypeID option:selected").text();
                }
                $("#referenceTypeValue").parent().find(".floating-label").text("شماره " + txt);
            })
            $("body").on("change", "#Unique_Account_No", function () {

                @*if ($(this).val() != "") {
                    var address = "@(Url.Action("GetBehalfs", "Request", new { Area = "Payment" }))";
                    //var address = "@(Url.Action("GetAccountShebaNo", "Request", new { Area = "Payment" }))";
                    //var UniqueAccountNo = $('#Unique_Account_No').val();
                    //address = address + "?UniqueAccountNo=" + UniqueAccountNo;
                    $("#Description").load(address, {}, function (data) {
                        $("#Description").val($("#Description option:first").val());
                        alert(data);
                    });
                }*@

                var UniqueAccountNo = $('#Unique_Account_No').val();
                $('#Description').empty().append('<option>لطفا انتخاب نمایید</option>');
                $.ajax({
                    url: "@Url.Action("GetAccountShebaNo", "Request", new { area = "Payment" })",
                    //dataType: 'json',
                    type: 'GET',
                    data: { "UniqueAccountNo": UniqueAccountNo },
                    success: function (response) {
                        alert(response);
                        alert("ello");
                        $("#Description").append(response);

                    }

                });
            })
            $("body").on("change", "#BehalfGropId", function () {
                if ($(this).val() != "") {
                    $("#RefrenceLable").empty();
                    var address = "@(Url.Action("GetBehalfs", "Request", new { Area = "Payment" }))";
                    $("#BehalfID").load(address, { id: $(this).val() }, function (data) {
                        $("#BehalfID").val($("#BehalfID option:first").val());
                    });
                    //$("#Description").load(address, { id: $(this).val() }, function (data) {
                    //    $("#Description").val($("#Description option:first").val());
                    //});
                    var BehalfGroupID = $('#BehalfGropId').val();

                    var url = "@(Url.Action("GetReferenceTypeByBehalfGroup", "Request", new { Area = "Payment" }))";
                    url = url + "?BehalfGroupID=" + BehalfGroupID;
                    $("#RefrenceLable").hide();
                    $("#RefrenceLable").load(url, { id: $(this).val() }, function () { $("#RefrenceLable").show() });

                }
                else {
                    $("#BehalfID").html("");
                }
            })

            $('#Source_PaymentValue').change(function () {
                loadBankBalance();
            });




            $("body").on("change", "#Pay_TypeDetailID_source", function () {
                if ($(this).val() == "7") {
                    $("#addExchange").show();
                    var _id = guid();
                    exchangeNumber = 0;
                    $("#exchangePanel").html("");
