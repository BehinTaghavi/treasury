    function AcceptRequest() {
        alertify.confirm('@Resources.AreYouSure',
            function () {
                var RequestList = [];
       
                $.each($(".dataprop"), function (i, element) {
                    if ($(this).is(':checked')) {
                        RequestList.push($(this).val());
                    }
                });
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("Confirmation", "Request", new { area = "Payment" })',
                    data: $.param({ requestIds: RequestList, Status: 1}, true),
                    success: function (data) {
                        //alertify.success(data.Message);
                        var rowChecked = document.getElementsByClassName("rowchecked");
                        for (var i = 0; i < rowChecked.length; i++) {
                            deleteRow(rowChecked[i].getAttribute("id"));
                        }
                        $("#_disPrdS").remove();
                        progroup.setAttribute("data-has-content", "empty");
                        successMessage(data);
                        updateTable();
                    },
                    datatype: "json",
                    traditional: true,
                    error: function (xhr, ajaxOptions, thrownError) {
                        alertify.error(xhr.status);
                        alertify.error(thrownError);
                    }
                })
            })
    }

    $("body").on("change", "#UniqueAccountType", function () {
        var address = "@(Url.Action("UniqueAccount", "Request", new { Area= "Payment" }))";
        if ($(this).val() != 0) {
            $("#UniqueAccountList").load(address, { UniqueAccountTypeId: $(this).val(), Bind: $(this).attr("data-bind") });
        }
        else {
            $("#UniqueAccountList").load(address, { UniqueAccountTypeId: 0, Bind: $(this).attr("data-bind") });
        }
    });






    @*function DiscountSelectedProduct() {
            var discountList = [];
            var storeId = "";
            $.each($(".dataprop"), function (i, element) {
                if ($(this).is(':checked')) {
                    discountList.push($(this).val());
                }
                if (i == 0) {
                    storeId = $(this).attr("data-st-val")
