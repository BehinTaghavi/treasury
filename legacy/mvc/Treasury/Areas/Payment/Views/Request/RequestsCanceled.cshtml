@model CSD.Treasury.UI.Models.SearchModelRequestPayment

@{
    ViewBag.Title = "RequestsCanceled";
}


@section PageHeader{
    @Resources.RequestsCanceled
}
@section btnToolbar{
@using (Ajax.BeginForm("ShowRequestsCanceled", "Request", new { Area = "Payment" },
    new AjaxOptions()
    {
        UpdateTargetId = "Result",
        InsertionMode = InsertionMode.Replace,
    }, new { id = "SearchForm" }))
{
    @Html.HiddenFor(d => d.Unique_Account_No)
    @Html.HiddenFor(d => d.Status)
    <div class="clearfix">
        <div class="col-sm-4">
            <div style="padding: 8px 0;">
                <div class="clearfix">
                    <div class="col-xs-6">
                        <label for="RequsetId" class="control-label">@Resources.FiscalYear</label>
                    </div>
                    <div class="col-xs-6">
                        @Html.TextBoxFor(model => model.FiscalYear, new { @type = "number", data_lang_number = "fa", @class = "form-control", @placeholder = Resources.FiscalYear })
                    </div>
                </div>
            </div>

        </div>

        <div class="col-sm-3">
            <div style="padding: 6px 0;">
                <div class="clearfix">
                    <div class="col-xs-6">
                        <label for="RequsetId" class="control-label">@Resources.RequestId</label>
                    </div>
                    <div class="col-xs-6">
                        @Html.TextBoxFor(model => model.RequsetId, new { data_lang_number = "fa", @class = "form-control from", @placeholder = Resources.RequestId })
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-1 col-sm-offset-3">
            <div class="text-left">
                <button type="submit" class="btn btn-info btn-sm" onclick="$('.modal.default').modal('hide')">@Resources.Search</button>
            </div>
        </div>

    </div>
                   
}
}

@section list{
    <div id="Result">
        @Html.Action("ShowRequestsCanceled", "Request", new { Area = "Payment", Model })
    </div>
}
<script>
    $(".from.datepicker").datepicker({
        isRTL: true,
        dateFormat: "yy/mm/dd",
    });
</script>