                    {
                        <text>چک مدت دار</text>
                    }
                    else if (item.Pay_TypeDetailID_source == 5)
                    {
                        <text>چک نقل و انتقال</text>
                    }
                    else if (item.Pay_TypeDetailID_source == 6)
                    {
                        <text>سفته</text>
                    }
                    else if (item.Pay_TypeDetailID_source == 7)
                    {
                        <text>پرداخت نقدی</text>
                    }
                    else if (item.Pay_TypeDetailID_source == 8)
                    {
                        <text>پرداخت کارت</text>
                    }
                    else if (item.Pay_TypeDetailID_source == 32)
                    {
                        <text>پرداخت اینترنتی</text>
                    }
                    else if (item.Pay_TypeDetailID_source == 33)
                    {
                        <text>پرداخت ساتنا</text>
                    }
                </td>
                <td data-lang-number="fa">@(item.ChequeNo)</td>
                <td>
                    @if (item.AggrigateOrDuplicationStatusID != (int)RequestDescription.Duplication)
                    {
                        <div class="dropdown">
                            <button class="btn btn-material-light-blue-A700 btn-sm dropdown-toggle" type="button" id="dropdownMenu1" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                                عملیات
