                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenu1">
                                <li>

                                    @Ajax.ActionLink("نمایش", "RequestPayment", "Request", new { area = "Payment", requestId = item.RequestID, Type = 0 }, new AjaxOptions
                           {
                               OnSuccess = "modal(data,'" + Resources.Show + " " + Resources.RequestPayment + "', 'md');"
                           }, null)
                                </li>
                                @if (item.Cancellation == null)
                                {
                                    <li>
                                        @Html.ActionLink("گزارش", "RequestDetails", "RequestPayment", new { Area = "Report", RequestId = item.RequestID }, null)
