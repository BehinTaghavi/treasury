                            @Html.IActionLink("", "ShowDuplication", "Request", new { area = "Payment", requestId = item.RequestID, pageIndex = Model.PageIndex }, new { title = Resources.Duplication, @class = "btn btn-material-grey-600 btn-xs" }, "zmdi zmdi-hc-lg zmdi-plus-circle-o-duplicate")

