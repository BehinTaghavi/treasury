            }, null,null)*@
                    }
                </td>



                <td data-lang-number="fa">@(item.RequestID)</td>
                <td>
                    <span data-lang-number="fa">
                        @if (!string.IsNullOrEmpty(item.RequestDate))
                        {
                            @(item.RequestDate.Substring(0, 4) + "/" + item.RequestDate.Substring(4, 2) + "/" + item.RequestDate.Substring(6, 2))
                        }
                    </span>
                </td>
                <td>
                    <b data-lang-number="fa" style="font-size: 15px" class="mdc-text-light-blue-900">
                        @if (item.PayAmount == 0)
                        {
                            @Math.Truncate(item.ExchangeAmount.Value).ToString("#,##0")

                        }
                        else
                        {
                            @Math.Truncate(item.PayAmount).ToString("#,##0")
                        }

                    </b>
                </td>

                <td>
                    @(item.Account_Name)
                </td>

                @*<td>
            @switch (item.Priority)
            {
                case (short)Priority.High:
                    <b class='mdc-text-green-700'>@TreasuryEnums.GetTitleFromResource("Priority", Enum.GetName(typeof(Priority), item.Priority))</b>
                    break;
                case (short)Priority.Normal:
                    <b class='mdc-text-lime-600'>@TreasuryEnums.GetTitleFromResource("Priority", Enum.GetName(typeof(Priority), item.Priority))</b>
                    break;
                case (short)Priority.Low:
                    <b class='mdc-text-amber-600'>@TreasuryEnums.GetTitleFromResource("Priority", Enum.GetName(typeof(Priority), item.Priority))</b>
                    break;
            }
        </td>*@
                <td>

                    @if (item.Cancellation != null)
                    {
                        @Resources.Cancel
                    }
                    else if (item.CancelCheque != null)
                    {
                        @Resources.CancelCheque
                    }
                    else if (item.AccVoucherNo != null)
                    {
                        <span>شماره سند : @(item.AccVoucherNo)</span>
                    }
                    else if (item.Paid != null)
                    {
                        @Resources.Paid
                    }
                    else if (item.Delivered != null)
                    {
                        @Resources.Delivered
                    }
                    else if (item.mojavezeEmza == true)
                    {
                        <span> مجوز امضا</span>
                    }
                    else if (item.ChequeElements_PrintLayout != null)
                    {
                        <span> چاپ چک</span>
                    }

                    else if (item.ConfirmPayment != null)
                    {
                        @Resources.ConfirmPayment
                    }
                    else if (item.Confirmed != null)
                    {
                        @Resources.Confirm
                    }
                    else if (item.Unknown != null)
                    {
                        <text>@Resources.Unknown</text>
                    }
                </td>
                <td>
                    <span data-lang-number="fa">
                        @if (!string.IsNullOrEmpty(item.DueDate))
                        {
                            @(item.DueDate.Substring(0, 4) + "/" + item.DueDate.Substring(4, 2) + "/" + item.DueDate.Substring(6, 2))
                        }
                    </span>
                </td>
                <td>
                    <b>

                        @{
