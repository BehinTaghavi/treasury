        WinPrint.document.write('<link href="../../Content/css/print.css" rel="stylesheet" />' + prtContent.innerHTML);
        //WinPrint.document.close();
        WinPrint.focus();
        //WinPrint.print(); // change window to winPrint
        //WinPrint.close(); // change window to winPrint
        if (confirm("آیا صدور چک با موفقیت انجام شد؟")) {
            var dt = {
                DueDate: "@ViewBag.DueDate",
                ChequeNo: "@ViewBag.ChequeNo",
                RequestId: "@ViewBag.RequestId",
                ChequeFormatID: "@ViewBag.ChequeFormatID"
            };
            console.log(dt);
            $.ajax({
                url: "@Url.Action("SavePaymentDueDate", "ChequePayment")",
                data: dt,
                success: function (data) {
                    alertify.success("پرداخت با موفقیت انجام شد");
                    @*var node = document.getElementById("chequeImage");
                        domtoimage.toPng(node).then(function (pngDataUrl) {
                            var image = new Image();
                            image.src = pngDataUrl;
                            $.ajax({
                                url: "@Url.Action("Create", "Attachment", new { area = "Payment" })",
                                data: [relatedID = "", file = image, fromWhere = "Payment"],
                                success: function (result) {

                                }
                            })

                        })*@
                    setTimeout(function () { window.location.reload(); }, 1000);
                }
            });
            //   window.location.reload();
        }
        else {
            if (!confirm("آیا برگه قابل استفاده است؟")) {
                $.ajax({
                    url: "@Url.Action("CancelRequestForCancelCheque", "ChequePayment")",
                    data: { RequestId: "@ViewBag.RequestId" },
                    success: function (data) {
                        alertify.warning("پرداخت ابطال شد");
                        alertify.warning("برگه چک ابطال شد");
                        alertify.success("درخواست جدید با موفقیت صادر شد");
                    }
                })
            }
        }
    }
    $("body").on("change", "#BasicBank", function () {
        var addressBankList = "@(Url.Action("GetChequeFormatType", "Cheque", new { Area= "BasicInfo" }))";
        $("#ChequeFormatID").load(addressBankList, { id: $(this).val() }, function (data) {
            $("#ChequeFormatID").val($("#ChequeFormatID option:first").val()).removeClass("empty");
            updateChequeImage($("#ChequeFormatID").val());
        });
    });

    $("body").on("change", "#ChequeFormatID", function () {
        updateChequeImage($(this).val());
    });
    function updateChequeImage(relatedID) {
        if (relatedID != null) {
            var xhttp = new XMLHttpRequest();
            xhttp.onreadystatechange = function () {
                if (xhttp.readyState == 4 && xhttp.status == 200) {
                    if (xhttp.responseText) {
                        var file = JSON.parse(xhttp.responseText);
                        var chequePanel = document.getElementById("chequePanel");
                        chequePanel.style.backgroundImage = "url(data:image/" + file.Extension + ";base64," + file.Image + ")";
                        chequePanel.style.height = file.Height + "px";
                        chequePanel.style.width = file.Width + "px";
                        // dragresize = new DragResize('dragresize', { minWidth: 0, minHeight: 0, minLeft: 0, minTop: 0, maxLeft: file.Width, maxTop: file.Height });
                        $("#elemensForm").html("");
                        $(chequePanel).html("");
                        for (var i = 0; i < file.Elements.length; i++) {
                            $(chequePanel).append('<div class="form-control cheque-control drsElement drsMoveHandle" data-name="1" style="position: absolute; top: ' + file.Elements[i].m_TOP + 'px; left: ' + file.Elements[i].m_Left + 'px; font-family: ' + file.Elements[i].m_FontName + '; font-size: ' + file.Elements[i].m_FontSize + 'px; text-align: ' + file.Elements[i].m_TextAlign + '; font-weight: ' + file.Elements[i].m_fontweight + '; width: ' + file.Elements[i].m_Width + 'px; height: ' + file.Elements[i].m_height + 'px; direction: ' + file.Elements[i].m_Direction + '; z-index: 2;">' + file.Elements[i].ChequeLable + '</div>')
                            $("#elemensForm").append('<div class="form-group"><label class="control-label">' + file.Elements[i].ChequeLable + '</label><input class="form-control" type="text" name="name" placeholder="' + file.Elements[i].ChequeLable + '" /></div>')
                        }
                    }
                }
            };
            xhttp.open("GET", "@Url.Action("GetChequeFormatTypeImage", "ChequePayment", new { Area= "Payment" })" + "?tableName=ChequeFormatTypes&relatedID=" + relatedID, true);
            xhttp.send();
        }
    }
</script>
