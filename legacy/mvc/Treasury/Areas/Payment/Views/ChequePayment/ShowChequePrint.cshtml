@model Issuance
<style>
    #chequeImage {
        margin-bottom: 30px;
    }
</style>
<div id="chequeImage">
    <div id="chequePanel" style="direction: ltr; width: 700px; height: 300px; position: relative; background-image: url(data:image/@Model.Extension;base64,@Model.Image); background-position: center; background-repeat: no-repeat; margin: 0cm;">
        <div id="margin-print">
            @foreach (var item in Model.Elements)
            {
                switch (item.labelMapToField)
                {
                    //حذف حواله کرد
                    case "lineDraft":
                        if (Model.ChequeDetails.RemoveRemit)
                        {
            <div style="position: absolute; top: @(item.m_TOP)px; left: @(item.m_Left)px; font-family: @(item.m_FontName); font-size: @(item.m_FontSize)px; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @((int)item.m_Width)px; height: @((int)item.m_height)px; direction: @(item.m_Direction); z-index: 2;">
            </div>
                        }
                        else
                        {
            <div style="position: absolute; top: @(item.m_TOP)px; left: @(item.m_Left)px; font-family: @(item.m_FontName); font-size: @(item.m_FontSize)px; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @((int)item.m_Width)px; height: @((int)item.m_height)px; direction: @(item.m_Direction); z-index: 2;">@item.labelValue</div>
                        }
                        break;
                    // حدف حواله "بابت"
                    case "behalf":
                        if (!Model.ChequeDetails.RemoveOrdersFor)
                        {
            <div style="position: absolute; top: @(item.m_TOP)px; left: @(item.m_Left)px; font-family: @(item.m_FontName); font-size: @(item.m_FontSize)px; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @((int)item.m_Width)px; height: @((int)item.m_height)px; direction: @(item.m_Direction); z-index: 2;">@item.labelValue</div>
                        }
                        break;
                    // در وجه حامل
                    case "beneficiary":
                        if (Model.ChequeDetails.Bearer)
                        {
            <div style="position: absolute; top: @(item.m_TOP)px; left: @(item.m_Left)px; font-family: @(item.m_FontName); font-size: @(item.m_FontSize)px; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @((int)item.m_Width)px; height: @((int)item.m_height)px; direction: @(item.m_Direction); z-index: 2;">حامل</div>
                        }
                        else
                        {
            <div style="position: absolute; top: @(item.m_TOP)px; left: @(item.m_Left)px; font-family: @(item.m_FontName); font-size: @(item.m_FontSize)px; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @((int)item.m_Width)px; height: @((int)item.m_height)px; direction: @(item.m_Direction); z-index: 2;">@item.labelValue</div>
                        }
                        break;
                    // چک فاقد هر گونه قلم خوردگی است
                    case "withoutCrossing":
                        if (Model.ChequeDetails.WithoutCrossing)
                        {
            <div style="position: absolute; top: @(item.m_TOP)px; left: @(item.m_Left)px; font-family: @(item.m_FontName); font-size: @(item.m_FontSize)px; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @((int)item.m_Width)px; height: @((int)item.m_height)px; direction: @(item.m_Direction); z-index: 2;">@item.ChequeLable</div>
                        }
                        break;
                    // چک فاقد ظهرنویسی است
                    case "checkIsUnderwritten":
                        if (Model.ChequeDetails.checkIsUnderwritten)
                        {
                            <div style="position: absolute; top: @(item.m_TOP)px; left: @(item.m_Left)px; font-family: @(item.m_FontName); font-size: @(item.m_FontSize)px; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @((int)item.m_Width)px; height: @((int)item.m_height)px; direction: @(item.m_Direction); z-index: 2;">@item.ChequeLable</div>
                        }
                        break;
                    // چک غیر قابل انتقال می باشد
                    case "nonTransferable":
                        if (Model.ChequeDetails.NonTransferable)
                        {
            <div style="position: absolute; top: @(item.m_TOP)px; left: @(item.m_Left)px; font-family: @(item.m_FontName); font-size: @(item.m_FontSize)px; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @((int)item.m_Width)px; height: @((int)item.m_height)px; direction: @(item.m_Direction); z-index: 2;">@item.ChequeLable</div>
                        }
                        break;
                    // چک در وجه حساب جاری
                    case "currentAccount":
                        if (Model.ChequeDetails.CurrentAccount)
                        {
            <div style="position: absolute; top: @(item.m_TOP)px; left: @(item.m_Left)px; font-family: @(item.m_FontName); font-size: @(item.m_FontSize)px; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @((int)item.m_Width)px; height: @((int)item.m_height)px; direction: @(item.m_Direction); z-index: 2;">@item.ChequeLable</div>
                        }
                        break;
                    // چک در وجه حساب شبا
                    case "shebaAccount":
                        if (Model.ChequeDetails.ShebaAccount)
                        {
            <div style="position: absolute; top: @(item.m_TOP)px; left: @(item.m_Left)px; font-family: @(item.m_FontName); font-size: @(item.m_FontSize)px; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @((int)item.m_Width)px; height: @((int)item.m_height)px; direction: @(item.m_Direction); z-index: 2;">@item.ChequeLable</div>
                        }
                        break;
                    // در شعبه صادر کننده قابل وصول است
                    case "branchExporterReceivable":
                        if (Model.ChequeDetails.BranchExporterReceivable)
                        {
            <div style="position: absolute; top: @(item.m_TOP)px; left: @(item.m_Left)px; font-family: @(item.m_FontName); font-size: @(item.m_FontSize)px; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @((int)item.m_Width)px; height: @((int)item.m_height)px; direction: @(item.m_Direction); z-index: 2;">@item.ChequeLable</div>
                        }
                        break;
                    // تایید صدور چک
                    case "approveIssuance":
                        if (Model.ChequeDetails.ApproveIssuance)
                        {
            <div style="position: absolute; top: @(item.m_TOP)px; left: @(item.m_Left)px; font-family: @(item.m_FontName); font-size: @(item.m_FontSize)px; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @((int)item.m_Width)px; height: @((int)item.m_height)px; direction: @(item.m_Direction); z-index: 2;">@item.ChequeLable</div>
                        }
                        break;
                    default:
            <div style="position: absolute; top: @(item.m_TOP)px; left: @(item.m_Left)px; font-family: @(item.m_FontName); font-size: @(item.m_FontSize)px; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @((int)item.m_Width)px; height: @((int)item.m_height)px; direction: @(item.m_Direction); z-index: 2;">@item.labelValue</div>
                        break;
                }
            }
        </div>
    </div>
</div>
