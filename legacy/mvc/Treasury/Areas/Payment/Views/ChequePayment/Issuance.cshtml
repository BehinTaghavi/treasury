@model Issuance
@{
    ViewBag.Title = "Issuance";
    var hasAttr = Model.ChequeDetails.ChequeFormatID + "," + (string)ViewBag.DueDate + "," + (string)ViewBag.TableName + ",";
}
<link href="~/Content/css/print.min.css" rel="stylesheet" />
<style>
    #chequeImage {
        margin-bottom: 30px;
    }
</style>
@*<div class="col-sm-4">
        <div id="elemensForm">
            <div class="form-group"><label class="control-label">شماره چک: </label>@ViewBag.ChequeNo</div>
            @foreach (var item in Model.Element)s
            {
                <div class="form-group"><label class="control-label">@item.ChequeLable</label><input class="form-control" disabled type="text" name="name" value="@item.labelValue" placeholder="@item.ChequeLable" /></div>
            }
        </div>
    </div>*@

<div class="row" style="margin: 0 0 30px 0">
    <div class="col-sm-4">
        <p>شماره چک: @ViewBag.ChequeNo</p>
        <p>تاریخ سررسید: @Model.ChequeDetails.DueDate</p>
    </div>
    @*<div class="col-sm-3"><input type="number" id="marginLeftValue" class="form-control floating-label" placeholder="فاصله از چپ" /></div>
        <div class="col-sm-3"><input type="number" id="marginTopValue" class="form-control floating-label" placeholder="فاصله از بالا" /></div>*@
    <div class="col-sm-8 text-left">
        <button id="printTest" class="btn btn-material-light-blue-A700 btn-lg" onclick="printTest()">تست پرینت</button>
        <button id="print" class="btn btn-material-light-blue-A700 btn-lg" onclick="print()">چاپ چک</button>
    </div>
</div>
<div id="chequeImage" style="direction: ltr; width: 700px; height: 300px; position: relative; background-image: url(data:image/@(Model.Extension.Trim());base64,@(Model.Image.Trim())); background-position: center; background-repeat: no-repeat; margin: 0 auto 0 0;">
    <div id="chequePanel">
        <div style="width: 100%; height: 100%;">
            <div id="margin-print">

                @foreach (var item in Model.Elements)
                {
                    switch (item.labelMapToField)
                    {
                        //حذف حواله کرد
                        case "lineDraft":
                            if (Model.ChequeDetails.RemoveRemit)
                            {
                                hasAttr += "RemoveRemit,";
                                <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;">
                                    ***********
                                </div>
                            }
                            else
                            {
                                <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;">@item.labelValue</div>
                            }
                            break;
                        // حدف حواله "بابت"
                        case "behalf":
                            if (!Model.ChequeDetails.RemoveOrdersFor)
                            {
                                hasAttr += "RemoveOrdersFor,";
                                <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;">@item.labelValue</div>
                            }
                            break;
                        // در وجه حامل
                        case "beneficiary":
                            if (Model.ChequeDetails.Bearer)
                            {
                                hasAttr += "Bearer,";
                                <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;">حامل</div>
                            }
                            else if (Model.ChequeDetails.Unique_Account_No2)
                            {
                                hasAttr += "Unique_Account_No2,";
                                <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;"> @(Model.ChequeDetails.Unique_Account_No2Val) </div>
                            }
                            else
                            {
                                <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;">@item.labelValue</div>
                            }
                            break;
                        // در وجه حامل
                        case "beneficiaryandbehalf":
                            if (Model.ChequeDetails.Bearer)
                            {
                                hasAttr += "Bearer,";
                                <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;">حامل</div>
                            }
                            else if (!Model.ChequeDetails.ShebaAccount)
                            {
                                <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;"> @Html.Raw(item.labelValue.Replace("\r\n", "</br>")) </div>
                            }
                            //else if (Model.ChequeDetails.Unique_Account_No2)
                            //{
                            //    hasAttr += "Unique_Account_No2,";
                            //    <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;"> @(Model.ChequeDetails.Unique_Account_No2Val) </div>
                            //}
                            //else
                            //{
                            //    <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;">@item.labelValue</div>
                            //}
                            break;
                        // چک فاقد هر گونه قلم خوردگی است
                        case "withoutCrossing":
                            if (Model.ChequeDetails.WithoutCrossing)
                            {
                                hasAttr += "WithoutCrossing,";

                                <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;">@item.ChequeLable</div>
                            }
                            break;
                        // چک فاقد ظهرنویسی است
                        case "checkIsUnderwritten":
                            if (Model.ChequeDetails.checkIsUnderwritten)
                            {
                                hasAttr += "checkIsUnderwritten,";
                                <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;">@item.ChequeLable</div>
                            }
                            break;
                        // چک غیر قابل انتقال می باشد
                        case "nonTransferable":
                            if (Model.ChequeDetails.NonTransferable)
                            {
                                hasAttr += "NonTransferable,";
                                <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;">@item.ChequeLable</div>
                            }
                            break;
                        // چک در وجه حساب جاری
                        case "currentAccount":
                            if (Model.ChequeDetails.CurrentAccount)
                            {
                                hasAttr += "CurrentAccount,";
                                <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;">@("شماره حساب")@Utility.GetAccountNum(Model.ChequeDetails.BeneficiarDetailID)</div>
                            }
                            break;
                        // چک در وجه حساب شبا
                        case "shebaAccount":
                            if (Model.ChequeDetails.ShebaAccount)
                            {
                                hasAttr += "ShebaAccount,";
                                if (Model.ChequeDetails.Unique_Account_No2)
                                {
                                <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;"> @(Model.ChequeDetails.Unique_Account_No2Val) @Utility.GetShebaNum(Model.ChequeDetails.BeneficiarDetailID)</div>
                                }
                                else
                                {
                                    <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;">@Utility.GetShebaNum(Model.ChequeDetails.BeneficiarDetailID)</div>
                                }

                            }
                            break;
                        // در شعبه صادر کننده قابل وصول است
                        case "branchExporterReceivable":
                            if (Model.ChequeDetails.BranchExporterReceivable)
                            {
                                hasAttr += "BranchExporterReceivable,";
                                <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;">@item.ChequeLable</div>
                            }
                            break;
                        // تایید صدور چک
                        case "approveIssuance":
                            if (Model.ChequeDetails.ApproveIssuance)
                            {
                                hasAttr += "ApproveIssuance,";
                                <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;">@item.ChequeLable</div>
                            }
                            break;
                        default:
                            <div style="position: absolute; top: @(item.m_TOP * 72 / 96)pt; left: @(item.m_Left * 72 / 96)pt; font-family: @(item.m_FontName); font-size: @((float)item.m_FontSize / 10)em; text-align: @(item.m_TextAlign); font-weight: @(item.m_fontweight); width: @(((int)item.m_Width) * 72 / 96)pt; height: @(((int)item.m_height) * 72 / 96)pt; line-height: @(((int)item.m_height) * 72 / 96)pt; direction: @(item.m_Direction); z-index: 2;">@item.labelValue</div>
                            break;
                    }
                }
            </div>
        </div>
    </div>
</div>
<style>
    .modal-dialog.lg-1170 {
        width: 1170px;
    }
    #inputcontextmenu {
        position: absolute;
        width: 100px;
    }

    .drsElement {
        position: absolute;
        border: 1px solid #333;
    }

    .drsMoveHandle {
        height: 20px;
        background-color: #CCC;
        border-bottom: 1px solid #666;
        cursor: move;
    }

    .dragresize {
        position: absolute;
        width: 5px;
        height: 5px;
        font-size: 1px;
        background: #EEE;
        border: 1px solid #333;
    }

    .dragresize-tl {
        top: -8px;
        left: -8px;
        cursor: nw-resize;
    }

    .dragresize-tm {
        top: -8px;
        left: 50%;
        margin-left: -4px;
        cursor: n-resize;
    }

    .dragresize-tr {
        top: -8px;
        right: -8px;
        cursor: ne-resize;
    }

    .dragresize-ml {
        top: 50%;
        margin-top: -4px;
        left: -8px;
        cursor: w-resize;
    }

    .dragresize-mr {
        top: 50%;
        margin-top: -4px;
        right: -8px;
        cursor: e-resize;
    }

    .dragresize-bl {
        bottom: -8px;
        left: -8px;
        cursor: sw-resize;
    }

    .dragresize-bm {
        bottom: -8px;
        left: 50%;
        margin-left: -4px;
        cursor: s-resize;
    }

    .dragresize-br {
        bottom: -8px;
        right: -8px;
        cursor: se-resize;
    }
</style>
<script src="~/Scripts/dom-to-image.js"></script>
<script src="~/Scripts/print.min.js"></script>
<script src="~/Scripts/html.js"></script>
<script>


           function printTest() {
         $.ajax({
            url: "@Url.Action("Testprintcheque", "ChequePayment",new { Area= "Payment" })",
            success: function (data) {
                alert(data);
            }
        })
    }
    function print() {
        $("#print").attr("disabled", "disabled");

        $.ajax({
            url: "@Url.Action("printcheque", "ChequePayment")",
            success: function (data) {
                if (data) {

                    alertify.success("پرینت چک انجام شد");
                    if (confirm("پرینت چک انجام شد. آیا صدور چک با موفقیت انجام شد؟")) {
                        var dt = {
                            DueDate: "@ViewBag.DueDate",
                            ChequeNo: "@ViewBag.ChequeNo",
                            RequestId: "@ViewBag.RequestId",
                            ChequeFormatID: "@ViewBag.ChequeFormatID",
                            ExchangeRate: "@ViewBag.ExchangeRate",
                            hasAttr: "@hasAttr"
                        };
                        $.ajax({
                            url: "@Url.Action("SavePaymentDueDate", "ChequePayment")",
                            data: dt,
                            success: function (data) {
                                console.log(data);
                                alertify.success("پرداخت با موفقیت انجام شد");
                                setTimeout(function () { window.location.reload(); }, 1000);
                            }
                        });
                    }
                    else {
                        setTimeout(function () {
                            if (confirm("آیا برگه قابل استفاده است؟")) {
                                $("#print").removeAttr("disabled");
                            }
                            else {
                                alert("Cancel");
                                $.ajax({
                                    url: "@Url.Action("CancelRequestForCancelCheque", "ChequePayment")",
                                    data: { RequestId: "@ViewBag.RequestId", ChequeFormatID: "@ViewBag.ChequeFormatID" },
                                    success: function (data) {
                                        alertify.warning("پرداخت ابطال شد");
                                        alertify.warning("برگه چک ابطال شد");
                                        alertify.success("درخواست جدید با موفقیت صادر شد");
                                        setTimeout(function () { window.location.reload(); }, 1000);
                                    }
                                })
                            }
                        }, 1000);
                    }
                }
                else {
                    console.log(data);
                    alertify.error("خطا در پرینت چک");
                    $("#print").removeAttr("disabled");
                }
            }
        })
    }
    $("body").on("change", "#BasicBank", function () {
        var addressBankList = "@(Url.Action("GetChequeFormatType", "Cheque", new { Area= "BasicInfo" }))";
        $("#ChequeFormatID").load(addressBankList, { id: $(this).val() }, function (data) {
            $("#ChequeFormatID").val($("#ChequeFormatID option:first").val()).removeClass("empty");
            updateChequeImage($("#ChequeFormatID").val());
        });
    });

    $("body").on("change", "#ChequeFormatID", function () {
        updateChequeImage($(this).val());
    });
    function updateChequeImage(relatedID) {
        if (relatedID != null) {
            var xhttp = new XMLHttpRequest();
            xhttp.onreadystatechange = function () {
                if (xhttp.readyState == 4 && xhttp.status == 200) {
                    if (xhttp.responseText) {
                        var file = JSON.parse(xhttp.responseText);
                        var chequePanel = document.getElementById("chequePanel");
                        chequePanel.style.backgroundImage = "url(data:image/" + file.Extension + ";base64," + file.Image + ")";
                        chequePanel.style.height = file.Height + "px";
                        chequePanel.style.width = file.Width + "px";
                        // dragresize = new DragResize('dragresize', { minWidth: 0, minHeight: 0, minLeft: 0, minTop: 0, maxLeft: file.Width, maxTop: file.Height });
                        $("#elemensForm").html("");
                        $(chequePanel).html("");
                        for (var i = 0; i < file.Elements.length; i++) {
                            $(chequePanel).append('<div class="form-control cheque-control drsElement drsMoveHandle" data-name="1" style="position: absolute; top: ' + file.Elements[i].m_TOP + 'px; left: ' + file.Elements[i].m_Left + 'px; font-family: ' + file.Elements[i].m_FontName + '; font-size: ' + file.Elements[i].m_FontSize + 'px; text-align: ' + file.Elements[i].m_TextAlign + '; font-weight: ' + file.Elements[i].m_fontweight + '; width: ' + file.Elements[i].m_Width + 'px; height: ' + file.Elements[i].m_height + 'px; direction: ' + file.Elements[i].m_Direction + '; z-index: 2;">' + file.Elements[i].ChequeLable + '</div>')
                            $("#elemensForm").append('<div class="form-group"><label class="control-label">' + file.Elements[i].ChequeLable + '</label><input class="form-control" type="text" name="name" placeholder="' + file.Elements[i].ChequeLable + '" /></div>')
                        }
                    }
                }
            };
            xhttp.open("GET", "@Url.Action("GetChequeFormatTypeImage", "ChequePayment", new { Area= "Payment" })" + "?tableName=ChequeFormatTypes&relatedID=" + relatedID, true);
            xhttp.send();
        }
    }
</script>
