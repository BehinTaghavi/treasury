<p>@Resources.AreYouSure</p>
@using (Ajax.BeginForm("Delete", "Attachment", new { Id = ViewBag.AttachmentId }, new AjaxOptions
{
    OnSuccess = "successMessage(data); OnSuccessdelete(data)"
}, null))
{
    <button class="btn btn-primary" type="submit">@Resources.Yes</button>
    <button class="btn btn-primary" onclick="$('.modal.sm').modal('hide')" type="button">@Resources.NO</button>
}

<script>
        function OnSuccessdelete(data) {
            deleteRow('@Hash.GetHashString((ViewBag.AttachmentId).ToString())');
            $('.modal.sm').modal('hide');
        }
</script>