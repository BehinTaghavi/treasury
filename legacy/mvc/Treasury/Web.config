  <appSettings>
    <add key="webpages:Version" value="3.0.0.0"/>
    <add key="webpages:Enabled" value="false"/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
    <!--<گروه بابت مربوط به درخواست وجه ای که از تن خواه به وجود امده است/>-->
    <add key="BehalfId" value="9"/>
    <add key="BehalfGroupID" value="67"/>
    <add key="hasPlaningTypeID:17" value="true"/>
    <!--<add key="PayTwoStep" value="true"/>-->
    <!--برای چک های بلند مدت-->
    <!--پرداخت درزمان صدور چک یا زمان تحویل چک-->
    <add key="PayWhenCheckPrinted" value="True"/>
    <add key="PayWhenCheckDelivered" value="False"/>
    <!--صدور چک بلند مدت بدون داشتن موجودی-->
    <add key="Long-termCheckWithoutCash" value="True"/>
    <!--درصورتی که سال مالی جدید از امسال شروع شود-->
    <add key="YearPlus" value="False"/>
    <add key="FiscalYear" value="1402"/>
    <add key="bilingual" value="False"/>
    <add key="ShowBehalfTextInCheque" value="True"/>
    <!--<add key="CompanyName" value="شرکت صنایع غذایی فراز نمونه قشم )سهامی خاص("/>
    <add key="CompanyTitle" value="شرکت صنایع غذایی فراز نمونه قشم (سهامی خاص)"/>-->
    <add key="CompanyName" value="شرکت مدیریت یاران توسعه بهشر"/>
    <add key="CompanyTitle" value="شرکت مدیریت یاران توسعه بهشر"/>
    <add key="Payment_Type_ID" value="1"/>
    <add key="Receipt_Type_ID" value="2"/>
    <add key="Direct_Type_ID" value="4"/>
    <add key="CompletePayBackup" value="False"/>
    <add key="CityId" value="4"/>
    <add key="unique_account_type" value="8"/>
    <!--تفصیل-->
    <add key="Unique_Account_No" value="1121"/>
    <add key="printleft" value="-10"/>
    <add key="printtop" value="-31"/>
    <!-- معین در معین -->
    <add key="Account_No" value="1111"/>
    <!--معین در معین واگذاری-->
    <add key="Assign_Account_No" value="1131"/>
    <!--معین در معین برگشتی-->
    <add key="Returns_Account_No" value="1331"/>
    <!--GroupHesabPetycash-->
    <!--گروه حساب معین برای تن خواهگردان-->
    <add key="GroupHesabPetycash" value="81,82,84,36"/>
    <add key="ipAddress" value="192.168.0.116"/>
    <!--AccountCodePetyCash-->
    <!--مقادیر پیش فرض برای نمایش چک-->
    <add key="ChequeDefaultValue" value="RemoveOrdersFor,RemoveRemit,WithoutCrossing"/>
    <add key="temporaryConnection" value="server=CSDSERVER2003\MSSQLSERVER2008;user id=sa;password=;Initial Catalog=TreasurySimLaki;MultipleActiveResultSets=True;"/>
