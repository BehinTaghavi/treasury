<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- HTTP API of requests-svc (payment requests, درخواست وجه). -->
  <PropertyGroup>
    <RootNamespace>Treasury.Requests.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Treasury.Requests.Infrastructure\Treasury.Requests.Infrastructure.csproj" />
  </ItemGroup>

  <!-- With NuGet (normal build): PostgreSQL storage and Keycloak token validation.
       Offline build (-p:Offline=true): in-memory storage and development identity only. -->
  <PropertyGroup Condition="'$(Offline)' != 'true'">
    <DefineConstants>$(DefineConstants);WITH_PACKAGES</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Offline)' != 'true'">
    <ProjectReference Include="..\Treasury.Requests.Infrastructure.Postgres\Treasury.Requests.Infrastructure.Postgres.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>
</Project>
