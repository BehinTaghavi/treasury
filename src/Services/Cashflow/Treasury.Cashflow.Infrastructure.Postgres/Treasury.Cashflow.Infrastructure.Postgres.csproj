<Project Sdk="Microsoft.NET.Sdk">
  <!-- PostgreSQL 17 adapters (Npgsql). Needs NuGet; skipped in offline builds (-p:Offline=true). Schema: db/postgres. -->
  <PropertyGroup>
    <RootNamespace>Treasury.Cashflow.Infrastructure.Postgres</RootNamespace>
    <!-- Not yet compiled with NuGet access: switch back to true after the first clean build. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Treasury.Cashflow.Infrastructure\Treasury.Cashflow.Infrastructure.csproj" />
  </ItemGroup>
</Project>
