<Project Sdk="Microsoft.NET.Sdk">
  <!-- PostgreSQL 17 adapters (Npgsql). Needs NuGet; skipped in offline builds (-p:Offline=true). Schema: db/postgres. -->
  <PropertyGroup>
    <RootNamespace>Treasury.Cashflow.Infrastructure.Postgres</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- Only the DI abstractions for AddCashflowPostgres: infrastructure must not depend on the web framework. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Treasury.Cashflow.Infrastructure\Treasury.Cashflow.Infrastructure.csproj" />
  </ItemGroup>
</Project>
