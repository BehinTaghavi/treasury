<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- HTTP API of accounts-svc (bank accounts; later cash desks and cheque books). -->
  <PropertyGroup>
    <RootNamespace>Treasury.Accounts.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Treasury.Accounts.Infrastructure\Treasury.Accounts.Infrastructure.csproj" />
  </ItemGroup>

  <!-- With NuGet (normal build): PostgreSQL storage and Keycloak token validation.
       Offline build (-p:Offline=true): in-memory storage and development identity only. -->
  <PropertyGroup Condition="'$(Offline)' != 'true'">
    <DefineConstants>$(DefineConstants);WITH_PACKAGES</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Offline)' != 'true'">
    <ProjectReference Include="..\Treasury.Accounts.Infrastructure.Postgres\Treasury.Accounts.Infrastructure.Postgres.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
  </ItemGroup>
</Project>
