<Project Sdk="Microsoft.NET.Sdk">
  <!-- PostgreSQL 17 adapters of accounts-svc (Npgsql). Needs NuGet; skipped in offline builds (-p:Offline=true). Schema: db/postgres. -->
  <PropertyGroup>
    <RootNamespace>Treasury.Accounts.Infrastructure.Postgres</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Treasury.Accounts.Infrastructure\Treasury.Accounts.Infrastructure.csproj" />
  </ItemGroup>
</Project>
